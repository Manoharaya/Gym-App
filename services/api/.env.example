# FitCore API Environment Configuration

PORT=4000
NODE_ENV=development

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitcore_dev?schema=public

# Redis (Redis 7+)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Development baseline - use strong secrets in production)
JWT_SECRET=fitcore-dev-jwt-access-secret-2026-very-secure-random-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fitcore-dev-jwt-refresh-secret-2026-very-secure-random-key
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Platform Defaults
DEFAULT_TIMEZONE=Australia/Perth
DEFAULT_CURRENCY=AUD
