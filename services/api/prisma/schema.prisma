model AIFitnessCoachProfile {
  id              String        @id @default(cuid())
  organisationId  String
  memberId        String        @unique
  coachingStyle   String        @default("BALANCED") // ENCOURAGING, DIRECT, TECHNICAL, BALANCED, MOTIVATIONAL
  responseLength  String        @default("BALANCED") // CONCISE, BALANCED, DETAILED
  language        String        @default("en")
  unitPreference  String        @default("METRIC")   // METRIC, IMPERIAL
  trainingFocus   String?       // STRENGTH, HYPERTROPHY, ENDURANCE, GENERAL_FITNESS, FAT_LOSS, MOBILITY
  enabled         Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

