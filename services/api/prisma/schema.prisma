// ------------------------------------------
// Wearables & Health Data Sync Domain
// ------------------------------------------

model WearableConnection {
  id                    String             @id @default(cuid())
  organisationId        String
  memberId              String
  provider              String             // APPLE_HEALTH, GOOGLE_HEALTH_CONNECT, FITBIT, GARMIN, WHOOP, OURA
  status                String             @default("PENDING") // PENDING, CONNECTED, SYNCING, SYNC_ERROR, REAUTH_REQUIRED, DISCONNECTED, REVOKED
  connectedAt           DateTime?
  lastSyncAt            DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastFailedSyncAt      DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?            @db.Text
  providerUserReference String?
  scopes                String[]           @default([])
  encryptedAccessToken  String?            @db.Text
  encryptedRefreshToken String?            @db.Text
  tokenExpiresAt        DateTime?
  metadata              Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  revokedAt             DateTime?

  organisation          Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile         MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  healthDataRecords     HealthDataRecord[]
  syncLogs              WearableSyncLog[]
  rawData               WearableRawData[]

  @@unique([memberId, provider])
  @@index([organisationId, memberId])
  @@index([status])
  @@index([provider])
  @@map("wearable_connections")
}

model HealthDataRecord {
  id              String             @id @default(cuid())
  organisationId  String
  memberId        String
  connectionId    String
  provider        String             // APPLE_HEALTH, GOOGLE_HEALTH_CONNECT, FITBIT, etc.
  dataType        String             // STEPS, DISTANCE, ACTIVE_CALORIES, HEART_RATE, etc.
  sourceRecordId  String?
  startTime       DateTime           // UTC
  endTime         DateTime?          // UTC
  value           Float
  unit            String             // count, steps, km, kcal, bpm, ms, minutes, etc.
  timezone        String?
  sourceName      String?            // Apple Watch, Fitbit Charge 6, Pixel Watch
  sourceDevice    String?
  metadata        Json?
  fingerprint     String?            // Deterministic hash for deduplication when sourceRecordId is missing
  recordedAt      DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  connection      WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, dataType, sourceRecordId])
  @@index([memberId, dataType, startTime])
  @@index([organisationId, memberId])
  @@index([connectionId, startTime])
  @@index([fingerprint])
  @@map("health_data_records")
}

model WearableSyncLog {
  id                 String             @id @default(cuid())
  connectionId       String
  memberId           String
  organisationId     String
  provider           String
  syncType           String             // INITIAL, INCREMENTAL, RETRY, MANUAL
  status             String             // SUCCESS, FAILED, PARTIAL
  recordsFetched     Int                @default(0)
  recordsInserted    Int                @default(0)
  duplicatesSkipped  Int                @default(0)
  validationFailures Int                @default(0)
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  durationMs         Int?
  errorCode          String?
  errorMessage       String?            @db.Text
  createdAt          DateTime           @default(now())

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  connection         WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([memberId, startedAt])
  @@map("wearable_sync_logs")
}

model WearableRawData {
  id               String             @id @default(cuid())
  connectionId     String
  memberId         String
  organisationId   String
  provider         String
  encryptedPayload String             @db.Text
  recordCount      Int                @default(0)
  expiresAt        DateTime
  createdAt        DateTime           @default(now())

  connection       WearableConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([expiresAt])
