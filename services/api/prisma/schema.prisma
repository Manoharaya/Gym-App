// ==========================================
// DAY 28: COMMUNICATION & NOTIFICATION ENGINE
// ==========================================

model Communication {
  id                 String                       @id @default(cuid())
  organisationId     String
  outletId           String?
  recipientUserId    String?
  recipientMemberId  String?
  recipientStaffId   String?

  type               String                       // TRANSACTIONAL, OPERATIONAL, ENGAGEMENT, REACTIVATION, REMINDER, SYSTEM, MARKETING, STAFF, SECURITY
  channel            String                       // EMAIL, SMS, PUSH, WHATSAPP, IN_APP, VOICE

  templateId         String?
  templateVersionId  String?

  subject            String?
  contentPreview     String?
  body               String?                      @db.Text
  variables          Json?

  status             String                       @default("QUEUED") // DRAFT, PENDING_APPROVAL, APPROVED, QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, CANCELLED, EXPIRED, SUPPRESSED

  scheduledAt        DateTime?
  queuedAt           DateTime                     @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  readAt             DateTime?

  provider           String                       // DEVELOPMENT, CONSOLE, SENDGRID, TWILIO, WHATSAPP, FCM, APNS, etc.
  providerMessageId  String?
  attemptCount       Int                          @default(0)
  maxAttempts        Int                          @default(3)

  source             String                       // BOOKING, PAYMENT, MEMBERSHIP, REACTIVATION, DAILY_CHECKIN, SYSTEM, STAFF, MARKETING, AI_AGENT
  sourceReferenceId  String?
  idempotencyKey     String?                      @unique

  cost               Decimal?                     @db.Decimal(10, 4)
  currency           String                       @default("USD")
  suppressionReason  String?
  metadata           Json?

  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organisation       Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet?                      @relation(fields: [outletId], references: [id], onDelete: SetNull)
  recipientUser      User?                        @relation("UserCommunications", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientMember    MemberProfile?               @relation("MemberCommunications", fields: [recipientMemberId], references: [id], onDelete: SetNull)
  template           CommunicationTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion    CommunicationTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  deliveryEvents     CommunicationDeliveryEvent[]
  retentionOutreaches RetentionOutreach[]
  followUpExecutions  FollowUpStepExecution[]

  @@index([organisationId, createdAt])
  @@index([recipientUserId])
  @@index([recipientMemberId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([scheduledAt])
  @@index([providerMessageId])
  @@index([source, sourceReferenceId])
  @@map("communications")
}

model CommunicationTemplate {
  id             String                         @id @default(cuid())
  organisationId String?                        // null = SYSTEM template
  name           String
  type           String                         // TRANSACTIONAL, OPERATIONAL, ENGAGEMENT, REACTIVATION, etc.
  channel        String                         // EMAIL, SMS, PUSH, WHATSAPP, IN_APP, VOICE
  status         String                         @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  description    String?
  isSystem       Boolean                        @default(false)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  organisation   Organisation?                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  versions       CommunicationTemplateVersion[]
  communications Communication[]

  @@unique([organisationId, name, channel])
  @@index([type, channel, status])
  @@index([organisationId])
  @@map("communication_templates")
}

model CommunicationTemplateVersion {
  id              String                @id @default(cuid())
  templateId      String
  version         Int
  subjectTemplate String?
  bodyTemplate    String                @db.Text
  variablesSchema Json                  // JSON schema or list of variables
  status          String                @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  createdBy       String?
  createdAt       DateTime              @default(now())

  template        CommunicationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  communications  Communication[]

  @@unique([templateId, version])
  @@index([templateId, status])
  @@map("communication_template_versions")
}

model CommunicationPreference {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  channel        String       // EMAIL, SMS, PUSH, WHATSAPP, IN_APP
  type           String       // TRANSACTIONAL, OPERATIONAL, ENGAGEMENT, REACTIVATION, REMINDER, SYSTEM, MARKETING, STAFF, SECURITY
  enabled        Boolean      @default(true)
  optedOutAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation("UserCommPreferences", fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId, channel, type])
  @@index([userId, organisationId])
  @@map("communication_preferences")
}

model CommunicationDeliveryEvent {
