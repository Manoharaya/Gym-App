  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([preferenceType])
  @@map("dietary_preferences")
}

model NutritionTarget {
  id                 String        @id @default(cuid())
  organisationId     String
  memberProfileId    String
  dailyCalories      Float
  proteinGrams       Float
  carbohydrateGrams  Float
  fatGrams           Float
  fiberGrams         Float?
  waterMl            Float?
  minCalories        Float?
  maxCalories        Float?
  minProtein         Float?
  effectiveFrom      DateTime      @default(now())
  effectiveTo        DateTime?
  source             String        @default("MEMBER_DEFINED") // MEMBER_DEFINED, TRAINER_ASSIGNED, DEFAULT
