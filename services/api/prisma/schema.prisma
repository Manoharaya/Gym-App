  reward          Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([organisationId])
  @@map("member_rewards")
}

// ============================================================================
// DAY 19 — AI PLATFORM FOUNDATION, MODEL GATEWAY, CONTEXT & SAFETY
// ============================================================================

model AIModel {
  id              String         @id @default(cuid())
  provider        String         // OPENAI, ANTHROPIC, GOOGLE, DEVELOPMENT
  modelKey        String         @unique // e.g. "gpt-4o-mini", "claude-3-5-sonnet", "dev-test-model"
  displayName     String
  capabilities    String[]       // TEXT_GENERATION, STRUCTURED_OUTPUT, VISION, TOOL_USE, LONG_CONTEXT, EMBEDDING
  contextWindow   Int            @default(128000)
  inputCostPer1M  Int            @default(0) // In minor units (cents) per 1M tokens
  outputCostPer1M Int            @default(0) // In minor units (cents) per 1M tokens
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE, DEPRECATED
  configuration   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  featureConfigs  AIFeatureConfiguration[]
  requests        AIRequest[]
  usageRecords    AIUsageRecord[]

  @@index([provider, status])
  @@map("ai_models")
}

model AIFeatureConfiguration {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  feature        String        // AI_PLATFORM_TEST, FITNESS_COACH, NUTRITION_COACH, etc.
  enabled        Boolean       @default(false)
  modelId        String?
  dailyLimit     Int?          @default(100) // max requests per day
  monthlyLimit   Int?          @default(3000) // max requests per month
  allowedRoles   String[]      // MEMBER, TRAINER, OUTLET_MANAGER, ORGANISATION_OWNER
  configuration  Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  model          AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@unique([organisationId, outletId, feature])
  @@index([organisationId, feature])
  @@index([feature, enabled])
  @@map("ai_feature_configurations")
}

model AIRequest {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  memberId       String?
  feature        String        // AI_PLATFORM_TEST, FITNESS_COACH, etc.
  status         String        @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED, BLOCKED, TIMED_OUT
  modelId        String?
  provider       String?
  requestType    String        @default("SYNC") // SYNC, ASYNC
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  metadata       Json?

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  model          AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  response       AIResponse?
  usageRecords   AIUsageRecord[]
  auditEvents    AIAuditEvent[]

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([memberId, createdAt])
  @@index([feature, status])
  @@map("ai_requests")
}

model AIResponse {
  id               String       @id @default(cuid())
  aiRequestId      String       @unique
  content          String       @db.Text
  structuredOutput Json?
  status           String       @default("SUCCEEDED") // SUCCEEDED, REJECTED, REDACTED
  model            String
  provider         String
  latencyMs        Int          @default(0)
  createdAt        DateTime     @default(now())

  aiRequest        AIRequest    @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  feedback         AIFeedback[]

  @@index([aiRequestId])
  @@map("ai_responses")
}

model AIPrompt {
  id              String        @id @default(cuid())
  organisationId  String?       // null = FitCore platform system prompt
  feature         String        // AI_PLATFORM_TEST, FITNESS_COACH, etc.
  key             String        // e.g. "default", "classification", "summary"
  version         Int           @default(1)
  systemPrompt    String        @db.Text
  developerPrompt String?       @db.Text
  outputSchema    Json?
  status          String        @default("ACTIVE") // DRAFT, TESTING, ACTIVE, ARCHIVED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, feature, key, version])
  @@index([feature, key, version])
  @@index([status])
  @@map("ai_prompts")
}

model AIUsageRecord {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  memberId       String?
  feature        String
  provider       String
  model          String
  modelId        String?
  requestId      String?
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  totalTokens    Int           @default(0)
  latencyMs      Int           @default(0)
  estimatedCost  Decimal       @default(0) @db.Decimal(10, 4) // In cents (e.g. 0.0450 cents)
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  aiModel        AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  aiRequest      AIRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([memberId, createdAt])
  @@map("ai_usage_records")
}

model AIAuditEvent {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  feature        String
  requestId      String?
  eventType      String        // AI_REQUEST_CREATED, AI_REQUEST_BLOCKED, etc.
  result         String        // SUCCESS, FAILURE, BLOCKED
  metadata       Json?
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiRequest      AIRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([feature, createdAt])
  @@index([eventType, result])
  @@map("ai_audit_events")
}

model AIFeedback {
  id           String        @id @default(cuid())
  aiResponseId String
  userId       String
  memberId     String?
  rating       String        // HELPFUL, NOT_HELPFUL, REPORT
  reason       String?
  comment      String?
  createdAt    DateTime      @default(now())

  aiResponse   AIResponse    @relation(fields: [aiResponseId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([aiResponseId])
  @@index([userId, createdAt])
  @@map("ai_feedbacks")
}

