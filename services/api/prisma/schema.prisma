  updatedAt           DateTime           @updatedAt

  mealPlanDay         MealPlanDay        @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  items               MealPlanFoodItem[]

  @@index([mealPlanDayId])
  @@map("meal_plan_meals")
}

model MealPlanFoodItem {
  id                  String             @id @default(cuid())
  mealPlanMealId      String
  foodId              String
  quantity            Float
  unit                String
  calories            Float
  protein             Float
  carbohydrates       Float
  fat                 Float
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mealPlanMeal        MealPlanMeal       @relation(fields: [mealPlanMealId], references: [id], onDelete: Cascade)
  food                Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealPlanMealId])
  @@index([foodId])
  @@map("meal_plan_food_items")
