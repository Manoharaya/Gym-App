  memberProfileId    String?
  name               String
  mealType           String             // BREAKFAST, LUNCH, DINNER, SNACK, PRE_WORKOUT, POST_WORKOUT, OTHER
  scheduledTime      String?
  notes              String?
  status             String             @default("ACTIVE")
  workoutId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile?     @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  workout            Workout?           @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  items              MealFoodItem[]
  foodLogs           FoodLog[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([mealType])
  @@map("meals")
}

model MealFoodItem {
  id                 String             @id @default(cuid())
  mealId             String
  foodId             String
  quantity           Float
  unit               String
  sortOrder          Int                @default(0)
  calories           Float
  protein            Float
  carbohydrates      Float
  fat                Float
  fiber              Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  meal               Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food               Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([foodId])
  @@map("meal_food_items")
}

model MealPlan {
  id                  String                     @id @default(cuid())
  organisationId      String
  name                String
  description         String?
  dietaryPattern      String?                    // OMNIVORE, VEGAN, etc.
  targetDailyCalories Float?
  targetProteinGrams  Float?
  targetCarbGrams     Float?
  targetFatGrams      Float?
  durationDays        Int                        @default(7)
  version             Int                        @default(1)
  parentId            String?
  status              String                     @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  createdById         String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organisation        Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy           User?                      @relation("MealPlansCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  parent              MealPlan?                  @relation("MealPlanVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions            MealPlan[]                 @relation("MealPlanVersions")
  days                MealPlanDay[]
  assignments         MemberMealPlanAssignment[]

  @@index([organisationId])
  @@index([status])
  @@index([version])
  @@map("meal_plans")
}

model MealPlanDay {
  id                  String             @id @default(cuid())
  mealPlanId          String
  dayNumber           Int
  dayName             String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mealPlan            MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meals               MealPlanMeal[]

  @@index([mealPlanId])
  @@index([dayNumber])
  @@map("meal_plan_days")
}

model MealPlanMeal {
