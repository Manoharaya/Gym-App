// ==========================================
// DAY 18: MEMBER ENGAGEMENT, HABITS, CHALLENGES & RETENTION FOUNDATION
// ==========================================

model EngagementEvent {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  memberId       String
  eventType      String        // APP_OPENED, GYM_CHECKED_IN, CLASS_ATTENDED, WORKOUT_COMPLETED, etc.
  sourceType     String        // ATTENDANCE, WORKOUT, BOOKING, GOAL, NUTRITION, CHALLENGE, HABIT, REWARD, SYSTEM
  sourceId       String?
  metadata       Json?
  idempotencyKey String?       @unique
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile  MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([eventType])
  @@index([sourceType, sourceId])
  @@map("engagement_events")
}

model MemberEngagementProfile {
  id                      String        @id @default(cuid())
  organisationId          String
  memberId                String        @unique
  engagementLevel         String        @default("NEW") // NEW, ACTIVE, ENGAGED, HIGHLY_ENGAGED, AT_RISK, DORMANT
  engagementScore         Float         @default(0)
  currentStreak           Int           @default(0)
  longestStreak           Int           @default(0)
  lastActivityAt          DateTime?
  lastGymVisitAt          DateTime?
  lastWorkoutAt           DateTime?
  lastNutritionActivityAt DateTime?
  totalVisits             Int           @default(0)
  totalWorkouts           Int           @default(0)
  totalCompletedClasses   Int           @default(0)
  totalCompletedGoals     Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organisation            Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile           MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, engagementLevel])
  @@index([organisationId, engagementScore])
  @@map("member_engagement_profiles")
}

model EngagementScoreSnapshot {
  id                 String        @id @default(cuid())
  organisationId     String
  memberId           String
  score              Float
  engagementLevel    String
  calculationVersion Int           @default(1)
  scoreBreakdown     Json?
  calculatedAt       DateTime      @default(now())

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, calculatedAt])
  @@index([organisationId, calculatedAt])
  @@map("engagement_score_snapshots")
}

model Habit {
  id             String        @id @default(cuid())
  organisationId String?       // null = system default habit
  name           String
  description    String?
  category       String        @default("CUSTOM") // ATTENDANCE, WORKOUT, NUTRITION, HYDRATION, MOBILITY, RECOVERY, SLEEP, GOAL, CUSTOM
  frequency      String        @default("DAILY")  // DAILY, WEEKLY
  target         Float         @default(1)
  unit           String?       // e.g. "L", "min", "times"
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberHabits   MemberHabit[]

  @@index([organisationId, category])
  @@index([active])
  @@map("habits")
}

model MemberHabit {
  id             String            @id @default(cuid())
  organisationId String
  memberId       String
  habitId        String
  startDate      DateTime
  endDate        DateTime?
  target         Float
  frequency      String            @default("DAILY")
  status         String            @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CANCELLED
  currentStreak  Int               @default(0)
  longestStreak  Int               @default(0)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  habit          Habit             @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("HabitsCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  completions    HabitCompletion[]

  @@index([memberId, status])
  @@index([organisationId])
  @@map("member_habits")
}

model HabitCompletion {
  id            String      @id @default(cuid())
  memberHabitId String
  date          DateTime    // UTC midnight for local day
  value         Float
  unit          String?
  completed     Boolean     @default(true)
  source        String      @default("MANUAL") // MANUAL, ATTENDANCE, WORKOUT, NUTRITION, WATER
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberHabit   MemberHabit @relation(fields: [memberHabitId], references: [id], onDelete: Cascade)

  @@unique([memberHabitId, date])
  @@index([memberHabitId, date])
  @@map("habit_completions")
}

model Challenge {
  id                 String                 @id @default(cuid())
  organisationId     String
  outletId           String?
  name               String
  description        String?
  challengeType      String                 // ATTENDANCE, WORKOUT_COMPLETION, CLASS_ATTENDANCE, HABIT_COMPLETION, GOAL_PROGRESS, CUSTOM
  metric             String                 // e.g. WORKOUT_COUNT, ATTENDANCE_COUNT, CLASS_COUNT, HABIT_STREAK
  target             Float
  periodDays         Int?
  startDate          DateTime
  endDate            DateTime
  status             String                 @default("DRAFT") // DRAFT, PUBLISHED, ACTIVE, COMPLETED, CANCELLED, ARCHIVED
  participationLimit Int?
  leaderboardEnabled Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet?                @relation(fields: [outletId], references: [id], onDelete: SetNull)
  participants       ChallengeParticipant[]

  @@index([organisationId, status])
  @@index([startDate, endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id              String        @id @default(cuid())
  challengeId     String
  memberId        String
  organisationId  String
  joinedAt        DateTime      @default(now())
  completedAt     DateTime?
  currentProgress Float         @default(0)
  target          Float
  status          String        @default("JOINED") // JOINED, IN_PROGRESS, COMPLETED, WITHDRAWN, EXPIRED
  rank            Int?
  updatedAt       DateTime      @updatedAt

  challenge       Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([challengeId, memberId])
  @@index([challengeId, status])
  @@index([memberId])
  @@map("challenge_participants")
}

model Badge {
  id             String        @id @default(cuid())
  organisationId String?       // null = system badge
  code           String        @unique // FIRST_WORKOUT, 10_WORKOUTS, 7_DAY_STREAK, etc.
  name           String
  description    String
  category       String        // WORKOUT, ATTENDANCE, STREAK, GOAL, CHALLENGE, COMMUNITY
  iconUrl        String?
  criteria       Json          // deterministic qualification rules
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberBadges   MemberBadge[]

  @@index([category])
  @@map("badges")
}

model MemberBadge {
  id             String        @id @default(cuid())
  organisationId String
  memberId       String
  badgeId        String
  awardedAt      DateTime      @default(now())
  metadata       Json?

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge          Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([memberId, badgeId])
  @@index([memberId])
  @@index([organisationId])
  @@map("member_badges")
}

model Reward {
  id             String         @id @default(cuid())
  organisationId String
  outletId       String?
  name           String
  description    String
  category       String         @default("PERK") // ACHIEVEMENT_BADGE, FREE_CLASS, GUEST_PASS, MERCHANDISE_DISCOUNT, RECOGNITION, PERK
  pointsRequired Int            @default(0)
  inventory      Int?           // null = unlimited
  active         Boolean        @default(true)
  validDays      Int?           // validity duration in days
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organisation   Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberRewards  MemberReward[]

  @@index([organisationId, active])
  @@map("rewards")
}

model MemberReward {
  id              String        @id @default(cuid())
  organisationId  String
  memberId        String
  rewardId        String
  status          String        @default("AVAILABLE") // AVAILABLE, REDEEMED, EXPIRED, CANCELLED
  earnedAt        DateTime      @default(now())
  expiresAt       DateTime?
  redeemedAt      DateTime?
  redemptionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward          Reward        @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([organisationId])
  @@map("member_rewards")
}

// ============================================================================
// DAY 19 — AI PLATFORM FOUNDATION, MODEL GATEWAY, CONTEXT & SAFETY
// ============================================================================

model AIModel {
  id              String         @id @default(cuid())
  provider        String         // OPENAI, ANTHROPIC, GOOGLE, DEVELOPMENT
  modelKey        String         @unique // e.g. "gpt-4o-mini", "claude-3-5-sonnet", "dev-test-model"
  displayName     String
  capabilities    String[]       // TEXT_GENERATION, STRUCTURED_OUTPUT, VISION, TOOL_USE, LONG_CONTEXT, EMBEDDING
  contextWindow   Int            @default(128000)
  inputCostPer1M  Int            @default(0) // In minor units (cents) per 1M tokens
  outputCostPer1M Int            @default(0) // In minor units (cents) per 1M tokens
  status          String         @default("ACTIVE") // ACTIVE, INACTIVE, DEPRECATED
  configuration   Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  featureConfigs  AIFeatureConfiguration[]
  requests        AIRequest[]
  usageRecords    AIUsageRecord[]

  @@index([provider, status])
  @@map("ai_models")
}

model AIFeatureConfiguration {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  feature        String        // AI_PLATFORM_TEST, FITNESS_COACH, NUTRITION_COACH, etc.
  enabled        Boolean       @default(false)
  modelId        String?
  dailyLimit     Int?          @default(100) // max requests per day
  monthlyLimit   Int?          @default(3000) // max requests per month
  allowedRoles   String[]      // MEMBER, TRAINER, OUTLET_MANAGER, ORGANISATION_OWNER
  configuration  Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  model          AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@unique([organisationId, outletId, feature])
  @@index([organisationId, feature])
  @@index([feature, enabled])
  @@map("ai_feature_configurations")
}

model AIRequest {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  memberId       String?
  feature        String        // AI_PLATFORM_TEST, FITNESS_COACH, etc.
  status         String        @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED, BLOCKED, TIMED_OUT
  modelId        String?
  provider       String?
  requestType    String        @default("SYNC") // SYNC, ASYNC
  createdAt      DateTime      @default(now())
  completedAt    DateTime?
  metadata       Json?

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  model          AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  response       AIResponse?
  usageRecords   AIUsageRecord[]
  auditEvents    AIAuditEvent[]

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([memberId, createdAt])
  @@index([feature, status])
  @@map("ai_requests")
}

model AIResponse {
  id               String       @id @default(cuid())
  aiRequestId      String       @unique
  content          String       @db.Text
  structuredOutput Json?
  status           String       @default("SUCCEEDED") // SUCCEEDED, REJECTED, REDACTED
  model            String
  provider         String
  latencyMs        Int          @default(0)
  createdAt        DateTime     @default(now())

  aiRequest        AIRequest    @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  feedback         AIFeedback[]

  @@index([aiRequestId])
  @@map("ai_responses")
}

model AIPrompt {
  id              String        @id @default(cuid())
  organisationId  String?       // null = FitCore platform system prompt
  feature         String        // AI_PLATFORM_TEST, FITNESS_COACH, etc.
  key             String        // e.g. "default", "classification", "summary"
  version         Int           @default(1)
  systemPrompt    String        @db.Text
  developerPrompt String?       @db.Text
  outputSchema    Json?
  status          String        @default("ACTIVE") // DRAFT, TESTING, ACTIVE, ARCHIVED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, feature, key, version])
  @@index([feature, key, version])
  @@index([status])
  @@map("ai_prompts")
}

model AIUsageRecord {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  memberId       String?
  feature        String
  provider       String
  model          String
  modelId        String?
  requestId      String?
  inputTokens    Int           @default(0)
  outputTokens   Int           @default(0)
  totalTokens    Int           @default(0)
  latencyMs      Int           @default(0)
  estimatedCost  Decimal       @default(0) @db.Decimal(10, 4) // In cents (e.g. 0.0450 cents)
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  aiModel        AIModel?      @relation(fields: [modelId], references: [id], onDelete: SetNull)
  aiRequest      AIRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([memberId, createdAt])
  @@map("ai_usage_records")
}

model AIAuditEvent {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  feature        String
  requestId      String?
  eventType      String        // AI_REQUEST_CREATED, AI_REQUEST_BLOCKED, etc.
  result         String        // SUCCESS, FAILURE, BLOCKED
  metadata       Json?
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiRequest      AIRequest?    @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([feature, createdAt])
  @@index([eventType, result])
  @@map("ai_audit_events")
}

model AIFeedback {
  id           String        @id @default(cuid())
  aiResponseId String
  userId       String
  memberId     String?
  rating       String        // HELPFUL, NOT_HELPFUL, REPORT
  reason       String?
  comment      String?
  createdAt    DateTime      @default(now())

  aiResponse   AIResponse    @relation(fields: [aiResponseId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberProfile MemberProfile? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([aiResponseId])
  @@index([userId, createdAt])
  @@map("ai_feedbacks")
}

