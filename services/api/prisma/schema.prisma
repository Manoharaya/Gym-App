datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organisation {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  status      String    @default("ACTIVE") // ACTIVE, SUSPENDED, TRIAL, DELETED
  timezone    String    @default("Australia/Perth")
  currency    String    @default("AUD")
  country     String    @default("Australia")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  outlets        Outlet[]
  userRoles      UserRole[]
  auditLogs      AuditLog[]
  invitations    Invitation[]
  memberProfiles MemberProfile[]
  membershipPlans      MembershipPlan[]
  memberMemberships    MemberMembership[]
  paymentCustomers     PaymentCustomer[]
  paymentMethods       PaymentMethod[]
  invoices             Invoice[]
  paymentTransactions  PaymentTransaction[]
  paymentRefunds       PaymentRefund[]
  discounts            Discount[]
  idempotencyRecords   IdempotencyRecord[]
  accessCredentials    AccessCredential[]
  accessPoints         AccessPoint[]
  accessDevices        AccessDevice[]
  accessPolicies       AccessPolicy[]
  accessOverrides      AccessOverride[]
  checkIns             CheckIn[]
  accessEvents         AccessEvent[]
  guestAccessPasses    GuestAccessPass[]
  classTypes           ClassType[]
  classTemplates       ClassTemplate[]
  classSessions        ClassSession[]
  bookingPolicies      BookingPolicy[]
  resources            Resource[]
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]
  trainerAvailabilities TrainerAvailability[]
  recurringSchedules   RecurringSchedule[]
  attendanceRecords    AttendanceRecord[]
  staffProfiles        StaffProfile[]
  trainerProfiles      TrainerProfile[]
  trainerClientAssignments TrainerClientAssignment[]
  trainingPrograms     TrainingProgram[]
  trainingGoals        TrainingGoal[]
  trainerNotes         TrainerNote[]
  personalTrainingSessions PersonalTrainingSession[]
  exercises            Exercise[]
  workoutTemplates     WorkoutTemplate[]
  workouts             Workout[]
  trainingPlans        TrainingPlan[]
  workoutProgressionRules WorkoutProgressionRule[]
  bodyMeasurements     BodyMeasurement[]
  assessmentTemplates  AssessmentTemplate[]
  assessments          Assessment[]
  personalRecords      PersonalRecord[]
  progressSnapshots    ProgressSnapshot[]
  nutritionProfiles    NutritionProfile[]
  dietaryPreferences   DietaryPreference[]
  nutritionTargets     NutritionTarget[]
  foods                Food[]
  meals                Meal[]
  mealPlans            MealPlan[]
  mealPlanAssignments  MemberMealPlanAssignment[]
  foodLogs             FoodLog[]
  waterLogs            WaterLog[]
  nutritionSummaries   NutritionSummary[]
  notifications        Notification[]
  notificationPreferences NotificationPreference[]
  notificationTemplates NotificationTemplate[]
  pushDevices          PushDevice[]
  notificationSchedules NotificationSchedule[]
  engagementEvents     EngagementEvent[]
  memberEngagementProfiles MemberEngagementProfile[]
  engagementScoreSnapshots EngagementScoreSnapshot[]
  habits               Habit[]
  memberHabits         MemberHabit[]
  challenges           Challenge[]
  challengeParticipants ChallengeParticipant[]
  badges               Badge[]
  memberBadges         MemberBadge[]
  rewards              Reward[]
  memberRewards        MemberReward[]
  aiFeatureConfigurations AIFeatureConfiguration[]
  aiRequests           AIRequest[]
  aiPrompts            AIPrompt[]
  aiUsageRecords       AIUsageRecord[]
  aiAuditEvents        AIAuditEvent[]
  fitnessCoachProfiles AIFitnessCoachProfile[]
  fitnessCoachConversations AIFitnessCoachConversation[]
  fitnessSafetyEscalations AIFitnessSafetyEscalation[]
  nutritionCoachProfiles AINutritionCoachProfile[]
  nutritionCoachConversations AINutritionCoachConversation[]
  nutritionSafetyEscalations AINutritionSafetyEscalation[]
  dailyCheckIns        DailyCheckIn[]
  dailyCheckInSettings DailyCheckInSetting[]
  wearableConnections  WearableConnection[]
  healthDataRecords    HealthDataRecord[]
  wearableSyncLogs     WearableSyncLog[]
  wearableInsights     WearableInsight[]
  engagementInsights   EngagementInsight[]
  retentionAnalyses    RetentionAnalysis[]
  retentionFollowUpTasks RetentionFollowUpTask[]
  memberReactivationProfiles MemberReactivationProfile[]
  memberRecoveryPlans        MemberRecoveryPlan[]
  communications             Communication[]
  communicationTemplates     CommunicationTemplate[]
  communicationPreferences   CommunicationPreference[]
  retentionAgentAnalyses     RetentionAgentAnalysis[]
  retentionOutreaches        RetentionOutreach[]
  engagementWorkflows        EngagementWorkflow[]
  workflowInstances          WorkflowInstance[]
  aiReceptionists              AIReceptionist[]
  receptionistKnowledgeSources ReceptionistKnowledgeSource[]
  receptionistConversations    ReceptionistConversation[]
  receptionistHandoffs         ReceptionistHandoff[]
  receptionistKnowledgeGaps    ReceptionistKnowledgeGap[]
  receptionistFeedbacks        ReceptionistFeedback[]
  bookingConfirmations         BookingConfirmationState[]
  receptionistBookingInteractions ReceptionistBookingInteraction[]

  @@index([slug])
  @@index([status])
  @@map("organisations")
}

model Outlet {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  slug            String
  code            String
  status          String        @default("ACTIVE") // ACTIVE, MAINTENANCE, COMING_SOON, DELETED
  timezone        String        @default("Australia/Perth")
  address         String
  city            String
  state           String
  country         String        @default("Australia")
  postalCode      String
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Relations
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  userOutlets     UserOutlet[]
  auditLogs       AuditLog[]
  invitations     Invitation[]
  memberOutlets   MemberOutlet[]
  planOutlets          MembershipPlanOutlet[]
  originMemberships    MemberMembership[]     @relation("OriginOutlet")
  membershipAccesses   MemberMembershipOutlet[]
  accessPoints         AccessPoint[]
  accessDevices        AccessDevice[]
  accessPolicies       AccessPolicy[]
  accessOverrides      AccessOverride[]
  checkIns             CheckIn[]
  accessEvents         AccessEvent[]
  guestAccessPasses    GuestAccessPass[]
  resources            Resource[]
  classSessions        ClassSession[]
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]
  recurringSchedules   RecurringSchedule[]
  attendanceRecords    AttendanceRecord[]
  staffOutletAssignments StaffOutletAssignment[]
  trainerClientAssignments TrainerClientAssignment[]
  trainingPrograms     TrainingProgram[]
  trainerNotes         TrainerNote[]
  personalTrainingSessions PersonalTrainingSession[]
  workouts             Workout[]
  bodyMeasurements     BodyMeasurement[]
  assessments          Assessment[]
  notifications        Notification[]
  notificationSchedules NotificationSchedule[]
  engagementEvents     EngagementEvent[]
  challenges           Challenge[]
  rewards              Reward[]
  aiFeatureConfigurations AIFeatureConfiguration[]
  aiRequests           AIRequest[]
  aiUsageRecords       AIUsageRecord[]
  aiAuditEvents        AIAuditEvent[]
  retentionFollowUpTasks RetentionFollowUpTask[]
  memberRecoveryPlans    MemberRecoveryPlan[]
  communications         Communication[]
  retentionAgentAnalyses RetentionAgentAnalysis[]
  retentionOutreaches    RetentionOutreach[]
  engagementWorkflows    EngagementWorkflow[]
  workflowInstances      WorkflowInstance[]
  aiReceptionists              AIReceptionist[]
  receptionistKnowledgeSources ReceptionistKnowledgeSource[]
  receptionistConversations    ReceptionistConversation[]
  receptionistHandoffs         ReceptionistHandoff[]
  receptionistKnowledgeGaps    ReceptionistKnowledgeGap[]
  bookingConfirmations         BookingConfirmationState[]
  receptionistBookingInteractions ReceptionistBookingInteraction[]

  @@unique([organisationId, slug])
  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([status])
  @@map("outlets")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?
  passwordHash     String
  firstName        String
  lastName         String
  displayName      String?
  avatarUrl        String?
  status           String        @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED, DISABLED, DELETED
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  // Relations
  userRoles        UserRole[]
  userOutlets      UserOutlet[]
  sessions         Session[]
  auditLogs        AuditLog[]
  invitationsSent        Invitation[]     @relation("InvitationsSent")
  memberProfile          MemberProfile?
  accessOverridesCreated AccessOverride[] @relation("AccessOverridesCreated")
  guestPassesCreated     GuestAccessPass[] @relation("GuestPassesCreated")
  trainerSessions           ClassSession[]        @relation("TrainerSessions")
  trainerAvailabilities     TrainerAvailability[]
  trainerRecurringSchedules RecurringSchedule[]   @relation("TrainerRecurringSchedules")
  substituteTrainerSessions ClassSession[]        @relation("SubstituteTrainerSessions")
  attendanceRecordsMarked   AttendanceRecord[]    @relation("AttendanceMarkedByUser")
  staffProfile              StaffProfile?
  staffOutletAssignmentsCreated StaffOutletAssignment[] @relation("StaffOutletAssignmentsCreated")
  trainerClientAssignmentsCreated TrainerClientAssignment[] @relation("TrainerClientAssignmentsCreated")
  certificationsVerified    TrainerCertification[] @relation("CertificationsVerified")
  goalsCreated              TrainingGoal[]         @relation("GoalsCreatedByUser")
  goalHistories             GoalHistory[]          @relation("GoalHistoryActor")
  cancelledPtSessions       PersonalTrainingSession[] @relation("PtSessionsCancelledByUser")
  exercisesCreated          Exercise[]             @relation("ExercisesCreatedByUser")
  setCorrectionsMade        WorkoutSetCorrection[] @relation("SetCorrectionsByUser")
  measurementsRecorded      BodyMeasurement[]      @relation("MeasurementsRecordedByUser")
  nutritionTargetsAssigned  NutritionTarget[]      @relation("NutritionTargetsAssignedByUser")
  foodsCreated              Food[]                 @relation("FoodsCreatedByUser")
  mealPlansCreated          MealPlan[]             @relation("MealPlansCreatedByUser")
  mealPlansAssigned         MemberMealPlanAssignment[] @relation("MealPlansAssignedByUser")
  foodLogsLogged            FoodLog[]              @relation("FoodLogsLoggedByUser")
  notificationsReceived     Notification[]         @relation("UserNotifications")
  notificationPreferences   NotificationPreference[] @relation("UserNotificationPreferences")
  pushDevices               PushDevice[]           @relation("UserPushDevices")
  scheduledNotifications    NotificationSchedule[] @relation("UserScheduledNotifications")
  habitsCreated             MemberHabit[]          @relation("HabitsCreatedByUser")
  aiRequests                AIRequest[]
  aiUsageRecords            AIUsageRecord[]
  aiAuditEvents             AIAuditEvent[]
  aiFeedbacks               AIFeedback[]
  assignedRetentionTasks    RetentionFollowUpTask[] @relation("AssignedRetentionStaff")
  completedRetentionTasks   RetentionFollowUpTask[] @relation("CompletedRetentionStaff")
  assignedRecoveryPlans     MemberRecoveryPlan[]    @relation("AssignedRecoveryStaff")
  approvedRecoveryPlans     MemberRecoveryPlan[]    @relation("ApprovedRecoveryStaff")
  communicationsReceived    Communication[]         @relation("UserCommunications")
  communicationPreferences  CommunicationPreference[] @relation("UserCommPreferences")
  assignedRetentionOutreaches RetentionOutreach[]     @relation("AssignedOutreachStaff")
  approvedRetentionOutreaches RetentionOutreach[]     @relation("ApprovedOutreachStaff")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model Role {
  id            String           @id @default(cuid())
  name          String           @unique // SUPERADMIN, ORGANISATION_OWNER, OUTLET_MANAGER, RECEPTION, TRAINER, FINANCE, MEMBER
  description   String?
  isSystemRole  Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  permissions   RolePermission[]
  userRoles     UserRole[]
  invitations   Invitation[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    String           // members, outlets, organisations, staff, appointments, etc.
  action      String           // CREATE, READ, UPDATE, DELETE, MANAGE, ASSIGN, REVOKE
  scope       String           // PLATFORM, ORGANISATION, OUTLET, ASSIGNED_CLIENTS, SELF
  description String?
  createdAt   DateTime         @default(now())

  // Relations
  roles       RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String        @id @default(cuid())
  userId          String
  roleId          String
  organisationId  String
  outletId        String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organisationId])
  @@index([outletId])
  @@map("user_roles")
}

model UserOutlet {
  id        String   @id @default(cuid())
  userId    String
  outletId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([userId])
  @@index([outletId])
  @@map("user_outlets")
}

model Session {
  id            String         @id @default(cuid())
  userId        String
  tokenFamily   String
  isValid       Boolean        @default(true)
  userAgent     String?
  ipAddress     String?
  expiresAt     DateTime
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([tokenFamily])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  sessionId String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Invitation {
  id              String        @id @default(cuid())
  email           String
  organisationId  String
  outletId        String?
  roleId          String
  tokenHash       String        @unique
  status          String        @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy       User?         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([email])
  @@index([organisationId])
  @@index([status])
  @@map("invitations")
}

model AuditLog {
  id              String        @id @default(cuid())
  userId          String?
  organisationId  String?
  outletId        String?
  action          String
  resource        String
  resourceId      String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  createdAt       DateTime      @default(now())

  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organisationId])
  @@index([outletId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==========================================
// DAY 4: MEMBER & ONBOARDING DOMAIN MODELS
// ==========================================

model MemberProfile {
  id                           String    @id @default(cuid())
  userId                       String    @unique
  organisationId               String
  preferredName                String?
  dateOfBirth                  DateTime?
  gender                       String?   // MALE, FEMALE, NON_BINARY, PREFER_NOT_TO_SAY, OTHER
  profilePhotoUrl              String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  timezone                     String    @default("Australia/Perth")
  status                       String    @default("ONBOARDING") // INVITED, ONBOARDING, ACTIVE, SUSPENDED, INACTIVE, ARCHIVED
  onboardingStatus             String    @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, REQUIRES_ACTION, READY_FOR_REVIEW, COMPLETED
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?

  // Relations
  user                         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation                 Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberOutlets                MemberOutlet[]
  onboarding                   MemberOnboarding?
  parqSubmissions              ParqSubmission[]
  healthScreenings             HealthScreening[]
  injuries                     Injury[]
  medicalClearances            MedicalClearance[]
  consentRecords               ConsentRecord[]
  documents                    MemberDocument[]
  signatures                   Signature[]
  memberships                  MemberMembership[]
  paymentCustomers             PaymentCustomer[]
  paymentMethods               PaymentMethod[]
  invoices                     Invoice[]
  paymentTransactions          PaymentTransaction[]
  accessCredentials            AccessCredential[]
  accessOverrides              AccessOverride[]
  checkIns                     CheckIn[]
  accessEvents                 AccessEvent[]
  bookings                     Booking[]
  waitlistEntries              WaitlistEntry[]
  attendanceRecords            AttendanceRecord[]
  trainerClientAssignments     TrainerClientAssignment[]
  trainingPrograms             TrainingProgram[]
  trainingGoals                TrainingGoal[]
  trainerNotes                 TrainerNote[]
  personalTrainingSessions     PersonalTrainingSession[]
  workouts                     Workout[]
  trainingPlans                TrainingPlan[]
  bodyMeasurements             BodyMeasurement[]
  assessments                  Assessment[]
  personalRecords              PersonalRecord[]
  progressSnapshots            ProgressSnapshot[]
  nutritionProfile             NutritionProfile?
  dietaryPreferences           DietaryPreference[]
  nutritionTargets             NutritionTarget[]
  meals                        Meal[]
  mealPlanAssignments          MemberMealPlanAssignment[]
  foodLogs                     FoodLog[]
  waterLogs                    WaterLog[]
  nutritionSummaries           NutritionSummary[]
  notifications                Notification[]
  engagementEvents             EngagementEvent[]
  engagementProfile            MemberEngagementProfile?
  engagementScoreSnapshots     EngagementScoreSnapshot[]
  memberHabits                 MemberHabit[]
  challengeParticipants        ChallengeParticipant[]
  memberBadges                 MemberBadge[]
  memberRewards                MemberReward[]
  aiRequests                   AIRequest[]
  aiUsageRecords               AIUsageRecord[]
  aiFeedbacks                  AIFeedback[]
  fitnessCoachProfile          AIFitnessCoachProfile?
  fitnessCoachConversations    AIFitnessCoachConversation[]
  fitnessSafetyEscalations     AIFitnessSafetyEscalation[]
  nutritionCoachProfile        AINutritionCoachProfile?
  nutritionCoachConversations  AINutritionCoachConversation[]
  nutritionSafetyEscalations   AINutritionSafetyEscalation[]
  dailyCheckIns                DailyCheckIn[]
  dailyCheckInSetting          DailyCheckInSetting?
  wearableConnections          WearableConnection[]
  healthDataRecords            HealthDataRecord[]
  wearableSyncLogs             WearableSyncLog[]
  wearableInsights             WearableInsight[]
  engagementInsights           EngagementInsight[]
  retentionAnalyses            RetentionAnalysis[]
  retentionFollowUpTasks       RetentionFollowUpTask[]
  memberReactivationProfiles   MemberReactivationProfile[]
  memberRecoveryPlans          MemberRecoveryPlan[]
  communications               Communication[]             @relation("MemberCommunications")
  retentionAgentAnalyses       RetentionAgentAnalysis[]
  retentionOutreaches          RetentionOutreach[]
  workflowInstances            WorkflowInstance[]
  receptionistConversations    ReceptionistConversation[]
  receptionistHandoffs         ReceptionistHandoff[]
  bookingConfirmations         BookingConfirmationState[]
  receptionistBookingInteractions ReceptionistBookingInteraction[]

  @@index([userId])
  @@index([organisationId])
  @@index([status])
  @@index([onboardingStatus])
  @@map("member_profiles")
}

model MemberOutlet {
  id              String        @id @default(cuid())
  memberProfileId String
  outletId        String
  status          String        @default("ACTIVE") // ACTIVE, INACTIVE, TRANSFERRED
  joinedAt        DateTime      @default(now())
  leftAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([memberProfileId, outletId])
  @@index([memberProfileId])
  @@index([outletId])
  @@index([status])
  @@map("member_outlets")
}

model MemberOnboarding {
  id              String        @id @default(cuid())
  memberProfileId String        @unique
  currentStep     String        @default("PROFILE") // PROFILE, PARQ, HEALTH_SCREENING, INJURIES, CONSENTS, DOCUMENTS, SIGNATURE, REVIEW, COMPLETE
  status          String        @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, REQUIRES_ACTION, READY_FOR_REVIEW, COMPLETED
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([status])
  @@map("member_onboardings")
}

// ------------------------------------------
// PAR-Q (Physical Activity Readiness)
// ------------------------------------------

model Questionnaire {
  id            String           @id @default(cuid())
  type          String           @default("PARQ") // PARQ, HEALTH_SCREENING
  name          String
  version       String           // e.g. "2024.1"
  status        String           @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  questions     Question[]
  submissions   ParqSubmission[]

  @@unique([type, version])
  @@map("questionnaires")
}

model Question {
  id              String         @id @default(cuid())
  questionnaireId String
  questionKey     String         // e.g. "chest_pain", "balance_dizziness"
  text            String
  type            String         @default("BOOLEAN") // BOOLEAN, SINGLE_SELECT, MULTI_SELECT, TEXT, NUMBER, DATE
  required        Boolean        @default(true)
  sortOrder       Int            @default(0)
  metadata        Json?          // Options, hint, triggers_review flag, etc.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  questionnaire   Questionnaire  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  responses       ParqResponse[]

  @@unique([questionnaireId, questionKey])
  @@index([questionnaireId])
  @@map("questions")
}

model ParqSubmission {
  id              String         @id @default(cuid())
  memberProfileId String
  questionnaireId String
  status          String         @default("DRAFT") // DRAFT, SUBMITTED, REQUIRES_REVIEW, APPROVED, REJECTED
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberProfile   MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  questionnaire   Questionnaire  @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  responses       ParqResponse[]

  @@index([memberProfileId])
  @@index([questionnaireId])
  @@index([status])
  @@map("parq_submissions")
}

model ParqResponse {
  id           String         @id @default(cuid())
  submissionId String
  questionId   String
  answer       Json           // e.g. { "value": true } or { "value": false }
  notes        String?
  createdAt    DateTime       @default(now())

  submission   ParqSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([submissionId])
  @@map("parq_responses")
}

// ------------------------------------------
// Health Screening & Injury Domains
// ------------------------------------------

model HealthScreening {
  id               String        @id @default(cuid())
  memberProfileId  String
  screeningVersion String        @default("1.0")
  status           String        @default("COMPLETED") // PENDING, COMPLETED, REQUIRES_CLEARANCE
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  memberProfile    MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@map("health_screenings")
}

model Injury {
  id              String        @id @default(cuid())
  memberProfileId String
  bodyArea        String        // SHOULDER, KNEE, LOWER_BACK, ANKLE, HIP, WRIST, NECK, OTHER
  description     String
  status          String        @default("ACTIVE") // ACTIVE, RECOVERING, RESOLVED
  startDate       DateTime?
  endDate         DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([status])
  @@map("injuries")
}

model MedicalClearance {
  id              String        @id @default(cuid())
  memberProfileId String
  status          String        @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, SUBMITTED, VERIFIED, EXPIRED, REJECTED
  issuedDate      DateTime?
  expiryDate      DateTime?
  documentId      String?
  notes           String?
  verifiedAt      DateTime?
  verifiedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([status])
  @@map("medical_clearances")
}

// ------------------------------------------
// Compliance Consent Domain
// ------------------------------------------

model ConsentType {
  id          String           @id @default(cuid())
  key         String           @unique // TERMS_AND_CONDITIONS, PRIVACY_POLICY, HEALTH_DATA_PROCESSING, WEARABLE_DATA, AI_PROCESSING, MARKETING, COMMUNICATION
  name        String
  description String?
  isMandatory Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  versions    ConsentVersion[]
  records     ConsentRecord[]

  @@map("consent_types")
}

model ConsentVersion {
  id            String          @id @default(cuid())
  consentTypeId String
  version       String          // e.g. "1.0", "2.0"
  content       String          // Summary/URL of policy text
  effectiveFrom DateTime        @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  consentType   ConsentType     @relation(fields: [consentTypeId], references: [id], onDelete: Cascade)
  records       ConsentRecord[]

  @@unique([consentTypeId, version])
  @@index([consentTypeId])
  @@map("consent_versions")
}

model ConsentRecord {
  id               String         @id @default(cuid())
  memberProfileId  String
  consentTypeId    String
  consentVersionId String
  status           String         @default("CONSENTED") // CONSENTED, DECLINED, WITHDRAWN
  consentedAt      DateTime       @default(now())
  withdrawnAt      DateTime?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  memberProfile    MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  consentType      ConsentType    @relation(fields: [consentTypeId], references: [id], onDelete: Cascade)
  consentVersion   ConsentVersion @relation(fields: [consentVersionId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([consentTypeId])
  @@index([status])
  @@map("consent_records")
}

// ------------------------------------------
// Digital Signature & Documents
// ------------------------------------------

model Signature {
  id                 String        @id @default(cuid())
  memberProfileId    String
  documentType       String        // ONBOARDING_AGREEMENT, PARQ_DECLARATION, CONSENT_FORM
  documentVersion    String
  signatureMethod    String        @default("ELECTRONIC_ACCEPTANCE") // ELECTRONIC_ACCEPTANCE, TYPED_NAME
  signerName         String
  signedAt           DateTime      @default(now())
  ipAddress          String?
  userAgent          String?
  signatureReference String        // SHA-256 evidence hash
  createdAt          DateTime      @default(now())

  memberProfile      MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([documentType])
  @@map("signatures")
}

model MemberDocument {
  id              String        @id @default(cuid())
  memberProfileId String
  documentType    String        // MEDICAL_CLEARANCE, CONSENT_DOCUMENT, IDENTITY_DOCUMENT, OTHER
  storageKey      String
  fileName        String
  mimeType        String
  size            Int
  status          String        @default("UPLOADED") // PENDING, UPLOADED, VERIFIED, REJECTED
  uploadedAt      DateTime      @default(now())
  uploadedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([memberProfileId])
  @@index([documentType])
  @@map("member_documents")
}

// ==========================================
// DAY 5: MEMBERSHIP, PLANS & SUBSCRIPTIONS
// ==========================================

model MembershipPlan {
  id                 String                  @id @default(cuid())
  organisationId     String
  name               String
  description        String?
  code               String
  status             String                  @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  membershipType     String                  @default("STANDARD") // STANDARD, TRIAL, INTRODUCTORY, CORPORATE, STUDENT, FAMILY, CUSTOM
  billingType        String                  @default("RECURRING") // ONE_TIME, RECURRING
  durationValue      Int                     @default(1)
  durationUnit       String                  @default("MONTH") // DAY, WEEK, MONTH, YEAR
  price              Float                   @default(0)
  currency           String                  @default("AUD")
  trialDuration      Int?                    // in days
  isPublic           Boolean                 @default(true)
  requiresApproval   Boolean                 @default(false)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  archivedAt         DateTime?

  // Relations
  organisation       Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  planOutlets        MembershipPlanOutlet[]
  entitlements       MembershipEntitlement[]
  memberMemberships  MemberMembership[]
  invoiceLineItems   InvoiceLineItem[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([status])
  @@index([membershipType])
  @@map("membership_plans")
}

model MembershipPlanOutlet {
  id               String         @id @default(cuid())
  membershipPlanId String
  outletId         String
  createdAt        DateTime       @default(now())

  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)
  outlet           Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([membershipPlanId, outletId])
  @@index([membershipPlanId])
  @@index([outletId])
  @@map("membership_plan_outlets")
}

model MembershipEntitlement {
  id               String         @id @default(cuid())
  membershipPlanId String
  type             String         // GYM_ACCESS, GROUP_CLASSES, PERSONAL_TRAINING, SAUNA, POOL, LOCKER, PREMIUM_AREA, DIGITAL_TRAINING, AI_COACH, NUTRITION
  name             String
  description      String?
  value            Float?         // Quantity limit (e.g. 8 for classes, null for unlimited)
  metadata         Json?          // e.g. { "period": "MONTH", "unlimited": true }
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  membershipPlan   MembershipPlan @relation(fields: [membershipPlanId], references: [id], onDelete: Cascade)

  @@index([membershipPlanId])
  @@index([type])
  @@map("membership_entitlements")
}

model MemberMembership {
  id                      String                    @id @default(cuid())
  organisationId          String
  memberProfileId         String
  membershipPlanId        String
  status                  String                    @default("PENDING") // PENDING, ACTIVE, TRIAL, PAUSED, SUSPENDED, EXPIRED, CANCELLED
  accessScope             String                    @default("SINGLE_OUTLET") // SINGLE_OUTLET, MULTI_OUTLET, ALL_ORGANISATION_OUTLETS
  originOutletId          String?
  startDate               DateTime
  endDate                 DateTime
  activatedAt             DateTime?
  pausedAt                DateTime?
  suspendedAt             DateTime?
  cancelledAt             DateTime?
  cancelledReason         String?
  autoRenew               Boolean                   @default(false)
  trialEndsAt             DateTime?

  // Commercial Snapshot (historical integrity preserved when plan changes)
  planNameAtPurchase      String
  priceAtPurchase         Float
  currencyAtPurchase      String
  billingTypeAtPurchase   String
  durationValueAtPurchase Int
  durationUnitAtPurchase  String

  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  // Relations
  organisation            Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile           MemberProfile             @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  membershipPlan          MembershipPlan            @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  originOutlet            Outlet?                   @relation("OriginOutlet", fields: [originOutletId], references: [id], onDelete: SetNull)
  accessOutlets           MemberMembershipOutlet[]
  history                 MemberMembershipHistory[]
  invoices                Invoice[]
  paymentTransactions     PaymentTransaction[]
  invoiceLineItems        InvoiceLineItem[]
  checkIns                CheckIn[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([membershipPlanId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("member_memberships")
}

model MemberMembershipOutlet {
  id                 String           @id @default(cuid())
  memberMembershipId String
  outletId           String
  createdAt          DateTime         @default(now())

  memberMembership   MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)
  outlet             Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([memberMembershipId, outletId])
  @@index([memberMembershipId])
  @@index([outletId])
  @@map("member_membership_outlets")
}

model MemberMembershipHistory {
  id                 String           @id @default(cuid())
  memberMembershipId String
  fromStatus         String?
  toStatus           String
  action             String           // CREATE, ACTIVATE, PAUSE, RESUME, SUSPEND, CANCEL, RENEW, EXPIRE
  reason             String?
  actorId            String?
  actorRole          String?
  metadata           Json?
  createdAt          DateTime         @default(now())

  memberMembership   MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)

  @@index([memberMembershipId])
  @@index([action])
  @@map("member_membership_history")
}

// ==========================================
// DAY 6: PAYMENTS, BILLING & FINANCIAL TRANSACTIONS
// ==========================================

model PaymentCustomer {
  id                 String           @id @default(cuid())
  organisationId     String
  memberProfileId    String
  provider           String           @default("MOCK") // MOCK, MANUAL, STRIPE, PAYPAL, etc.
  providerCustomerId String
  status             String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  email              String
  name               String?
  currency           String           @default("AUD")
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organisation       Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile    @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  paymentMethods     PaymentMethod[]
  paymentTransactions PaymentTransaction[]

  @@unique([organisationId, provider, providerCustomerId])
  @@index([organisationId])
  @@index([memberProfileId])
  @@map("payment_customers")
}

model PaymentMethod {
  id                      String              @id @default(cuid())
  organisationId          String
  memberProfileId         String
  paymentCustomerId       String?
  provider                String              @default("MOCK") // MOCK, MANUAL, STRIPE, etc.
  providerPaymentMethodId String
  type                    String              @default("CARD") // CARD, BANK_TRANSFER, CASH, POS, DIRECT_DEBIT, WALLET, OTHER
  status                  String              @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, FAILED
  brand                   String?             // visa, mastercard, amex
  last4                   String?             // 4242
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean             @default(false)
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  organisation            Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile           MemberProfile       @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  paymentCustomer         PaymentCustomer?    @relation(fields: [paymentCustomerId], references: [id], onDelete: SetNull)
  transactions            PaymentTransaction[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([paymentCustomerId])
  @@map("payment_methods")
}

model Invoice {
  id                  String               @id @default(cuid())
  organisationId      String
  memberProfileId     String
  memberMembershipId  String?
  invoiceNumber       String
  status              String               @default("OPEN") // DRAFT, OPEN, PAID, PARTIALLY_PAID, OVERDUE, VOID, UNCOLLECTIBLE
  currency            String               @default("AUD")
  subtotalMinor       Int                  @default(0)
  discountMinor       Int                  @default(0)
  taxMinor            Int                  @default(0)
  feeMinor            Int                  @default(0)
  totalMinor          Int                  @default(0)
  amountPaidMinor     Int                  @default(0)
  amountDueMinor      Int                  @default(0)
  dueDate             DateTime
  issuedAt            DateTime             @default(now())
  paidAt              DateTime?
  voidedAt            DateTime?
  description         String?
  metadata            Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile        @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  memberMembership    MemberMembership?    @relation(fields: [memberMembershipId], references: [id], onDelete: SetNull)
  lineItems           InvoiceLineItem[]
  transactions        PaymentTransaction[]

  @@unique([organisationId, invoiceNumber])
  @@index([organisationId])
  @@index([memberProfileId])
  @@index([memberMembershipId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id                  String            @id @default(cuid())
  invoiceId           String
  description         String
  quantity            Int               @default(1)
  unitAmountMinor     Int
  discountMinor       Int               @default(0)
  taxMinor            Int               @default(0)
  totalMinor          Int
  membershipPlanId    String?
  memberMembershipId  String?
  metadata            Json?
  createdAt           DateTime          @default(now())

  invoice             Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  membershipPlan      MembershipPlan?   @relation(fields: [membershipPlanId], references: [id], onDelete: SetNull)
  memberMembership    MemberMembership? @relation(fields: [memberMembershipId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

model PaymentTransaction {
  id                      String            @id @default(cuid())
  organisationId          String
  memberProfileId         String
  invoiceId               String?
  memberMembershipId      String?
  paymentCustomerId       String?
  paymentMethodId         String?
  provider                String            @default("MOCK") // MOCK, MANUAL, STRIPE, etc.
  providerTransactionId   String
  providerPaymentIntentId String?
  amountMinor             Int
  currency                String            @default("AUD")
  status                  String            @default("PENDING") // PENDING, PROCESSING, REQUIRES_ACTION, AUTHORIZED, SUCCEEDED, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED, DISPUTED
  paymentMethodType       String            @default("CARD") // CARD, BANK_TRANSFER, CASH, POS, DIRECT_DEBIT, WALLET, OTHER
  description             String?
  failureCode             String?
  failureMessage          String?
  metadata                Json?
  processedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  organisation            Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile           MemberProfile     @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  invoice                 Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  memberMembership        MemberMembership? @relation(fields: [memberMembershipId], references: [id], onDelete: SetNull)
  paymentCustomer         PaymentCustomer?  @relation(fields: [paymentCustomerId], references: [id], onDelete: SetNull)
  paymentMethod           PaymentMethod?    @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  refunds                 PaymentRefund[]

  @@unique([provider, providerTransactionId])
  @@index([organisationId])
  @@index([memberProfileId])
  @@index([invoiceId])
  @@index([memberMembershipId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentRefund {
  id                   String             @id @default(cuid())
  organisationId       String
  paymentTransactionId String
  amountMinor          Int
  currency             String             @default("AUD")
  providerRefundId     String?
  status               String             @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED
  reason               String?
  requestedById        String?
  processedAt          DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organisation         Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([paymentTransactionId])
  @@index([status])
  @@map("payment_refunds")
}

model Discount {
  id              String       @id @default(cuid())
  organisationId  String
  code            String
  name            String
  type            String       @default("PERCENTAGE") // PERCENTAGE, FIXED_AMOUNT
  valueMinor      Int?         // for FIXED_AMOUNT in cents
  percentage      Float?       // for PERCENTAGE (e.g. 10.0 for 10%)
  currency        String?      @default("AUD")
  active          Boolean      @default(true)
  startsAt        DateTime?
  endsAt          DateTime?
  usageLimit      Int?
  usedCount       Int          @default(0)
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([code])
  @@map("discounts")
}

model PaymentWebhookEvent {
  id                 String    @id @default(cuid())
  organisationId     String?
  provider           String    @default("MOCK") // MOCK, STRIPE, etc.
  providerEventId    String
  eventType          String
  signatureVerified  Boolean   @default(false)
  payloadHash        String?
  processingStatus   String    @default("RECEIVED") // RECEIVED, VERIFIED, PROCESSING, PROCESSED, FAILED, IGNORED
  processedAt        DateTime?
  errorMessage       String?
  retryCount         Int       @default(0)
  payload            Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([provider, providerEventId])
  @@index([provider])
  @@index([processingStatus])
  @@map("payment_webhook_events")
}

model IdempotencyRecord {
  id             String    @id @default(cuid())
  organisationId String
  idempotencyKey String
  resourceType   String    @default("PAYMENT")
  resourceId     String?
  responseStatus Int
  responseBody   Json
  createdAt      DateTime  @default(now())
  expiresAt      DateTime

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, idempotencyKey])
  @@index([organisationId])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model AccessCredential {
  id                   String        @id @default(cuid())
  organisationId       String
  memberProfileId      String
  type                 String        @default("QR_CODE") // QR_CODE, RFID, NFC, MOBILE, PIN, BIOMETRIC_REFERENCE, EXTERNAL
  status               String        @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED, REVOKED, EXPIRED
  credentialReference  String        // Opaque token or hashed identifier (never raw biometric/PIN)
  displayIdentifier    String?       // Masked string e.g. "•••4821" or "QR-Active"
  issuedAt             DateTime      @default(now())
  activatedAt          DateTime?
  revokedAt            DateTime?
  expiresAt            DateTime?
  lastUsedAt           DateTime?
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organisation         Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile        MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  checkIns             CheckIn[]
  accessEvents         AccessEvent[]

  @@unique([organisationId, credentialReference])
  @@index([organisationId])
  @@index([memberProfileId])
  @@index([type])
  @@index([status])
  @@map("access_credentials")
}

model AccessPoint {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String
  name           String
  type           String        @default("MAIN_ENTRANCE") // MAIN_ENTRANCE, TURNSTILE, DOOR, GATE, RESTRICTED_ZONE
  location       String?
  status         String        @default("ACTIVE") // ACTIVE, MAINTENANCE, DISABLED
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  devices        AccessDevice[]
  checkIns       CheckIn[]
  accessEvents   AccessEvent[]

  @@index([organisationId])
  @@index([outletId])
  @@index([status])
  @@map("access_points")
}

model AccessDevice {
  id               String        @id @default(cuid())
  organisationId   String
  outletId         String
  accessPointId    String?
  name             String
  type             String        @default("TURNSTILE") // DOOR, TURNSTILE, GATE, READER, SCANNER, LOCK, OTHER
  status           String        @default("ONLINE") // ONLINE, OFFLINE, MAINTENANCE, DISABLED, UNKNOWN
  provider         String        @default("MOCK") // MOCK, GENERIC_IOT, RFID, TURNSTILE, SMART_LOCK
  providerDeviceId String?
  direction        String        @default("ENTRY") // ENTRY, EXIT, BOTH
  location         String?
  deviceSecretHash String?
  lastHeartbeatAt  DateTime?
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organisation     Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet           Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  accessPoint      AccessPoint?  @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  checkIns         CheckIn[]
  accessEvents     AccessEvent[]

  @@unique([provider, providerDeviceId])
  @@index([organisationId])
  @@index([outletId])
  @@index([accessPointId])
  @@index([status])
  @@index([provider])
  @@map("access_devices")
}

model AccessPolicy {
  id                   String        @id @default(cuid())
  organisationId       String
  outletId             String?
  name                 String
  enabled              Boolean       @default(true)
  allowedStartTime     String        @default("06:00") // HH:mm format
  allowedEndTime       String        @default("22:00") // HH:mm format
  allowedDays          Int[]         @default([1, 2, 3, 4, 5, 6, 7]) // 1=Mon, 7=Sun
  membershipRequirements Json?
  guestAllowed         Boolean       @default(false)
  staffOverrideAllowed Boolean       @default(true)
  metadata             Json?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organisation         Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet               Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([outletId])
  @@index([enabled])
  @@map("access_policies")
}

model AccessOverride {
  id              String        @id @default(cuid())
  organisationId  String
  outletId        String
  memberProfileId String
  createdById     String
  reason          String        @default("MANAGER_APPROVAL") // MANAGER_APPROVAL, TECHNICAL_FAILURE, SPECIAL_EVENT, TEMPORARY_ACCESS, OTHER
  startsAt        DateTime      @default(now())
  expiresAt       DateTime
  status          String        @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  createdBy       User          @relation("AccessOverridesCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([status])
  @@index([expiresAt])
  @@map("access_overrides")
}

model CheckIn {
  id                 String            @id @default(cuid())
  organisationId     String
  outletId           String
  memberProfileId    String
  memberMembershipId String?
  credentialId       String?
  accessPointId      String?
  deviceId           String?
  method             String            @default("QR") // QR, RFID, NFC, MOBILE, MANUAL, DEVICE, OTHER
  status             String            @default("SUCCESS") // SUCCESS, DENIED, CANCELLED, ERROR
  checkedInAt        DateTime          @default(now())
  checkedOutAt       DateTime?
  source             String            @default("TURNSTILE") // TURNSTILE, RECEPTION, MOBILE, API
  deviceEventId      String?
  denialReason       String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organisation       Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile     @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  memberMembership   MemberMembership? @relation(fields: [memberMembershipId], references: [id], onDelete: SetNull)
  credential         AccessCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  accessPoint        AccessPoint?      @relation(fields: [accessPointId], references: [id], onDelete: SetNull)
  device             AccessDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([deviceId, deviceEventId])
  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([status])
  @@index([checkedInAt])
  @@index([checkedOutAt])
  @@map("check_ins")
}

model AccessEvent {
  id              String            @id @default(cuid())
  organisationId  String
  outletId        String
  memberProfileId String?
  credentialId    String?
  deviceId        String?
  accessPointId   String?
  eventType       String            // ACCESS_REQUESTED, ACCESS_GRANTED, ACCESS_DENIED, DOOR_UNLOCKED, DOOR_LOCKED, CHECK_IN, CHECK_OUT, CREDENTIAL_USED, DEVICE_ERROR
  decision        String?           // ALLOWED, DENIED
  reason          String?           // AccessDecisionReason
  occurredAt      DateTime          @default(now())
  providerEventId String?
  metadata        Json?
  createdAt       DateTime          @default(now())

  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile?    @relation(fields: [memberProfileId], references: [id], onDelete: SetNull)
  credential      AccessCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  device          AccessDevice?     @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  accessPoint     AccessPoint?      @relation(fields: [accessPointId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([eventType])
  @@index([occurredAt])
  @@map("access_events")
}

model GuestAccessPass {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String
  passCode       String        @unique
  guestName      String?
  guestEmail     String?
  validFrom      DateTime
  validUntil     DateTime
  status         String        @default("ACTIVE") // ACTIVE, USED, EXPIRED, REVOKED
  createdById    String
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdBy      User          @relation("GuestPassesCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([outletId])
  @@index([status])
  @@map("guest_access_passes")
}

// ============================================================================
// DAY 8: BOOKING & SCHEDULING FOUNDATION
// ============================================================================

model ClassType {
  id                       String          @id @default(cuid())
  organisationId           String
  name                     String
  description              String?
  category                 String          @default("OTHER") // YOGA, STRENGTH, HIIT, SPIN, PILATES, BOXING, CROSSFIT, ZUMBA, OTHER
  durationMinutes          Int             @default(60)
  defaultCapacity          Int             @default(20)
  bookingRequired          Boolean         @default(true)
  membershipEntitlementKey String?         @default("GROUP_CLASSES")
  status                   String          @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  organisation             Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  templates                ClassTemplate[]
  sessions                 ClassSession[]

  @@index([organisationId])
  @@index([category])
  @@index([status])
  @@map("class_types")
}

model ClassTemplate {
  id                     String              @id @default(cuid())
  organisationId         String
  classTypeId            String
  name                   String
  description            String?
  durationMinutes        Int                 @default(60)
  defaultCapacity        Int                 @default(20)
  defaultBookingPolicyId String?
  status                 String              @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organisation           Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  classType              ClassType           @relation(fields: [classTypeId], references: [id], onDelete: Cascade)
  bookingPolicy          BookingPolicy?      @relation(fields: [defaultBookingPolicyId], references: [id], onDelete: SetNull)
  sessions               ClassSession[]
  recurringSchedules     RecurringSchedule[]

  @@index([organisationId])
  @@index([classTypeId])
  @@map("class_templates")
}

model BookingPolicy {
  id                             String          @id @default(cuid())
  organisationId                 String
  name                           String
  maxAdvanceBookingHours         Int             @default(168) // 7 days in advance
  minimumCancellationNoticeHours Int             @default(2)   // 2 hours before session
  maxActiveBookings              Int             @default(5)   // Max concurrent future bookings
  allowWaitlist                  Boolean         @default(true)
  maxWaitlistSize                Int             @default(10)
  allowLateBooking               Boolean         @default(true)
  allowCancellation              Boolean         @default(true)
  allowLateCancellation          Boolean         @default(true)
  lateCancellationWindowHours    Int             @default(2)
  recordLateCancellation         Boolean         @default(true)
  maxBookingsPerDay              Int?
  isDefault                      Boolean         @default(false)
  createdAt                      DateTime        @default(now())
  updatedAt                      DateTime        @updatedAt

  organisation                   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  classTemplates                 ClassTemplate[]
  classSessions                  ClassSession[]

  @@index([organisationId])
  @@map("booking_policies")
}

model Resource {
  id                 String              @id @default(cuid())
  organisationId     String
  outletId           String
  name               String
  type               String              @default("STUDIO") // STUDIO, ROOM, COURT, AREA, EQUIPMENT_BAY
  capacity           Int                 @default(30)
  status             String              @default("ACTIVE") // ACTIVE, MAINTENANCE, DISABLED
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organisation       Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet              @relation(fields: [outletId], references: [id], onDelete: Cascade)
  classSessions      ClassSession[]
  recurringSchedules RecurringSchedule[]

  @@index([organisationId])
  @@index([outletId])
  @@index([status])
  @@map("resources")
}

model ClassSession {
  id                   String             @id @default(cuid())
  organisationId       String
  outletId             String
  classTemplateId      String?
  classTypeId          String
  trainerId            String?
  resourceId           String?
  bookingPolicyId      String?
  recurringScheduleId  String?
  name                 String?
  startsAt             DateTime
  endsAt               DateTime
  capacity             Int                @default(20)
  status               String             @default("SCHEDULED") // SCHEDULED, OPEN, FULL, IN_PROGRESS, COMPLETED, CANCELLED
  isOverride           Boolean            @default(false)
  originalStartsAt     DateTime?
  bookingOpensAt       DateTime?
  bookingClosesAt      DateTime?
  cancellationClosesAt DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  substituteTrainerId  String?
  trainerCheckedInAt   DateTime?
  trainerCheckedOutAt  DateTime?
  trainerAttendanceStatus String? // PENDING, PRESENT, SUBSTITUTED, ABSENT
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  organisation         Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet               Outlet             @relation(fields: [outletId], references: [id], onDelete: Cascade)
  classTemplate        ClassTemplate?     @relation(fields: [classTemplateId], references: [id], onDelete: SetNull)
  classType            ClassType          @relation(fields: [classTypeId], references: [id], onDelete: Restrict)
  trainer              User?              @relation("TrainerSessions", fields: [trainerId], references: [id], onDelete: SetNull)
  substituteTrainer    User?              @relation("SubstituteTrainerSessions", fields: [substituteTrainerId], references: [id], onDelete: SetNull)
  resource             Resource?          @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  bookingPolicy        BookingPolicy?     @relation(fields: [bookingPolicyId], references: [id], onDelete: SetNull)
  recurringSchedule    RecurringSchedule? @relation(fields: [recurringScheduleId], references: [id], onDelete: SetNull)
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]
  attendanceRecords    AttendanceRecord[]
  bookingConfirmations BookingConfirmationState[]

  @@index([organisationId])
  @@index([outletId])
  @@index([classTypeId])
  @@index([trainerId])
  @@index([substituteTrainerId])
  @@index([resourceId])
  @@index([recurringScheduleId])
  @@index([startsAt])
  @@index([status])
  @@map("class_sessions")
}

model Booking {
  id                 String         @id @default(cuid())
  organisationId     String
  outletId           String
  memberProfileId    String
  classSessionId     String
  status             String         @default("CONFIRMED") // CONFIRMED, WAITLISTED, CANCELLED, CHECKED_IN, COMPLETED, NO_SHOW
  bookedAt           DateTime       @default(now())
  cancelledAt        DateTime?
  cancellationReason String?
  isLateCancellation Boolean        @default(false)
  checkedInAt        DateTime?
  noShowAt           DateTime?
  waitlistPosition   Int?
  idempotencyKey     String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organisation       Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  classSession       ClassSession   @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  waitlistEntry      WaitlistEntry?
  attendanceRecord   AttendanceRecord?

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([classSessionId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("bookings")
}

model WaitlistEntry {
  id              String        @id @default(cuid())
  organisationId  String
  outletId        String
  classSessionId  String
  memberProfileId String
  bookingId       String?       @unique
  position        Int
  status          String        @default("PENDING") // PENDING, OFFERED, PROMOTED, CANCELLED, EXPIRED
  offerExpiresAt  DateTime?
  joinedAt        DateTime      @default(now())
  promotedAt      DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  classSession    ClassSession  @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([outletId])
  @@index([classSessionId])
  @@index([memberProfileId])
  @@index([status])
  @@index([position])
  @@map("waitlist_entries")
}

model TrainerAvailability {
  id             String       @id @default(cuid())
  organisationId String
  trainerId      String
  dayOfWeek      Int?         // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime      String?      // "09:00"
  endTime        String?      // "17:00"
  specificDate   DateTime?    // Specific date override
  endDate        DateTime?    // End date for multi-day leave/holiday
  isAvailable    Boolean      @default(true) // true = available, false = blockout
  timezone       String       @default("Australia/Perth")
  notes          String?
  reason         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainer        User         @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([trainerId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@map("trainer_availabilities")
}

model RecurringSchedule {
  id              String         @id @default(cuid())
  organisationId  String
  outletId        String
  classTemplateId String
  trainerId       String?
  resourceId      String?
  frequency       String         @default("WEEKLY") // DAILY, WEEKLY, BIWEEKLY, MONTHLY
  dayOfWeek       Int            // 0 = Sunday, 1 = Monday, ..., 6 = Saturday (primary)
  daysOfWeek      Int[]          @default([])       // Selected weekdays [1, 3, 5]
  startTime       String         // "18:00"
  durationMinutes Int            @default(60)
  customCapacity  Int?
  startDate       DateTime
  endDate         DateTime?
  timezone        String         @default("Australia/Perth")
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organisation    Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  classTemplate   ClassTemplate  @relation(fields: [classTemplateId], references: [id], onDelete: Cascade)
  trainer         User?          @relation("TrainerRecurringSchedules", fields: [trainerId], references: [id], onDelete: SetNull)
  resource        Resource?      @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  sessions        ClassSession[]

  @@index([organisationId])
  @@index([outletId])
  @@index([classTemplateId])
  @@index([trainerId])
  @@index([dayOfWeek])
  @@index([isActive])
  @@map("recurring_schedules")
}

model AttendanceRecord {
  id              String        @id @default(cuid())
  organisationId  String
  outletId        String
  classSessionId  String?
  memberProfileId String
  bookingId       String?       @unique
  status          String        @default("CHECKED_IN") // CHECKED_IN, LATE, LEFT_EARLY, COMPLETED, NO_SHOW, CANCELLED, EXCUSED, WALK_IN
  checkInMethod   String        @default("STAFF")      // STAFF, MEMBER_SELF_SERVICE, QR, ACCESS_EVENT, KIOSK, MANUAL, SYSTEM
  checkOutMethod  String?
  checkedInAt     DateTime?
  checkedOutAt    DateTime?
  lateMinutes     Int?
  durationMinutes Int?
  markedByUserId  String?
  isOverride      Boolean       @default(false)
  overrideReason  String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  classSession    ClassSession? @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  booking         Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  markedByUser    User?         @relation("AttendanceMarkedByUser", fields: [markedByUserId], references: [id], onDelete: SetNull)
  ptSession       PersonalTrainingSession? @relation("PtSessionAttendance")

  @@unique([classSessionId, memberProfileId])
  @@index([organisationId])
  @@index([outletId])
  @@index([classSessionId])
  @@index([memberProfileId])
  @@index([bookingId])
  @@index([status])
  @@index([checkedInAt])
  @@map("attendance_records")
}

// ==========================================
// DAY 11: STAFF & TRAINER MANAGEMENT DOMAIN
// ==========================================

model StaffProfile {
  id                  String                  @id @default(cuid())
  userId              String                  @unique
  organisationId      String
  employeeReference   String?
  displayName         String
  jobTitle            String
  employmentStatus    String                  @default("ACTIVE") // INVITED, ACTIVE, ON_LEAVE, SUSPENDED, INACTIVE, TERMINATED
  phone               String?
  workEmail           String?
  bio                 String?
  profilePhotoUrl     String?
  hireDate            DateTime?               @default(now())
  terminationDate     DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  deletedAt           DateTime?

  // Relations
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation        Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outletAssignments   StaffOutletAssignment[]
  trainerProfile      TrainerProfile?
  workoutTemplatesCreated WorkoutTemplate[]

  @@unique([organisationId, employeeReference])
  @@index([organisationId])
  @@index([userId])
  @@index([employmentStatus])
  @@map("staff_profiles")
}

model StaffOutletAssignment {
  id              String       @id @default(cuid())
  staffProfileId  String
  outletId        String
  roleScope       String?      // e.g. "OUTLET_MANAGER", "TRAINER", "RECEPTION"
  status          String       @default("ACTIVE") // ACTIVE, INACTIVE, TEMPORARY, SCHEDULED
  isPrimary       Boolean      @default(false)
  startDate       DateTime     @default(now())
  endDate         DateTime?
  assignedById    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  staffProfile    StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  outlet          Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  assignedBy      User?        @relation("StaffOutletAssignmentsCreated", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([staffProfileId, outletId])
  @@index([staffProfileId])
  @@index([outletId])
  @@index([status])
  @@map("staff_outlet_assignments")
}

model TrainerProfile {
  id                       String                    @id @default(cuid())
  staffProfileId           String                    @unique
  organisationId           String
  professionalName         String
  bio                      String?
  profilePhotoUrl          String?
  specialties              String[]                  @default([])
  yearsExperience          Int                       @default(0)
  languages                String[]                  @default(["English"])
  coachingStyle            String?
  trainingApproach         String?
  consultationAvailability String?
  status                   String                    @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  staffProfile             StaffProfile              @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  organisation             Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certifications           TrainerCertification[]
  clientAssignments        TrainerClientAssignment[]
  trainingPrograms         TrainingProgram[]
  trainerNotes             TrainerNote[]
  personalTrainingSessions PersonalTrainingSession[]
  workouts                 Workout[]
  trainingPlans            TrainingPlan[]
  assessments              Assessment[]

  @@index([organisationId])
  @@index([staffProfileId])
  @@index([status])
  @@map("trainer_profiles")
}

model TrainerCertification {
  id                   String         @id @default(cuid())
  trainerProfileId     String
  certificationName    String
  issuingOrganisation String
  certificationNumber  String?
  issueDate            DateTime
  expiryDate           DateTime?
  documentReference    String?
  documentUrl          String?
  documentMetadata     Json?
  status               String         @default("ACTIVE") // ACTIVE, EXPIRING_SOON, EXPIRED, REVOKED
  verifiedAt           DateTime?
  verifiedById         String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  trainerProfile       TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  verifiedBy           User?          @relation("CertificationsVerified", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([trainerProfileId])
  @@index([status])
  @@index([expiryDate])
  @@map("trainer_certifications")
}

model TrainerClientAssignment {
  id                   String         @id @default(cuid())
  organisationId       String
  outletId             String?
  trainerProfileId     String
  memberProfileId      String
  assignmentType       String         @default("PRIMARY") // PRIMARY, SECONDARY, TEMPORARY, GROUP_COACH
  status               String         @default("ACTIVE")  // ACTIVE, INACTIVE, TERMINATED, REASSIGNED
  startDate            DateTime       @default(now())
  endDate              DateTime?
  assignedById         String?
  notes                String?
  previousAssignmentId String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  organisation         Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet               Outlet?        @relation(fields: [outletId], references: [id], onDelete: SetNull)
  trainerProfile       TrainerProfile @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  memberProfile        MemberProfile  @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  assignedBy           User?          @relation("TrainerClientAssignmentsCreated", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([outletId])
  @@index([trainerProfileId])
  @@index([memberProfileId])
  @@index([status])
  @@index([assignmentType])
  @@map("trainer_client_assignments")
}

// ==========================================
// DAY 12: PERSONAL TRAINING & COACHING DOMAIN
// ==========================================

model TrainingProgram {
  id                  String                    @id @default(cuid())
  organisationId      String
  outletId            String?
  memberProfileId     String
  trainerProfileId    String
  name                String
  description         String?
  status              String                    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED, CANCELLED
  startDate           DateTime
  endDate             DateTime?
  activatedAt         DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason String?
  metadata            Json?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organisation        Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet              Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile       MemberProfile             @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile      TrainerProfile            @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  goals               TrainingGoal[]
  sessions            PersonalTrainingSession[]
  notes               TrainerNote[]
  workouts            Workout[]
  trainingPlans       TrainingPlan[]

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([status])
  @@map("training_programs")
}

model TrainingGoal {
  id                String                    @id @default(cuid())
  organisationId    String
  memberProfileId   String
  trainingProgramId String?
  createdById       String?
  title             String
  description       String?
  category          String                    // WEIGHT_LOSS, MUSCLE_GAIN, STRENGTH, ENDURANCE, MOBILITY, GENERAL_FITNESS, SPORTS_PERFORMANCE, BODY_COMPOSITION, REHABILITATION, HABIT_FORMATION
  baselineValue     Float?
  targetValue       Float?
  currentValue      Float?
  unit              String?                   // kg, reps, %, min, km, etc.
  targetDate        DateTime?
  priority          Int                       @default(1)
  status            String                    @default("ACTIVE") // ACTIVE, ON_TRACK, AT_RISK, COMPLETED, PAUSED, CANCELLED
  completedAt       DateTime?
  cancelledAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  organisation      Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile     MemberProfile             @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainingProgram   TrainingProgram?          @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  createdBy         User?                     @relation("GoalsCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  history           GoalHistory[]
  notes             TrainerNote[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([trainingProgramId])
  @@index([status])
  @@index([category])
  @@map("training_goals")
}

model GoalHistory {
  id             String       @id @default(cuid())
  goalId         String
  actorId        String?
  previousStatus String?
  newStatus      String
  previousValue  Float?
  newValue       Float?
  changeReason   String?
  notes          String?
  createdAt      DateTime     @default(now())

  goal           TrainingGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  actor          User?        @relation("GoalHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([goalId])
  @@index([createdAt])
  @@map("goal_histories")
}

model TrainerNote {
  id                        String                   @id @default(cuid())
  organisationId            String
  outletId                  String?
  memberProfileId           String
  trainerProfileId          String
  trainingProgramId         String?
  trainingGoalId            String?
  personalTrainingSessionId String?
  noteType                  String                   @default("GENERAL") // GENERAL, SESSION, PROGRAM, GOAL, FOLLOW_UP, COACHING
  content                   String
  visibility                String                   @default("PRIVATE") // PRIVATE, STAFF, MEMBER_VISIBLE
  isPinned                  Boolean                  @default(false)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  organisation              Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                    Outlet?                  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile             MemberProfile            @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile            TrainerProfile           @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  trainingProgram           TrainingProgram?         @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  trainingGoal              TrainingGoal?            @relation(fields: [trainingGoalId], references: [id], onDelete: SetNull)
  personalTrainingSession   PersonalTrainingSession? @relation(fields: [personalTrainingSessionId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([visibility])
  @@index([noteType])
  @@map("trainer_notes")
}

model PersonalTrainingSession {
  id                  String            @id @default(cuid())
  organisationId      String
  outletId            String
  memberProfileId     String
  trainerProfileId    String
  trainingProgramId   String?
  scheduledStart      DateTime
  scheduledEnd        DateTime
  actualStart         DateTime?
  actualEnd           DateTime?
  status              String            @default("SCHEDULED") // SCHEDULED, CONFIRMED, IN_PROGRESS, COMPLETED, CANCELLED, NO_SHOW
  sessionType         String            @default("ONE_ON_ONE") // ONE_ON_ONE, CONSULTATION, ASSESSMENT
  location            String?
  cancellationReason  String?
  cancelledById       String?
  cancelledAt         DateTime?
  attendanceRecordId  String?           @unique
  bookingReference    String?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet              Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile     @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile      TrainerProfile    @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  trainingProgram     TrainingProgram?  @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  attendanceRecord    AttendanceRecord? @relation("PtSessionAttendance", fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  cancelledBy         User?             @relation("PtSessionsCancelledByUser", fields: [cancelledById], references: [id], onDelete: SetNull)
  notesList           TrainerNote[]
  workouts            Workout[]

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([status])
  @@index([scheduledStart])
  @@index([scheduledEnd])
  @@map("personal_training_sessions")
}

// ==========================================
// DAY 13: EXERCISE LIBRARY & WORKOUT PROGRAMMING DOMAIN
// ==========================================

model Exercise {
  id                    String                    @id @default(cuid())
  organisationId        String?
  createdByUserId       String?
  ownershipType         String                    @default("SYSTEM") // SYSTEM, ORGANISATION
  name                  String
  slug                  String
  description           String?
  instructions          String?
  coachingCues          Json?                     // string[]
  setupInstructions     String?
  executionInstructions String?
  safetyNotes           String?
  difficulty            String                    @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  exerciseType          String                    @default("STRENGTH") // STRENGTH, CARDIO, MOBILITY, FLEXIBILITY, BALANCE, PLYOMETRIC, REHABILITATION, RECOVERY, FUNCTIONAL, CORE, OTHER
  movementPattern       String                    @default("OTHER") // SQUAT, HINGE, LUNGE, PUSH, PULL, CARRY, ROTATION, ANTI_ROTATION, GAIT, JUMP, ISOMETRIC, OTHER
  primaryMuscleGroup    String                    @default("FULL_BODY") // CHEST, BACK, SHOULDERS, BICEPS, TRICEPS, FOREARMS, QUADRICEPS, HAMSTRINGS, GLUTES, CALVES, CORE, FULL_BODY, OTHER
  secondaryMuscleGroups Json?                     // string[]
  equipment             String                    @default("BODYWEIGHT") // BODYWEIGHT, BARBELL, DUMBBELL, KETTLEBELL, CABLE, MACHINE, BAND, BENCH, RACK, MEDICINE_BALL, TRX, ROWER, BIKE, TREADMILL, OTHER, NONE
  bodyPosition          String?                   // STANDING, SEATED, SUPINE, PRONE, KNEELING, OTHER
  laterality            String?                   // BILATERAL, UNILATERAL, ALTERNATING
  defaultUnit           String                    @default("KG") // KG, LB, REPS, SECONDS, METERS
  status                String                    @default("ACTIVE") // ACTIVE, ARCHIVED
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  archivedAt            DateTime?

  organisation          Organisation?             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdByUser         User?                     @relation("ExercisesCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  media                 ExerciseMedia[]
  templateExercises     WorkoutTemplateExercise[]
  workoutExercises      WorkoutExercise[]
  progressionRules      WorkoutProgressionRule[]
  personalRecords       PersonalRecord[]

  @@index([organisationId])
  @@index([ownershipType])
  @@index([status])
  @@index([exerciseType])
  @@index([difficulty])
  @@index([movementPattern])
  @@index([primaryMuscleGroup])
  @@index([equipment])
  @@index([slug])
  @@map("exercises")
}

model ExerciseMedia {
  id                    String                    @id @default(cuid())
  exerciseId            String
  mediaType             String                    @default("IMAGE") // IMAGE, VIDEO, THUMBNAIL
  storageKey            String
  mimeType              String
  fileSize              Int                       @default(0)
  durationSeconds       Int?
  sortOrder             Int                       @default(0)
  isPrimary             Boolean                   @default(false)
  createdAt             DateTime                  @default(now())

  exercise              Exercise                  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([exerciseId])
  @@index([mediaType])
  @@map("exercise_media")
}

model WorkoutTemplate {
  id                        String                       @id @default(cuid())
  organisationId            String
  createdByStaffId          String?
  name                      String
  description               String?
  goal                      String?
  difficulty                String                       @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  estimatedDurationMinutes  Int?
  status                    String                       @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  version                   Int                          @default(1)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  archivedAt                DateTime?

  organisation              Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdByStaff            StaffProfile?                @relation(fields: [createdByStaffId], references: [id], onDelete: SetNull)
  parentTemplateId          String?
  parentTemplate            WorkoutTemplate?             @relation("TemplateVersions", fields: [parentTemplateId], references: [id], onDelete: SetNull)
  childVersions             WorkoutTemplate[]            @relation("TemplateVersions")
  exercises                 WorkoutTemplateExercise[]
  workouts                  Workout[]
  progressionRules          WorkoutProgressionRule[]

  @@index([organisationId])
  @@index([parentTemplateId])
  @@index([status])
  @@map("workout_templates")
}

model WorkoutTemplateExercise {
  id                     String               @id @default(cuid())
  workoutTemplateId      String
  exerciseId             String
  orderIndex             Int                  @default(0)
  sectionName            String?              // WARMUP, MAIN, ACCESSORY, COOLDOWN
  notes                  String?
  prescriptionType       String               @default("REPETITIONS") // REPETITIONS, TIME, DISTANCE, CALORIES, LOAD, AMRAP, EMOM, INTERVAL, ISOMETRIC, CUSTOM
  targetSets             Int?
  targetReps             Int?
  targetDurationSeconds  Int?
  targetDistance         Float?
  targetLoad             Float?
  targetRPE              Float?
  restSeconds            Int?                 @default(90)
  createdAt              DateTime             @default(now())

  workoutTemplate        WorkoutTemplate      @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise               Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([workoutTemplateId])
  @@index([exerciseId])
  @@map("workout_template_exercises")
}

model Workout {
  id                         String                    @id @default(cuid())
  organisationId             String
  outletId                   String?
  memberProfileId            String
  trainerProfileId           String?
  trainingProgramId          String?
  workoutTemplateId          String?
  personalTrainingSessionId  String?
  trainingPlanId             String?
  title                      String
  description                String?
  scheduledDate              DateTime?
  scheduledStartTime         DateTime?
  estimatedDurationMinutes   Int?
  status                     String                    @default("ASSIGNED") // DRAFT, ASSIGNED, SCHEDULED, IN_PROGRESS, COMPLETED, SKIPPED, CANCELLED, EXPIRED
  assignedAt                 DateTime                  @default(now())
  startedAt                  DateTime?
  completedAt                DateTime?
  cancelledAt                DateTime?
  cancellationReason         String?
  notes                      String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  organisation               Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                     Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile              MemberProfile             @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile             TrainerProfile?           @relation(fields: [trainerProfileId], references: [id], onDelete: SetNull)
  trainingProgram            TrainingProgram?          @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  trainingPlan               TrainingPlan?             @relation(fields: [trainingPlanId], references: [id], onDelete: SetNull)
  workoutTemplate            WorkoutTemplate?          @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  personalTrainingSession    PersonalTrainingSession?   @relation(fields: [personalTrainingSessionId], references: [id], onDelete: SetNull)
  trainingPlanDays           TrainingPlanDay[]
  exerciseGroups             WorkoutExerciseGroup[]
  exercises                  WorkoutExercise[]
  personalRecords            PersonalRecord[]
  meals                      Meal[]

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([trainingProgramId])
  @@index([trainingPlanId])
  @@index([scheduledDate])
  @@index([status])
  @@map("workouts")
}

model WorkoutExercise {
  id                       String               @id @default(cuid())
  workoutId                String
  workoutExerciseGroupId   String?
  exerciseId               String
  orderIndex               Int                  @default(0)
  sectionName              String?              // WARM_UP, ACTIVATION, MAIN, ACCESSORY, CONDITIONING, COOL_DOWN, RECOVERY, OTHER
  exerciseNameSnapshot     String
  instructionSnapshot      String?
  coachingCueSnapshot      String?
  prescriptionType         String               @default("REPETITIONS") // REPETITIONS, TIME, DISTANCE, CALORIES, LOAD, AMRAP, EMOM, INTERVAL, ISOMETRIC, CUSTOM
  targetSets               Int?
  targetReps               Int?
  targetDurationSeconds    Int?
  targetDistance           Float?
  targetLoad               Float?
  targetRPE                Float?
  restSeconds              Int?                 @default(90)
  notes                    String?
  status                   String               @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  workout                  Workout              @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutExerciseGroup     WorkoutExerciseGroup? @relation(fields: [workoutExerciseGroupId], references: [id], onDelete: SetNull)
  exercise                 Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets                     WorkoutSet[]

  @@index([workoutId])
  @@index([workoutExerciseGroupId])
  @@index([exerciseId])
  @@index([status])
  @@map("workout_exercises")
}

model WorkoutSet {
  id                       String               @id @default(cuid())
  workoutExerciseId        String
  setNumber                Int
  targetReps               Int?
  actualReps               Int?
  targetLoad               Float?
  actualLoad               Float?
  loadUnit                 String               @default("KG") // KG, LB
  targetDurationSeconds    Int?
  actualDurationSeconds    Int?
  targetDistance           Float?
  actualDistance           Float?
  distanceUnit             String?              // KM, MI, M, FT
  targetRPE                Float?
  actualRPE                Float?
  completed                Boolean              @default(false)
  idempotencyKey           String?              @unique
  notes                    String?
  completedAt              DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  workoutExercise          WorkoutExercise      @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  corrections              WorkoutSetCorrection[]
  personalRecords          PersonalRecord[]

  @@index([workoutExerciseId])
  @@index([completed])
  @@map("workout_sets")
}

model WorkoutSetCorrection {
  id                       String               @id @default(cuid())
  workoutSetId             String
  correctedByUserId        String
  previousReps             Int?
  newReps                  Int?
  previousLoad             Float?
  newLoad                  Float?
  previousRPE              Float?
  newRPE                   Float?
  reason                   String
  createdAt                DateTime             @default(now())

  workoutSet               WorkoutSet           @relation(fields: [workoutSetId], references: [id], onDelete: Cascade)
  correctedByUser          User                 @relation("SetCorrectionsByUser", fields: [correctedByUserId], references: [id], onDelete: Restrict)

  @@index([workoutSetId])
  @@index([correctedByUserId])
  @@map("workout_set_corrections")
}

// ==========================================
// DAY 14: ADVANCED WORKOUT PROGRAMMING & TRAINING PLANS
// ==========================================

model TrainingPlan {
  id                  String                    @id @default(cuid())
  organisationId      String
  trainingProgramId   String?
  memberProfileId     String
  trainerProfileId    String
  name                String
  description         String?
  objective           String?
  durationWeeks       Int                       @default(4)
  startDate           DateTime
  endDate             DateTime?
  status              String                    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED, CANCELLED, ARCHIVED
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  organisation        Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingProgram     TrainingProgram?          @relation(fields: [trainingProgramId], references: [id], onDelete: SetNull)
  memberProfile       MemberProfile             @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile      TrainerProfile            @relation(fields: [trainerProfileId], references: [id], onDelete: Cascade)
  weeks               TrainingPlanWeek[]
  workouts            Workout[]
  progressionRules    WorkoutProgressionRule[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([trainingProgramId])
  @@index([status])
  @@index([startDate])
  @@map("training_plans")
}

model TrainingPlanWeek {
  id                  String                    @id @default(cuid())
  trainingPlanId      String
  weekNumber          Int
  name                String?
  focus               String?
  startDate           DateTime?
  endDate             DateTime?
  status              String                    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, SKIPPED
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  trainingPlan        TrainingPlan              @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  days                TrainingPlanDay[]

  @@unique([trainingPlanId, weekNumber])
  @@index([trainingPlanId])
  @@map("training_plan_weeks")
}

model TrainingPlanDay {
  id                  String                    @id @default(cuid())
  trainingPlanWeekId  String
  dayNumber           Int
  date                DateTime?
  name                String?
  focus               String?
  workoutId           String?
  restDay             Boolean                   @default(false)
  notes               String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  trainingPlanWeek    TrainingPlanWeek          @relation(fields: [trainingPlanWeekId], references: [id], onDelete: Cascade)
  workout             Workout?                  @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@unique([trainingPlanWeekId, dayNumber])
  @@index([trainingPlanWeekId])
  @@index([workoutId])
  @@index([date])
  @@map("training_plan_days")
}

model WorkoutExerciseGroup {
  id                    String            @id @default(cuid())
  workoutId             String
  name                  String            // e.g. "Superset A", "Conditioning Circuit"
  type                  String            @default("SUPERSET") // SINGLE, SUPERSET, TRISET, GIANT_SET, CIRCUIT, EMOM, AMRAP, INTERVAL
  section               String            @default("MAIN") // WARM_UP, ACTIVATION, MAIN, ACCESSORY, CONDITIONING, COOL_DOWN, RECOVERY, OTHER
  orderIndex            Int               @default(0)
  rounds                Int               @default(1)
  restBetweenExercises  Int?              // in seconds
  restBetweenRounds     Int?              // in seconds
  durationSeconds       Int?              // for EMOM / AMRAP / timed intervals
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  workout               Workout           @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercises             WorkoutExercise[]

  @@index([workoutId])
  @@index([type])
  @@index([section])
  @@map("workout_exercise_groups")
}

model WorkoutProgressionRule {
  id                  String            @id @default(cuid())
  organisationId      String
  trainingPlanId      String?
  workoutTemplateId   String?
  exerciseId          String?
  progressionType     String            // LINEAR_LOAD, REP_PROGRESSION, SET_PROGRESSION, TIME_PROGRESSION, DISTANCE_PROGRESSION, RPE_PROGRESSION, CUSTOM
  configuration       Json              // Structured configuration
  active              Boolean           @default(true)
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  organisation        Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  trainingPlan        TrainingPlan?     @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  workoutTemplate     WorkoutTemplate?  @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise            Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([trainingPlanId])
  @@index([workoutTemplateId])
  @@index([exerciseId])
  @@map("workout_progression_rules")
}

// ==========================================
// DAY 15: PROGRESS TRACKING, ASSESSMENTS & TRAINING ANALYTICS
// ==========================================

model BodyMeasurement {
  id                    String        @id @default(cuid())
  organisationId        String
  outletId              String?
  memberProfileId       String
  measurementType       String        // WEIGHT, HEIGHT, BODY_FAT_PERCENT, BMI, CHEST, WAIST, HIPS, NECK, LEFT_ARM, RIGHT_ARM, LEFT_THIGH, RIGHT_THIGH, LEFT_CALF, RIGHT_CALF, SHOULDERS, CUSTOM
  value                 Float
  unit                  String        // kg, lb, cm, in, %, etc.
  recordedAt            DateTime      @default(now())
  source                String        @default("MEMBER") // MEMBER, TRAINER, STAFF, SYSTEM, ASSESSMENT, WORKOUT, IMPORT
  recordedByUserId      String?
  notes                 String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organisation          Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile         MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  recordedByUser        User?         @relation("MeasurementsRecordedByUser", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([measurementType])
  @@index([recordedAt])
  @@index([memberProfileId, measurementType, recordedAt])
  @@map("body_measurements")
}

model AssessmentTemplate {
  id                    String        @id @default(cuid())
  organisationId        String?       // NULL for SYSTEM templates
  name                  String
  slug                  String
  category              String        // STRENGTH, ENDURANCE, CARDIO, MOBILITY, FLEXIBILITY, BALANCE, BODY_COMPOSITION, FUNCTIONAL, CUSTOM
  description           String?
  instructions          String?
  metricType            String        @default("REPETITIONS") // REPETITIONS, WEIGHT, TIME, DISTANCE, SCORE, RATING, PERCENTAGE, BOOLEAN, TEXT, CUSTOM
  defaultUnit           String?
  scoringProtocol       String?
  targetGender          String?
  targetAgeRange        String?
  active                Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organisation          Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  assessments           Assessment[]

  @@index([organisationId])
  @@index([category])
  @@index([slug])
  @@map("assessment_templates")
}

model Assessment {
  id                    String              @id @default(cuid())
  organisationId        String
  outletId              String?
  memberProfileId       String
  trainerProfileId      String?
  templateId            String?
  title                 String
  category              String              // STRENGTH, ENDURANCE, CARDIO, MOBILITY, etc.
  status                String              @default("COMPLETED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  scheduledDate         DateTime?
  completedAt           DateTime?
  notes                 String?
  summaryScore          Float?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile         MemberProfile       @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  trainerProfile        TrainerProfile?     @relation(fields: [trainerProfileId], references: [id], onDelete: SetNull)
  template              AssessmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  results               AssessmentResult[]

  @@index([organisationId])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([trainerProfileId])
  @@index([status])
  @@index([category])
  @@index([completedAt])
  @@map("assessments")
}

model AssessmentResult {
  id                    String        @id @default(cuid())
  assessmentId          String
  metricName            String
  value                 Float?
  unit                  String?
  textValue             String?
  rating                Int?
  score                 Float?
  repetitions           Int?
  weight                Float?
  distance              Float?
  durationSeconds       Int?
  percentage            Float?
  booleanResult         Boolean?
  notes                 String?
  metadata              Json?
  createdAt             DateTime      @default(now())

  assessment            Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([metricName])
  @@map("assessment_results")
}

model PersonalRecord {
  id                    String          @id @default(cuid())
  organisationId        String
  memberProfileId       String
  exerciseId            String
  recordType            String          // MAX_WEIGHT, MAX_REPS, MAX_VOLUME, FASTEST_TIME, LONGEST_DISTANCE, LONGEST_DURATION, BEST_SCORE, CUSTOM
  value                 Float
  unit                  String
  workoutId             String?
  workoutExerciseId     String?
  workoutSetId          String?
  achievedAt            DateTime        @default(now())
  previousValue         Float?
  improvementPercentage Float?
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  organisation          Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile         MemberProfile   @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  exercise              Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  workout               Workout?        @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  workoutSet            WorkoutSet?     @relation(fields: [workoutSetId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([exerciseId])
  @@index([recordType])
  @@index([achievedAt])
  @@index([memberProfileId, exerciseId, recordType])
  @@map("personal_records")
}

model ProgressSnapshot {
  id                    String          @id @default(cuid())
  organisationId        String
  memberProfileId       String
  snapshotDate          DateTime        @default(now())
  period                String          // 7D, 30D, 90D, ALL
  adherenceRate         Float
  workoutsCompleted     Int
  tonnageLifted         Float
  prsAchieved           Int
  measurementsSummary   Json?
  assessmentsSummary    Json?
  goalProgressSummary   Json?
  metadata              Json?
  createdAt             DateTime        @default(now())

  organisation          Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile         MemberProfile   @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([snapshotDate])
  @@map("progress_snapshots")
}

// ==========================================
// DAY 16: NUTRITION, MEAL PLANNING & FOOD TRACKING
// ==========================================

model NutritionProfile {
  id                  String              @id @default(cuid())
  organisationId      String
  memberProfileId     String              @unique
  dietaryPattern      String              @default("OMNIVORE") // OMNIVORE, VEGETARIAN, VEGAN, PESCATARIAN, KETO, LOW_CARB, HIGH_PROTEIN, CUSTOM
  activityLevel       String?             // SEDENTARY, LIGHTLY_ACTIVE, MODERATELY_ACTIVE, VERY_ACTIVE, EXTREMELY_ACTIVE
  nutritionGoal       String?             // WEIGHT_LOSS, MAINTENANCE, MUSCLE_GAIN, PERFORMANCE, HEALTH
  preferredUnits      String              @default("METRIC") // METRIC, IMPERIAL
  timezone            String              @default("Australia/Perth")
  allergies           String[]            @default([])
  intolerances        String[]            @default([])
  foodsAvoided        String[]            @default([])
  dietaryRestrictions String?
  notes               String?
  status              String              @default("ACTIVE")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile       @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("nutrition_profiles")
}

model DietaryPreference {
  id              String        @id @default(cuid())
  organisationId  String
  memberProfileId String
  preferenceType  String        // LIKE, DISLIKE, AVOID, ALLERGY, INTOLERANCE, RELIGIOUS_RESTRICTION
  itemName        String
  severity        String?       // MILD, MODERATE, SEVERE, ANAPHYLACTIC
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([preferenceType])
  @@map("dietary_preferences")
}

model NutritionTarget {
  id                 String        @id @default(cuid())
  organisationId     String
  memberProfileId    String
  dailyCalories      Float
  proteinGrams       Float
  carbohydrateGrams  Float
  fatGrams           Float
  fiberGrams         Float?
  waterMl            Float?
  minCalories        Float?
  maxCalories        Float?
  minProtein         Float?
  effectiveFrom      DateTime      @default(now())
  effectiveTo        DateTime?
  source             String        @default("MEMBER_DEFINED") // MEMBER_DEFINED, TRAINER_ASSIGNED, DEFAULT
  assignedById       String?
  status             String        @default("ACTIVE") // ACTIVE, HISTORICAL, ARCHIVED
  notes              String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  assignedBy         User?         @relation("NutritionTargetsAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([status])
  @@index([effectiveFrom])
  @@map("nutrition_targets")
}

model Food {
  id                 String             @id @default(cuid())
  organisationId     String?            // NULL for SYSTEM foods
  ownership          String             @default("ORGANISATION") // SYSTEM, ORGANISATION
  name               String
  brand              String?
  category           String             @default("PROTEIN") // PROTEIN, GRAINS, VEGETABLES, FRUITS, DAIRY, FATS_OILS, SNACKS, BEVERAGES, SUPPLEMENTS, OTHER
  servingSize        Float
  servingUnit        String             // g, ml, oz, piece, cup, tbsp, tsp, scoop
  calories           Float
  protein            Float
  carbohydrates      Float
  fat                Float
  fiber              Float              @default(0)
  sugar              Float              @default(0)
  sodium             Float              @default(0) // mg
  calcium            Float?             // mg
  iron               Float?             // mg
  potassium          Float?             // mg
  vitaminD           Float?             // mcg
  vitaminB12         Float?             // mcg
  micronutrients     Json?
  barcode            String?
  verified           Boolean            @default(false)
  status             String             @default("ACTIVE")
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation       Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("FoodsCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  mealFoodItems      MealFoodItem[]
  mealPlanFoodItems  MealPlanFoodItem[]
  foodLogs           FoodLog[]

  @@index([organisationId])
  @@index([ownership])
  @@index([name])
  @@index([category])
  @@index([barcode])
  @@map("foods")
}

model Meal {
  id                 String             @id @default(cuid())
  organisationId     String
  memberProfileId    String?
  name               String
  mealType           String             // BREAKFAST, LUNCH, DINNER, SNACK, PRE_WORKOUT, POST_WORKOUT, OTHER
  scheduledTime      String?
  notes              String?
  status             String             @default("ACTIVE")
  workoutId          String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation       Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile?     @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  workout            Workout?           @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  items              MealFoodItem[]
  foodLogs           FoodLog[]

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([mealType])
  @@map("meals")
}

model MealFoodItem {
  id                 String             @id @default(cuid())
  mealId             String
  foodId             String
  quantity           Float
  unit               String
  sortOrder          Int                @default(0)
  calories           Float
  protein            Float
  carbohydrates      Float
  fat                Float
  fiber              Float              @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  meal               Meal               @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food               Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealId])
  @@index([foodId])
  @@map("meal_food_items")
}

model MealPlan {
  id                  String                     @id @default(cuid())
  organisationId      String
  name                String
  description         String?
  dietaryPattern      String?                    // OMNIVORE, VEGAN, etc.
  targetDailyCalories Float?
  targetProteinGrams  Float?
  targetCarbGrams     Float?
  targetFatGrams      Float?
  durationDays        Int                        @default(7)
  version             Int                        @default(1)
  parentId            String?
  status              String                     @default("ACTIVE") // DRAFT, ACTIVE, ARCHIVED
  createdById         String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organisation        Organisation               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy           User?                      @relation("MealPlansCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  parent              MealPlan?                  @relation("MealPlanVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions            MealPlan[]                 @relation("MealPlanVersions")
  days                MealPlanDay[]
  assignments         MemberMealPlanAssignment[]

  @@index([organisationId])
  @@index([status])
  @@index([version])
  @@map("meal_plans")
}

model MealPlanDay {
  id                  String             @id @default(cuid())
  mealPlanId          String
  dayNumber           Int
  dayName             String?
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mealPlan            MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  meals               MealPlanMeal[]

  @@index([mealPlanId])
  @@index([dayNumber])
  @@map("meal_plan_days")
}

model MealPlanMeal {
  id                  String             @id @default(cuid())
  mealPlanDayId       String
  name                String
  mealType            String             // BREAKFAST, LUNCH, etc.
  notes               String?
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mealPlanDay         MealPlanDay        @relation(fields: [mealPlanDayId], references: [id], onDelete: Cascade)
  items               MealPlanFoodItem[]

  @@index([mealPlanDayId])
  @@map("meal_plan_meals")
}

model MealPlanFoodItem {
  id                  String             @id @default(cuid())
  mealPlanMealId      String
  foodId              String
  quantity            Float
  unit                String
  calories            Float
  protein             Float
  carbohydrates       Float
  fat                 Float
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  mealPlanMeal        MealPlanMeal       @relation(fields: [mealPlanMealId], references: [id], onDelete: Cascade)
  food                Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@index([mealPlanMealId])
  @@index([foodId])
  @@map("meal_plan_food_items")
}

model MemberMealPlanAssignment {
  id                  String             @id @default(cuid())
  organisationId      String
  memberProfileId     String
  mealPlanId          String
  assignedById        String?
  assignedAt          DateTime           @default(now())
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  status              String             @default("ACTIVE") // ASSIGNED, ACTIVE, PAUSED, COMPLETED, CANCELLED
  notes               String?
  planSnapshot        Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organisation        Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile      @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  mealPlan            MealPlan           @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  assignedBy          User?              @relation("MealPlansAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([memberProfileId])
  @@index([mealPlanId])
  @@index([status])
  @@map("member_meal_plan_assignments")
}

model FoodLog {
  id                  String             @id @default(cuid())
  organisationId      String
  memberProfileId     String
  mealId              String?
  foodId              String
  mealType            String             // BREAKFAST, LUNCH, DINNER, SNACK, PRE_WORKOUT, POST_WORKOUT, OTHER
  quantity            Float
  unit                String
  consumedAt          DateTime           @default(now())
  foodNameAtLog       String
  brandAtLog          String?
  calories            Float
  protein             Float
  carbohydrates       Float
  fat                 Float
  fiber               Float              @default(0)
  sugar               Float              @default(0)
  sodium              Float              @default(0)
  idempotencyKey      String?
  notes               String?
  loggedById          String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organisation        Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile      @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  meal                Meal?              @relation(fields: [mealId], references: [id], onDelete: SetNull)
  food                Food               @relation(fields: [foodId], references: [id], onDelete: Cascade)
  loggedBy            User               @relation("FoodLogsLoggedByUser", fields: [loggedById], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([memberProfileId, consumedAt])
  @@index([memberProfileId, mealType, consumedAt])
  @@index([idempotencyKey])
  @@map("food_logs")
}

model WaterLog {
  id                  String             @id @default(cuid())
  organisationId      String
  memberProfileId     String
  amountMl            Float
  loggedAt            DateTime           @default(now())
  createdAt           DateTime           @default(now())

  organisation        Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile      @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([memberProfileId, loggedAt])
  @@map("water_logs")
}

model NutritionSummary {
  id                  String             @id @default(cuid())
  organisationId      String
  memberProfileId     String
  date                DateTime
  totalCalories       Float
  totalProtein        Float
  totalCarbohydrates  Float
  totalFat            Float
  totalFiber          Float
  totalWaterMl        Float
  targetCalories      Float?
  targetProtein       Float?
  targetCarbohydrates Float?
  targetFat           Float?
  targetWaterMl       Float?
  calorieAdherencePct Float              @default(0)
  proteinAdherencePct Float              @default(0)
  carbAdherencePct    Float              @default(0)
  fatAdherencePct     Float              @default(0)
  waterAdherencePct   Float              @default(0)
  mealCount           Int                @default(0)
  foodItemCount       Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organisation        Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile       MemberProfile      @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)

  @@unique([memberProfileId, date])
  @@index([organisationId])
  @@index([memberProfileId, date])
  @@map("nutrition_summaries")
}

// ==========================================
// DAY 17: COMMUNICATION & NOTIFICATIONS FOUNDATION
// ==========================================

model Notification {
  id              String                 @id @default(cuid())
  organisationId  String
  outletId        String?
  recipientUserId String
  memberId        String?
  type            String                 // e.g. BOOKING_CONFIRMED, WAITLIST_PROMOTED, CLASS_REMINDER, etc.
  category        String                 // SYSTEM, SECURITY, MEMBERSHIP, PAYMENT, BOOKING, ATTENDANCE, TRAINING, NUTRITION, PROGRESS, COMMUNICATION, MARKETING, ADMIN
  title           String
  body            String                 @db.Text
  data            Json?                  // metadata, actionType, actionId, deepLink
  priority        String                 @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String                 @default("PENDING") // PENDING, SENT, DELIVERED, READ, FAILED, EXPIRED, CANCELLED
  createdAt       DateTime               @default(now())
  readAt          DateTime?
  expiresAt       DateTime?

  organisation    Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?                @relation(fields: [outletId], references: [id], onDelete: SetNull)
  recipientUser   User                   @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile?         @relation(fields: [memberId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  @@index([recipientUserId, createdAt])
  @@index([recipientUserId, readAt])
  @@index([organisationId, createdAt])
  @@index([category])
  @@index([status])
  @@map("notifications")
}

model NotificationDelivery {
  id                String       @id @default(cuid())
  notificationId    String
  channel           String       // IN_APP, PUSH, EMAIL, SMS
  provider          String       // IN_APP_LOCAL, CONSOLE_PUSH, CONSOLE_EMAIL, CONSOLE_SMS, etc.
  providerMessageId String?
  status            String       @default("PENDING") // PENDING, SENT, DELIVERED, FAILED, CANCELLED
  attemptCount      Int          @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  failureCode       String?
  failureReason     String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  notification      Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([status])
  @@index([channel])
  @@map("notification_deliveries")
}

model NotificationPreference {
  id              String       @id @default(cuid())
  userId          String
  organisationId  String
  category        String       // BOOKING, TRAINING, PAYMENT, MARKETING, etc.
  channel         String       // IN_APP, PUSH, EMAIL, SMS
  enabled         Boolean      @default(true)
  quietHoursStart String?      // e.g. "22:00"
  quietHoursEnd   String?      // e.g. "07:00"
  timezone        String?      @default("UTC")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)
  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId, category, channel])
  @@index([userId, organisationId])
  @@map("notification_preferences")
}

model NotificationTemplate {
  id             String        @id @default(cuid())
  organisationId String?       // null = SYSTEM template
  key            String        // BOOKING_CONFIRMED, CLASS_REMINDER_30M, WORKOUT_ASSIGNED, etc.
  name           String
  channel        String        // IN_APP, PUSH, EMAIL, SMS
  category       String
  subject        String?
  body           String        @db.Text
  variables      Json          // string array of variable placeholders
  version        Int           @default(1)
  status         String        @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  isSystem       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, key, channel, version])
  @@index([key, channel, status])
  @@index([organisationId])
  @@map("notification_templates")
}

model PushDevice {
  id             String       @id @default(cuid())
  userId         String
  organisationId String
  deviceId       String
  platform       String       // IOS, ANDROID, WEB
  pushToken      String
  appVersion     String?
  deviceName     String?
  status         String       @default("ACTIVE") // ACTIVE, REVOKED, INVALID
  lastSeenAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user           User         @relation("UserPushDevices", fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, status])
  @@index([organisationId])
  @@map("push_devices")
}

model NotificationSchedule {
  id               String        @id @default(cuid())
  organisationId   String
  outletId         String?
  recipientUserId  String
  notificationType String
  scheduledFor     DateTime
  timezone         String        @default("UTC")
  status           String        @default("SCHEDULED") // SCHEDULED, PROCESSING, SENT, FAILED, CANCELLED
  payload          Json
  idempotencyKey   String?       @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organisation     Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet           Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  recipientUser    User          @relation("UserScheduledNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([scheduledFor, status])
  @@index([recipientUserId])
  @@index([organisationId])
  @@map("notification_schedules")
}

// ==========================================
// DAY 18: MEMBER ENGAGEMENT, HABITS, CHALLENGES & RETENTION FOUNDATION
// ==========================================

model EngagementEvent {
  id             String        @id @default(cuid())
  organisationId String
  outletId       String?
  memberId       String
  eventType      String        // APP_OPENED, GYM_CHECKED_IN, CLASS_ATTENDED, WORKOUT_COMPLETED, etc.
  sourceType     String        // ATTENDANCE, WORKOUT, BOOKING, GOAL, NUTRITION, CHALLENGE, HABIT, REWARD, SYSTEM
  sourceId       String?
  metadata       Json?
  idempotencyKey String?       @unique
  occurredAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile  MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, occurredAt])
  @@index([memberId, occurredAt])
  @@index([eventType])
  @@index([sourceType, sourceId])
  @@map("engagement_events")
}

model MemberEngagementProfile {
  id                      String        @id @default(cuid())
  organisationId          String
  memberId                String        @unique
  engagementLevel         String        @default("NEW") // NEW, ACTIVE, ENGAGED, HIGHLY_ENGAGED, AT_RISK, DORMANT
  engagementScore         Float         @default(0)
  currentStreak           Int           @default(0)
  longestStreak           Int           @default(0)
  lastActivityAt          DateTime?
  lastGymVisitAt          DateTime?
  lastWorkoutAt           DateTime?
  lastNutritionActivityAt DateTime?
  totalVisits             Int           @default(0)
  totalWorkouts           Int           @default(0)
  totalCompletedClasses   Int           @default(0)
  totalCompletedGoals     Int           @default(0)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  organisation            Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile           MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, engagementLevel])
  @@index([organisationId, engagementScore])
  @@map("member_engagement_profiles")
}

model EngagementScoreSnapshot {
  id                 String        @id @default(cuid())
  organisationId     String
  memberId           String
  score              Float
  engagementLevel    String
  calculationVersion Int           @default(1)
  scoreBreakdown     Json?
  calculatedAt       DateTime      @default(now())

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, calculatedAt])
  @@index([organisationId, calculatedAt])
  @@map("engagement_score_snapshots")
}

model Habit {
  id             String        @id @default(cuid())
  organisationId String?       // null = system default habit
  name           String
  description    String?
  category       String        @default("CUSTOM") // ATTENDANCE, WORKOUT, NUTRITION, HYDRATION, MOBILITY, RECOVERY, SLEEP, GOAL, CUSTOM
  frequency      String        @default("DAILY")  // DAILY, WEEKLY
  target         Float         @default(1)
  unit           String?       // e.g. "L", "min", "times"
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberHabits   MemberHabit[]

  @@index([organisationId, category])
  @@index([active])
  @@map("habits")
}

model MemberHabit {
  id             String            @id @default(cuid())
  organisationId String
  memberId       String
  habitId        String
  startDate      DateTime
  endDate        DateTime?
  target         Float
  frequency      String            @default("DAILY")
  status         String            @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, CANCELLED
  currentStreak  Int               @default(0)
  longestStreak  Int               @default(0)
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organisation   Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  habit          Habit             @relation(fields: [habitId], references: [id], onDelete: Cascade)
  createdBy      User?             @relation("HabitsCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  completions    HabitCompletion[]

  @@index([memberId, status])
  @@index([organisationId])
  @@map("member_habits")
}

model HabitCompletion {
  id            String      @id @default(cuid())
  memberHabitId String
  date          DateTime    // UTC midnight for local day
  value         Float
  unit          String?
  completed     Boolean     @default(true)
  source        String      @default("MANUAL") // MANUAL, ATTENDANCE, WORKOUT, NUTRITION, WATER
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  memberHabit   MemberHabit @relation(fields: [memberHabitId], references: [id], onDelete: Cascade)

  @@unique([memberHabitId, date])
  @@index([memberHabitId, date])
  @@map("habit_completions")
}

model Challenge {
  id                 String                 @id @default(cuid())
  organisationId     String
  outletId           String?
  name               String
  description        String?
  challengeType      String                 // ATTENDANCE, WORKOUT_COMPLETION, CLASS_ATTENDANCE, HABIT_COMPLETION, GOAL_PROGRESS, CUSTOM
  metric             String                 // e.g. WORKOUT_COUNT, ATTENDANCE_COUNT, CLASS_COUNT, HABIT_STREAK
  target             Float
  periodDays         Int?
  startDate          DateTime
  endDate            DateTime
  status             String                 @default("DRAFT") // DRAFT, PUBLISHED, ACTIVE, COMPLETED, CANCELLED, ARCHIVED
  participationLimit Int?
  leaderboardEnabled Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  organisation       Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet?                @relation(fields: [outletId], references: [id], onDelete: SetNull)
  participants       ChallengeParticipant[]

  @@index([organisationId, status])
  @@index([startDate, endDate])
  @@map("challenges")
}

model ChallengeParticipant {
  id              String        @id @default(cuid())
  challengeId     String
  memberId        String
  organisationId  String
  joinedAt        DateTime      @default(now())
  completedAt     DateTime?
  currentProgress Float         @default(0)
  target          Float
  status          String        @default("JOINED") // JOINED, IN_PROGRESS, COMPLETED, WITHDRAWN, EXPIRED
  rank            Int?
  updatedAt       DateTime      @updatedAt

  challenge       Challenge     @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([challengeId, memberId])
  @@index([challengeId, status])
  @@index([memberId])
  @@map("challenge_participants")
}

model Badge {
  id             String        @id @default(cuid())
  organisationId String?       // null = system badge
  code           String        @unique // FIRST_WORKOUT, 10_WORKOUTS, 7_DAY_STREAK, etc.
  name           String
  description    String
  category       String        // WORKOUT, ATTENDANCE, STREAK, GOAL, CHALLENGE, COMMUNITY
  iconUrl        String?
  criteria       Json          // deterministic qualification rules
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberBadges   MemberBadge[]

  @@index([category])
  @@map("badges")
}

model MemberBadge {
  id             String        @id @default(cuid())
  organisationId String
  memberId       String
  badgeId        String
  awardedAt      DateTime      @default(now())
  metadata       Json?

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge          Badge         @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([memberId, badgeId])
  @@index([memberId])
  @@index([organisationId])
  @@map("member_badges")
}

model Reward {
  id             String         @id @default(cuid())
  organisationId String
  outletId       String?
  name           String
  description    String
  category       String         @default("PERK") // ACHIEVEMENT_BADGE, FREE_CLASS, GUEST_PASS, MERCHANDISE_DISCOUNT, RECOGNITION, PERK
  pointsRequired Int            @default(0)
  inventory      Int?           // null = unlimited
  active         Boolean        @default(true)
  validDays      Int?           // validity duration in days
