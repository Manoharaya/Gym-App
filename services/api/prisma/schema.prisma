  id              String            @id @default(cuid())
  conversationId  String
  organisationId  String
  outletId        String?
  leadId          String
  reason          String            // CUSTOMER_REQUESTED_HUMAN, COMPLEX_PRICING, CUSTOM_REQUEST, COMPLAINT, UNAVAILABLE_INFORMATION, HIGH_VALUE_PROSPECT, MEDICAL_CONCERN, POLICY_EXCEPTION, FAILED_AI_INTERACTION, NEGOTIATION_REQUEST, OTHER
  priority        String            @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String            @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, RESOLVED, REJECTED
  assignedStaffId String?
  notes           String?           @db.Text
  customerSummary String?           @db.Text
  resolvedAt      DateTime?
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  conversation    SalesConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  organisation    Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?           @relation(fields: [outletId], references: [id], onDelete: SetNull)
  lead            Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedStaff   StaffProfile?     @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([organisationId, outletId, status])
  @@index([conversationId])
  @@index([leadId])
  @@map("sales_handoffs")
}

// ============================================================================
// Day 37: Sales Pipeline & Opportunity Management
// ============================================================================

model SalesPipeline {
  id             String               @id @default(cuid())
  organisationId String
  outletId       String?
  name           String               @default("Default Sales Pipeline")
  description    String?              @db.Text
  isDefault      Boolean              @default(false)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation   Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?              @relation(fields: [outletId], references: [id], onDelete: SetNull)
  stages         SalesPipelineStage[]
  opportunities  SalesOpportunity[]

  @@unique([organisationId, name])
  @@index([organisationId, isDefault])
  @@index([organisationId, outletId])
  @@map("sales_pipelines")
}

model SalesPipelineStage {
  id                 String               @id @default(cuid())
  pipelineId         String
  type               String               // NEW, CONTACTED, QUALIFIED, TRIAL, TOUR_BOOKED, OFFERED, CONVERTED, LOST
  name               String
  description        String?              @db.Text
  position           Int                  @default(0)
  color              String?
  isActive           Boolean              @default(true)
  isTerminal         Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  pipeline           SalesPipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities      SalesOpportunity[]
  stageHistoriesFrom SalesStageHistory[]  @relation("StageHistoryFrom")
  stageHistoriesTo   SalesStageHistory[]  @relation("StageHistoryTo")

  @@unique([pipelineId, type])
  @@index([pipelineId, position])
  @@map("sales_pipeline_stages")
}

model SalesOpportunity {
  id                    String              @id @default(cuid())
  organisationId        String
  outletId              String?
  leadId                String
  pipelineId            String
  stageId               String
  stageEnteredAt        DateTime            @default(now())
  currentStage          String              @default("NEW") // NEW, CONTACTED, QUALIFIED, TRIAL, TOUR_BOOKED, OFFERED, CONVERTED, LOST
  title                 String              @default("Sales Opportunity")
  ownerStaffId          String?
  source                String?             // WEBSITE, AI_RECEPTIONIST, PHONE, WHATSAPP, SMS, WALK_IN, etc.
  sourceReferenceId     String?             // e.g. salesConversationId
  serviceInterest       Json?               // string[]
  membershipInterest    String?
  interestedPlanId      String?
  estimatedValue        Decimal?            @db.Decimal(10, 2)
  currency              String              @default("AUD")
  probability           Float               @default(0.1) // 0.0 - 1.0
  expectedCloseDate     DateTime?
  lastActivityAt        DateTime            @default(now())
  nextActionAt          DateTime?
  nextActionType        String?             // BOOK_TRIAL, BOOK_TOUR, CALL_PROSPECT, FOLLOW_UP, etc.
  nextActionNotes       String?             @db.Text
  convertedAt           DateTime?
  conversionReferenceId String?             // e.g. memberMembershipId or paymentId
  lostAt                DateTime?
  lossReason            String?             // PRICE, NO_RESPONSE, NOT_INTERESTED, CHOSE_COMPETITOR, LOCATION, SCHEDULE, SERVICE_MISMATCH, TIMING, FAILED_TRIAL, FAILED_TOUR, COULD_NOT_CONTACT, DUPLICATE, INVALID_LEAD, OTHER
  lossNotes             String?             @db.Text
  staleSince            DateTime?
  isStale               Boolean             @default(false)
  version               Int                 @default(1) // Optimistic locking
  metadata              Json?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  organisation          Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?             @relation(fields: [outletId], references: [id], onDelete: SetNull)
  lead                  Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  pipeline              SalesPipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage                 SalesPipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerStaff            StaffProfile?       @relation(fields: [ownerStaffId], references: [id], onDelete: SetNull)
  stageHistories        SalesStageHistory[]
  activities            SalesActivity[]
  tasks                 SalesTask[]
  followUpEnrollments   FollowUpEnrollment[]

  @@index([organisationId, currentStage])
  @@index([organisationId, outletId])
  @@index([organisationId, ownerStaffId])
  @@index([organisationId, leadId])
  @@index([organisationId, lastActivityAt])
  @@index([organisationId, nextActionAt])
  @@index([organisationId, isStale])
  @@index([organisationId, createdAt])
  @@map("sales_opportunities")
}

model SalesStageHistory {
  id              String              @id @default(cuid())
  opportunityId   String
  fromStageId     String?
  toStageId       String
  fromStageType   String?
  toStageType     String
  reason          String?             @db.Text
  actorType       String              // SYSTEM, AI_RECOMMENDATION, STAFF, CUSTOMER, BOOKING_SYSTEM, MEMBERSHIP_SYSTEM, WORKFLOW
  actorId         String?
  source          String?             // AI_SALES_AGENT, RECEPTIONIST_BOOKING, STAFF_PORTAL, WEBHOOK, etc.
  durationSeconds Int?
  metadata        Json?
  createdAt       DateTime            @default(now())

  opportunity     SalesOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage       SalesPipelineStage? @relation("StageHistoryFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage         SalesPipelineStage  @relation("StageHistoryTo", fields: [toStageId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@map("sales_stage_histories")
}

model SalesActivity {
  id                String           @id @default(cuid())
  organisationId    String
  outletId          String?
  opportunityId     String
  leadId            String
  type              String           // AI_CONVERSATION, STAFF_CONVERSATION, PHONE_CALL, MISSED_CALL, EMAIL, SMS, WHATSAPP, WEB_CHAT, TRIAL_BOOKED, TRIAL_COMPLETED, TOUR_BOOKED, TOUR_COMPLETED, OFFER_CREATED, OFFER_PRESENTED, FOLLOW_UP, HANDOFF, NOTE, STAGE_CHANGE, OTHER
  actorType         String           // STAFF, AI, CUSTOMER, SYSTEM
  actorId           String?
  channel           String?          // WEB, WHATSAPP, SMS, EMAIL, VOICE, IN_PERSON
  title             String
  summary           String?          @db.Text
  sourceReferenceId String?
  occurredAt        DateTime         @default(now())
  metadata          Json?
  createdAt         DateTime         @default(now())

  organisation      Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet            Outlet?          @relation(fields: [outletId], references: [id], onDelete: SetNull)
  opportunity       SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  lead              Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([opportunityId, occurredAt])
  @@index([organisationId, leadId])
  @@index([organisationId, type])
  @@map("sales_activities")
}

model SalesTask {
  id              String           @id @default(cuid())
  organisationId  String
  outletId        String?
  opportunityId   String
  leadId          String
  assignedStaffId String?
  type            String           // CALL_PROSPECT, FOLLOW_UP_TRIAL, FOLLOW_UP_TOUR, REVIEW_OFFER, CONTACT_HIGH_INTENT, RESOLVE_INQUIRY, GENERAL
  priority        String           @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String           @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, DISMISSED, EXPIRED
  title           String
  description     String?          @db.Text
  dueAt           DateTime
  completedAt     DateTime?
  completedById   String?
  completionNotes String?          @db.Text
  createdBy       String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?          @relation(fields: [outletId], references: [id], onDelete: SetNull)
  opportunity     SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  lead            Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedStaff   StaffProfile?    @relation(fields: [assignedStaffId], references: [id], onDelete: SetNull)

  @@index([organisationId, status, dueAt])
  @@index([opportunityId])
  @@index([assignedStaffId, status])
  @@map("sales_tasks")
}

// ============================================================================
// DAY 39 — AUTOMATED FOLLOW-UP & MULTI-CHANNEL SALES SEQUENCES
// ============================================================================

model FollowUpSequence {
  id              String                    @id @default(cuid())
  organisationId  String
  outletId        String?
  name            String
  description     String?                   @db.Text
  sequenceType    String                    // LEAD_FOLLOW_UP, MISSED_CALL, WEB_ENQUIRY, TRIAL_FOLLOW_UP, TOUR_FOLLOW_UP, QUALIFIED_LEAD, OFFER_FOLLOW_UP, NO_RESPONSE, CALLBACK, REENGAGEMENT, STAFF_HANDOFF, POST_CONVERSATION, CUSTOM
  status          String                    @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  triggerType     String                    @default("EVENT_DRIVEN") // EVENT_DRIVEN, MANUAL, STAGE_CHANGE, INQUIRY
  activeVersionId String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  organisation    Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  versions        FollowUpSequenceVersion[]
  enrollments     FollowUpEnrollment[]

  @@index([organisationId, status])
  @@index([organisationId, sequenceType])
  @@map("follow_up_sequences")
}

model FollowUpSequenceVersion {
  id            String               @id @default(cuid())
  sequenceId    String
  version       Int                  @default(1)
  status        String               @default("DRAFT") // DRAFT, ACTIVE, ARCHIVED
  configuration Json                 // { cooldownHours, maxFollowUpsPerWeek, quietHoursStart, quietHoursEnd, timezone, stopConditions: [] }
  createdBy     String?
  createdAt     DateTime             @default(now())
  publishedAt   DateTime?

  sequence      FollowUpSequence     @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  steps         FollowUpStep[]
  enrollments   FollowUpEnrollment[]

  @@unique([sequenceId, version])
  @@index([sequenceId, status])
  @@map("follow_up_sequence_versions")
}

model FollowUpStep {
  id                 String                  @id @default(cuid())
  sequenceVersionId  String
  stepOrder          Int                     // 1, 2, 3, ...
  name               String
  delayMinutes       Int                     @default(0) // 0 (Day 0), 1440 (Day 1), 4320 (Day 3), 10080 (Day 7), custom
  channel            String                  // EMAIL, SMS, WHATSAPP, PUSH, IN_APP, VOICE
  messageMode        String                  @default("STATIC_TEMPLATE") // STATIC_TEMPLATE, PERSONALIZED_TEMPLATE, AI_ASSISTED
  templateId         String?
  promptId           String?
  requiresApproval   Boolean                 @default(false)
  stopOnReply        Boolean                 @default(true)
  stopOnBooking      Boolean                 @default(true)
  stopOnConversion   Boolean                 @default(true)
  stopOnStaffHandoff Boolean                 @default(true)
  status             String                  @default("ACTIVE") // ACTIVE, INACTIVE
  configuration      Json?                   // fallbackChannel, allowedVariables, aiContextRules
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  sequenceVersion    FollowUpSequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  executions         FollowUpStepExecution[]

  @@unique([sequenceVersionId, stepOrder])
  @@index([sequenceVersionId, status])
  @@map("follow_up_steps")
}

model FollowUpEnrollment {
  id                String                  @id @default(cuid())
  organisationId    String
  outletId          String?
  leadId            String?
  opportunityId     String?
  memberId          String?
  sequenceId        String
  sequenceVersionId String
  status            String                  @default("ACTIVE") // PENDING, ACTIVE, PAUSED, COMPLETED, STOPPED, CANCELLED, EXPIRED, FAILED
  currentStep       Int                     @default(1)
  enrolledAt        DateTime                @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  pausedAt          DateTime?
  nextExecutionAt   DateTime?
  lastExecutionAt   DateTime?
  stopReason        String?                 // CUSTOMER_REPLIED, CUSTOMER_BOOKED, CUSTOMER_CONVERTED, STAFF_HANDOFF, OPTED_OUT, CONSENT_WITHDRAWN, SEQUENCE_COMPLETED, MANUAL_STOP
  createdBy         String?
  metadata          Json?

  organisation      Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet            Outlet?                 @relation(fields: [outletId], references: [id], onDelete: SetNull)
  lead              Lead?                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity       SalesOpportunity?       @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sequence          FollowUpSequence        @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  sequenceVersion   FollowUpSequenceVersion @relation(fields: [sequenceVersionId], references: [id], onDelete: Cascade)
  executions        FollowUpStepExecution[]
  responses         FollowUpResponse[]
  outcomes          FollowUpOutcome[]
  assignments       FollowUpAssignment[]

  @@index([organisationId, status, nextExecutionAt])
  @@index([leadId, status])
  @@index([opportunityId, status])
  @@index([sequenceId, status])
  @@map("follow_up_enrollments")
}

model FollowUpStepExecution {
  id              String             @id @default(cuid())
  enrollmentId    String
  stepId          String
  organisationId  String
  status          String             @default("PENDING") // PENDING, PENDING_APPROVAL, APPROVED, EXECUTING, SUCCESS, TRANSIENT_FAILURE, PERMANENT_FAILURE, SUPPRESSED, CANCELLED, SKIPPED
  executionKey    String             @unique // Deterministic: ${organisationId}_${enrollmentId}_${stepId}
  channel         String
  communicationId String?
  scheduledAt     DateTime
  executedAt      DateTime?
  attemptCount    Int                @default(0)
  maxAttempts     Int                @default(3)
  errorDetails    String?            @db.Text
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  enrollment      FollowUpEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step            FollowUpStep       @relation(fields: [stepId], references: [id], onDelete: Cascade)
  communication   Communication?     @relation(fields: [communicationId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, status])
  @@index([organisationId, status, scheduledAt])
  @@map("follow_up_step_executions")
}

model FollowUpSuppression {
  id             String       @id @default(cuid())
  organisationId String
  leadId         String?
  memberId       String?
  channel        String?
  reason         String       // OPTOUT, CONSENT_WITHDRAWN, INVALID_CHANNEL, CUSTOMER_REQUESTED, STAFF_SUPPRESSED, COOLDOWN, FREQUENCY_EXCEEDED, QUIET_HOURS, CONVERTED, BOOKED, HANDOFF
  activeUntil    DateTime?
  metadata       Json?
  createdAt      DateTime     @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organisationId, leadId])
  @@index([organisationId, reason])
  @@map("follow_up_suppressions")
}

model FollowUpResponse {
  id             String             @id @default(cuid())
  organisationId String
  enrollmentId   String
  leadId         String?
  responseType   String             // REPLIED, NO_RESPONSE, BOOKED, CANCELLED, TOUR_BOOKED, TRIAL_BOOKED, CONVERTED, REQUESTED_HUMAN, OPTED_OUT, INVALID, OTHER
  channel        String
  rawContent     String?            @db.Text
  referenceId    String?
  source         String             @default("INBOUND_COMMUNICATION") // INBOUND_COMMUNICATION, WEBHOOK, STAFF_LOGGED, SYSTEM_EVENT
  classification String?
  confidence     Float?
  receivedAt     DateTime           @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  enrollment     FollowUpEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([enrollmentId, receivedAt])
  @@index([organisationId, responseType])
  @@map("follow_up_responses")
}

model FollowUpOutcome {
  id             String             @id @default(cuid())
  organisationId String
  enrollmentId   String
  outcomeType    String             // NO_RESPONSE, ENGAGED, BOOKING_CREATED, TRIAL_BOOKED, TOUR_BOOKED, HUMAN_HANDOFF, QUALIFIED, CONVERTED, LOST, OPTED_OUT, SEQUENCE_COMPLETED, STOPPED
  attribution    String             // conversion_following_follow_up, booking_following_follow_up
  metadata       Json?
  recordedAt     DateTime           @default(now())

  organisation   Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  enrollment     FollowUpEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organisationId, outcomeType])
  @@index([enrollmentId])
  @@map("follow_up_outcomes")
}

model FollowUpAssignment {
  id              String             @id @default(cuid())
  organisationId  String
  enrollmentId    String
  stepExecutionId String?
  staffId         String?
  assignmentType  String             @default("LEAD_OWNER") // UNASSIGNED, LEAD_OWNER, OPPORTUNITY_OWNER, TRAINER, RECEPTION, OUTLET_MANAGER, SALES_ROLE, SPECIFIC_STAFF
  status          String             @default("PENDING") // PENDING, ACCEPTED, COMPLETED
  assignedAt      DateTime           @default(now())
  completedAt     DateTime?

  organisation    Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  enrollment      FollowUpEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([staffId, status])
  @@map("follow_up_assignments")
}

// ==========================================
// DAY 41: FINANCIAL INTELLIGENCE FOUNDATION
// ==========================================

model FinancialTransactionReference {
  id                    String        @id @default(cuid())
  organisationId        String
  outletId              String?
  memberProfileId       String?
  invoiceId             String?
  paymentTransactionId  String?       @unique
  paymentRefundId       String?       @unique
  memberMembershipId    String?
  transactionType       String        // MEMBERSHIP_PAYMENT, MEMBERSHIP_RENEWAL, MEMBERSHIP_UPGRADE, MEMBERSHIP_DOWNGRADE, PERSONAL_TRAINING, CLASS, RETAIL, OTHER_SERVICE, MANUAL_PAYMENT, REFUND, ADJUSTMENT, OTHER
  status                String        // PENDING, PROCESSING, REQUIRES_ACTION, AUTHORIZED, SUCCEEDED, FAILED, CANCELLED, REFUNDED, PARTIALLY_REFUNDED, DISPUTED
  amountMinor           Int
  currency              String        @default("AUD")
  transactionDate       DateTime
  source                String        // PAYMENT_TRANSACTION, PAYMENT_REFUND, INVOICE, MANUAL
  sourceReferenceId     String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organisation          Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([organisationId, transactionDate])
  @@index([organisationId, currency])
  @@index([outletId, transactionDate])
  @@index([status])
  @@index([transactionType])
  @@map("financial_transaction_references")
}

model FinancialDailySummary {
  id                     String        @id @default(cuid())
  organisationId         String
  outletId               String?
  date                   DateTime
  currency               String        @default("AUD")
  grossRevenueMinor      Int           @default(0)
  refundAmountMinor      Int           @default(0)
  netRevenueMinor        Int           @default(0)
  paymentCount           Int           @default(0)
  successfulPaymentCount Int           @default(0)
  failedPaymentCount     Int           @default(0)
  invoiceCount           Int           @default(0)
  paidInvoiceCount       Int           @default(0)
  overdueInvoiceCount    Int           @default(0)
  outstandingAmountMinor Int           @default(0)
  membershipRevenueMinor Int           @default(0)
  dataVersion            Int           @default(1)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  organisation           Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                 Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([organisationId, outletId, date, currency])
  @@index([organisationId, date])
  @@index([outletId, date])
  @@map("financial_daily_summaries")
}

// ==========================================
// DAY 42: RECURRING BILLING & COLLECTIONS
// ==========================================

model BillingSchedule {
  id                 String          @id @default(cuid())
  organisationId     String
  memberProfileId    String
  memberMembershipId String
  membershipPlanId   String
  originOutletId     String?
  currency           String          @default("AUD")
  billingInterval    String          @default("MONTHLY") // WEEKLY, BIWEEKLY, MONTHLY, QUARTERLY, SEMI_ANNUALLY, ANNUALLY, CUSTOM
  intervalCount      Int             @default(1)
  amountMinor        Int
  nextBillingDate    DateTime
  status             String          @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, PAST_DUE, SUSPENDED, CANCELLED, COMPLETED, EXPIRED
  paymentMethodId    String?
  startDate          DateTime        @default(now())
  endDate            DateTime?
  timezone           String          @default("UTC")
  failureCount       Int             @default(0)
  metadata           Json?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organisation       Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile   @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  memberMembership   MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)
  membershipPlan     MembershipPlan  @relation(fields: [membershipPlanId], references: [id], onDelete: Restrict)
  originOutlet       Outlet?         @relation(fields: [originOutletId], references: [id], onDelete: SetNull)
  paymentMethod      PaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  billingCycles      BillingCycle[]

  @@index([organisationId, status])
  @@index([nextBillingDate, status])
  @@index([memberProfileId])
  @@index([memberMembershipId])
  @@map("billing_schedules")
}

model BillingCycle {
  id                   String          @id @default(cuid())
  organisationId       String
  billingScheduleId    String
  memberProfileId      String
  memberMembershipId   String
  cycleNumber          Int
  periodStart          DateTime
  periodEnd            DateTime
  scheduledBillingDate DateTime
  invoiceId            String?
  status               String          @default("SCHEDULED") // SCHEDULED, PROCESSING, INVOICED, PAYMENT_PENDING, PAID, FAILED, PAST_DUE, CANCELLED, SKIPPED
  amountMinor          Int
  currency             String          @default("AUD")
  processedAt          DateTime?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organisation         Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  billingSchedule      BillingSchedule @relation(fields: [billingScheduleId], references: [id], onDelete: Cascade)
  memberProfile        MemberProfile   @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  memberMembership     MemberMembership @relation(fields: [memberMembershipId], references: [id], onDelete: Cascade)
  invoice              Invoice?        @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentAttempts      PaymentAttempt[]
  dunningCase          DunningCase?

  @@unique([billingScheduleId, cycleNumber])
  @@index([organisationId, status])
  @@index([scheduledBillingDate])
  @@index([memberProfileId])
  @@index([invoiceId])
  @@map("billing_cycles")
}

model PaymentAttempt {
  id                   String          @id @default(cuid())
  organisationId       String
  billingCycleId       String
  invoiceId            String
  paymentTransactionId String?
  attemptNumber        Int
  attemptedAt          DateTime        @default(now())
  status               String          @default("PENDING") // PENDING, PROCESSING, SUCCEEDED, FAILED, CANCELLED, REQUIRES_ACTION
  failureCode          String?
  failureCategory      String?
  providerReference    String?
  nextRetryAt          DateTime?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organisation         Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  billingCycle         BillingCycle    @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  invoice              Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: SetNull)

  @@unique([billingCycleId, attemptNumber])
  @@index([organisationId, status])
  @@index([invoiceId])
  @@index([paymentTransactionId])
  @@index([nextRetryAt])
  @@map("payment_attempts")
}

model DunningCase {
  id                   String          @id @default(cuid())
  organisationId       String
  billingCycleId       String          @unique
  invoiceId            String
  memberProfileId      String
  status               String          @default("OPEN") // OPEN, RETRYING, CUSTOMER_ACTION_REQUIRED, PAYMENT_RECOVERED, STAFF_REVIEW, ESCALATED, RESOLVED, CANCELLED, EXPIRED
  totalAttempts        Int             @default(0)
  nextActionAt         DateTime?
  escalatedAt          DateTime?
  resolvedAt           DateTime?
  resolutionType       String?         // PAYMENT_RECOVERED, PAYMENT_METHOD_UPDATED, MANUAL_PAYMENT, INVOICE_VOIDED, INVOICE_ADJUSTED, MEMBERSHIP_CANCELLED, STAFF_RESOLVED, CUSTOMER_DISPUTE, OTHER
  resolutionNotes      String?
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organisation         Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  billingCycle         BillingCycle    @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  invoice              Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  memberProfile        MemberProfile   @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  steps                DunningStep[]
  collectionTasks      CollectionTask[]

  @@index([organisationId, status])
  @@index([memberProfileId])
  @@index([invoiceId])
  @@index([nextActionAt])
  @@map("dunning_cases")
}

model DunningStep {
  id             String       @id @default(cuid())
  dunningCaseId  String
  stepNumber     Int
  actionType     String       // PAYMENT_RETRY, EMAIL_REMINDER, SMS_REMINDER, PUSH_REMINDER, IN_APP_REMINDER, WHATSAPP_REMINDER, STAFF_TASK, ESCALATE
  scheduledAt    DateTime
  executedAt     DateTime?
  status         String       @default("PENDING") // PENDING, EXECUTED, FAILED, SKIPPED
  result         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  dunningCase    DunningCase  @relation(fields: [dunningCaseId], references: [id], onDelete: Cascade)

  @@unique([dunningCaseId, stepNumber])
  @@index([scheduledAt, status])
  @@map("dunning_steps")
}

model BillingPolicy {
  id                       String       @id @default(cuid())
  organisationId           String       @unique
  retryMaxAttempts         Int          @default(4)
  retryIntervalsDays       Int[]        @default([2, 3, 3])
  gracePeriodDays          Int          @default(7)
  gracePeriodAccessAllowed Boolean      @default(true)
  dunningAutoEscalateDays  Int          @default(14)
  dunningMaxPeriodDays     Int          @default(30)
  communicationChannels    String[]     @default(["EMAIL", "IN_APP"])
  metadata                 Json?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organisation             Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@map("billing_policies")
}

model CollectionTask {
  id              String       @id @default(cuid())
  organisationId  String
  outletId        String?
  dunningCaseId   String?
  memberProfileId String
  invoiceId       String
  title           String
  description     String
  priority        String       @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status          String       @default("OPEN") // OPEN, ASSIGNED, IN_PROGRESS, COMPLETED, DISMISSED, EXPIRED
  assignedStaffId String?
  dueDate         DateTime
  completedAt     DateTime?
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organisation    Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)
  dunningCase     DunningCase? @relation(fields: [dunningCaseId], references: [id], onDelete: SetNull)
  memberProfile   MemberProfile @relation(fields: [memberProfileId], references: [id], onDelete: Cascade)
  invoice         Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([outletId])
  @@index([memberProfileId])
  @@index([assignedStaffId])
  @@index([dueDate])
  @@map("collection_tasks")
}

// ==========================================
// DAY 43: ACCOUNTING INTEGRATION & RECONCILIATION
// ==========================================

model AccountingConnection {
  id                       String       @id @default(cuid())
  organisationId           String
  provider                 String       // XERO, QUICKBOOKS, OTHER
  status                   String       @default("PENDING") // PENDING, CONNECTED, AUTHENTICATION_REQUIRED, SYNCING, ERROR, DISCONNECTED, REVOKED
  externalOrganisationId   String?      // Xero Tenant ID or QuickBooks Realm ID
  externalOrganisationName String?
  encryptedAccessToken     String?
  encryptedRefreshToken    String?
  tokenExpiresAt           DateTime?
  scope                    String?
  connectedAt              DateTime?
  disconnectedAt           DateTime?
  lastSuccessfulSyncAt     DateTime?
  lastFailedSyncAt         DateTime?
  syncVersion              Int          @default(1)
  metadata                 Json?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  organisation             Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  mappings                 AccountingMapping[]
  taxMappings              AccountingTaxMapping[]
  externalReferences       AccountingExternalReference[]
  syncJobs                 AccountingSyncJob[]
  conflicts                AccountingConflict[]
  reconciliationReports    AccountingReconciliationReport[]

  @@unique([organisationId, provider])
  @@index([organisationId, status])
  @@map("accounting_connections")
}

model AccountingMapping {
  id                String               @id @default(cuid())
  organisationId    String
  connectionId      String
  mappingType       String               // REVENUE_ACCOUNT, RETAIL_REVENUE_ACCOUNT, MEMBERSHIP_REVENUE_ACCOUNT, PERSONAL_TRAINING_REVENUE_ACCOUNT, CLASS_REVENUE_ACCOUNT, OTHER_REVENUE_ACCOUNT, TAX_RATE, PAYMENT_ACCOUNT, REFUND_ACCOUNT
  fitcoreReference  String               // e.g. MEMBERSHIP_PAYMENT, CLASS, RETAIL, or outletId
  externalReference String               // e.g. Account Code/ID "200"
  externalName      String?
  outletId          String?
  status            String               @default("ACTIVE")
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection        AccountingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  outlet            Outlet?              @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([connectionId, mappingType, fitcoreReference, outletId])
  @@index([organisationId, mappingType])
  @@index([connectionId])
  @@map("accounting_mappings")
}

model AccountingTaxMapping {
  id                   String               @id @default(cuid())
  organisationId       String
  connectionId         String
  fitcoreTaxIdentifier String               // STANDARD_TAX, GST_10, ZERO_TAX, EXEMPT
  externalTaxIdentifier String              // OUTPUT, EXEMPT, TAX001
  externalTaxRate      Float?               // e.g. 10.0 for 10%
  provider             String               // XERO, QUICKBOOKS
  status               String               @default("ACTIVE")
  metadata             Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  organisation         Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection           AccountingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, fitcoreTaxIdentifier])
  @@index([organisationId])
  @@map("accounting_tax_mappings")
}

model AccountingExternalReference {
  id               String               @id @default(cuid())
  organisationId   String
  connectionId     String
  entityType       String               // CONTACT, INVOICE, PAYMENT, REFUND, CREDIT_NOTE, ACCOUNT, TAX_RATE
  fitcoreEntityId  String
  externalEntityId String
  externalVersion  String?
  syncStatus       String               @default("SYNCED") // SYNCED, FAILED, PENDING, STALE
  lastSyncedAt     DateTime             @default(now())
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection       AccountingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, entityType, fitcoreEntityId])
  @@index([organisationId, entityType, externalEntityId])
  @@index([fitcoreEntityId])
  @@map("accounting_external_references")
}

model AccountingSyncJob {
  id                String                 @id @default(cuid())
  organisationId    String
  connectionId      String
  syncType          String                 // INITIAL_SYNC, INVOICE_SYNC, PAYMENT_SYNC, REFUND_SYNC, CONTACT_SYNC, FULL_SYNC, INCREMENTAL_SYNC, RECONCILIATION
  status            String                 @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIAL, FAILED, CANCELLED
  startedAt         DateTime?
  completedAt       DateTime?
  recordsProcessed  Int                    @default(0)
  recordsSucceeded  Int                    @default(0)
  recordsFailed     Int                    @default(0)
  cursor            String?
  errorCount        Int                    @default(0)
  errorMessage      String?
  triggeredBy       String?                // SYSTEM, CRON, STAFF_<userId>
  metadata          Json?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  organisation      Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection        AccountingConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncRecords       AccountingSyncRecord[]

  @@index([organisationId, status])
  @@index([connectionId, syncType])
  @@map("accounting_sync_jobs")
}

model AccountingSyncRecord {
  id               String            @id @default(cuid())
  syncJobId        String
  organisationId   String
  entityType       String            // CONTACT, INVOICE, PAYMENT, REFUND, CREDIT_NOTE
  fitcoreEntityId  String
  externalEntityId String?
  operation        String            // CREATE, UPDATE, SKIP, RETRY, FAILED
  status           String            // PENDING, PROCESSING, SYNCED, FAILED, RETRYING, SKIPPED, CONFLICT
  attemptCount     Int               @default(1)
  errorCategory    String?
  errorMessage     String?
  lastAttemptedAt  DateTime          @default(now())
  completedAt      DateTime?
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  syncJob          AccountingSyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  organisation     Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([syncJobId, status])
  @@index([organisationId, entityType, fitcoreEntityId])
  @@map("accounting_sync_records")
}

model AccountingConflict {
  id                String               @id @default(cuid())
  organisationId    String
  connectionId      String
  entityType        String               // INVOICE, PAYMENT, REFUND, CONTACT
  fitcoreEntityId   String
  externalEntityId  String?
  conflictType      String               // AMOUNT_MISMATCH, STATUS_MISMATCH, EXTERNAL_DELETION, EXTERNAL_MODIFICATION, TAX_MISMATCH, MAPPING_MISMATCH
  fitcoreValue      String?
  externalValue     String?
  status            String               @default("UNRESOLVED") // UNRESOLVED, RESOLVED, IGNORED
  resolutionNotes   String?
  resolvedByUserId  String?
  resolvedAt        DateTime?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  organisation      Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection        AccountingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([connectionId, entityType])
  @@map("accounting_conflicts")
}

model AccountingReconciliationReport {
  id                     String               @id @default(cuid())
  organisationId         String
  connectionId           String
  status                 String               @default("COMPLETED") // COMPLETED, MISMATCH_DETECTED, FAILED
  matchedCount           Int                  @default(0)
  missingExternalCount   Int                  @default(0)
  missingFitcoreCount    Int                  @default(0)
  amountMismatchCount    Int                  @default(0)
  statusMismatchCount    Int                  @default(0)
  currencyMismatchCount  Int                  @default(0)
  details                Json?
  runAt                  DateTime             @default(now())
  triggeredBy            String?

  organisation           Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection             AccountingConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([organisationId, runAt])
  @@index([connectionId])
  @@map("accounting_reconciliation_reports")
}

model FinanceAssistantConversation {
  id             String                    @id @default(cuid())
  organisationId String
  outletId       String?
  userId         String
  title          String                    @default("Financial Query")
  status         String                    @default("ACTIVE") // ACTIVE, ARCHIVED
  metadata       Json?
  lastMessageAt  DateTime                  @default(now())
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  organisation   Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  messages       FinanceAssistantMessage[]
  feedbacks      FinanceAssistantFeedback[]

  @@index([organisationId, userId])
  @@index([organisationId, status])
  @@index([lastMessageAt])
  @@map("finance_assistant_conversations")
}

model FinanceAssistantMessage {
  id                 String                       @id @default(cuid())
  conversationId     String
  role               String                       // USER, ASSISTANT, SYSTEM
  content            String                       @db.Text
  structuredResponse Json?
  sources            Json?
  dataQuality        String?
  tokens             Json?
  createdAt          DateTime                     @default(now())

  conversation       FinanceAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  feedbacks          FinanceAssistantFeedback[]

  @@index([conversationId, createdAt])
  @@map("finance_assistant_messages")
}

model FinanceAssistantFeedback {
  id             String                        @id @default(cuid())
  organisationId String
  userId         String
  conversationId String?
  messageId      String?
  rating         String                        // HELPFUL, NOT_HELPFUL, INACCURATE, MISSING_INFO, WRONG_CALCULATION, WRONG_INTERPRETATION, PERMISSION_CONCERN
  accuracyScore  Int?
  comment        String?                       @db.Text
  modelId        String?
  promptVersion  String?
  createdAt      DateTime                      @default(now())

  organisation   Organisation                  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  conversation   FinanceAssistantConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message        FinanceAssistantMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([conversationId])
  @@map("finance_assistant_feedbacks")
}

// ==========================================
// DAY 45: BUSINESS INTELLIGENCE PROJECTIONS
// ==========================================

model BusinessMetricProjection {
  id              String        @id @default(cuid())
  organisationId  String
  outletId        String?
  metricKey       String
  periodType      String        // DAILY, WEEKLY, MONTHLY
  periodStart     DateTime
  periodEnd       DateTime
  value           Float
  currency        String?
  dataVersion     Int           @default(1)
  sourceVersion   String?
  generatedAt     DateTime      @default(now())

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([organisationId, outletId, metricKey, periodType, periodStart, currency])
  @@index([organisationId, metricKey, periodStart])
  @@index([organisationId, periodType])
  @@index([outletId, metricKey])
  @@map("business_metric_projections")
}

model BusinessMetricSnapshot {
  id              String        @id @default(cuid())
  organisationId  String
  outletId        String?
  snapshotDate    DateTime
  domain          String        // MEMBERSHIP, SALES, FINANCE, ATTENDANCE, BOOKING, TRAINING, NUTRITION, DAILY_CHECKIN, WEARABLES, ENGAGEMENT, RETENTION, COMMUNICATION, OPERATIONS, AI
  metrics         Json
  currency        String?
  generatedAt     DateTime      @default(now())

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([organisationId, outletId, snapshotDate, domain, currency])
  @@index([organisationId, domain, snapshotDate])
  @@map("business_metric_snapshots")
}

model BusinessDashboardPreference {
  id                 String        @id @default(cuid())
  organisationId     String
  userId             String
  defaultOutletId    String?
  defaultDateRange   String        @default("LAST_30_DAYS")
  defaultCurrency    String        @default("AUD")
  pinnedKpiKeys      String[]      @default([])
  enabledDomains     String[]      @default([])
  layoutPreferences  Json?
  chartPreferences   Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organisationId, userId])
  @@index([organisationId, userId])
  @@map("business_dashboard_preferences")
}

// ==========================================
// DAY 48: INTEGRATIONS PLATFORM
// ==========================================

model IntegrationConnection {
  id                         String       @id @default(cuid())
  organisationId             String
  outletId                   String?
  memberId                   String?
  staffId                    String?
  integrationKey             String       // STRIPE, XERO, QUICKBOOKS, TWILIO, SENDGRID, RESEND, WHATSAPP, APPLE_HEALTH, HEALTH_CONNECT, FITBIT, GOOGLE_CALENDAR, MICROSOFT_CALENDAR, ACCESS_CONTROL_PROVIDER
  provider                   String       // STRIPE, XERO, TWILIO, etc.
  category                   String       // PAYMENTS, ACCOUNTING, COMMUNICATION, WEARABLE, CALENDAR, ACCESS_CONTROL, etc.
  scope                      String       @default("ORGANISATION") // ORGANISATION, OUTLET, MEMBER, STAFF
  status                     String       @default("PENDING") // PENDING, CONNECTING, CONNECTED, SYNCING, DEGRADED, AUTHENTICATION_REQUIRED, ERROR, DISCONNECTED, REVOKED, SUSPENDED
  environment                String       @default("DEVELOPMENT") // DEVELOPMENT, STAGING, PRODUCTION
  externalAccountId          String?
  externalAccountName        String?
  encryptedCredentials       String?      // AES-256-GCM encrypted credentials JSON
  configuration              Json?        // Non-sensitive configuration (timezone, sender, syncFrequency, etc.)
  connectedByUserId          String
  connectedAt                DateTime?
  disconnectedAt             DateTime?
  lastSuccessfulOperationAt  DateTime?
  lastFailedOperationAt      DateTime?
  lastHealthCheckAt          DateTime?
  lastSyncAt                 DateTime?
  configurationVersion       Int          @default(1)
  healthStatus               String       @default("HEALTHY") // HEALTHY, DEGRADED, AUTHENTICATION_REQUIRED, RATE_LIMITED, PROVIDER_UNAVAILABLE, CONFIGURATION_ERROR, UNKNOWN
  failureCount               Int          @default(0)
  consecutiveFailures        Int          @default(0)
  metadata                   Json?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  organisation               Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                     Outlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)
  webhookEvents              IntegrationWebhookEvent[]
  syncJobs                   IntegrationSyncJob[]
  auditLogs                  IntegrationAuditLog[]

  @@unique([organisationId, integrationKey, scope, outletId, memberId, staffId])
  @@index([organisationId, status])
  @@index([organisationId, category])
  @@index([integrationKey, status])
  @@index([outletId])
  @@index([memberId])
  @@index([staffId])
  @@map("integration_connections")
}

model IntegrationWebhookEvent {
  id                      String       @id @default(cuid())
  organisationId          String?
  outletId                String?
  connectionId            String?
  provider                String       // STRIPE, XERO, TWILIO, etc.
  externalEventId         String
  eventType               String       // Provider specific event type
  normalizedType          String?      // PAYMENT_SUCCEEDED, INVOICE_PAID, etc.
  status                  String       @default("RECEIVED") // RECEIVED, VERIFIED, QUEUED, PROCESSING, PROCESSED, FAILED, IGNORED, DUPLICATE
  attemptCount            Int          @default(1)
  payloadHash             String
  errorCode               String?
  errorMessage            String?
  rawPayload              Json?
  receivedAt              DateTime     @default(now())
  processedAt             DateTime?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  organisation            Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection              IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([organisationId, status])
  @@index([connectionId])
  @@index([provider, eventType])
  @@index([receivedAt])
  @@map("integration_webhook_events")
}

model IntegrationSyncJob {
  id               String       @id @default(cuid())
  organisationId   String
  connectionId     String
  syncType         String       // INITIAL, INCREMENTAL, FULL, ENTITY, RECONCILIATION
  status           String       @default("PENDING") // PENDING, RUNNING, COMPLETED, PARTIAL, FAILED, CANCELLED
  recordsProcessed Int          @default(0)
  recordsSucceeded Int          @default(0)
  recordsFailed    Int          @default(0)
  cursor           String?
  startedAt        DateTime?
  completedAt      DateTime?
  errorCount       Int          @default(0)
  errorMessage     String?
  triggeredBy      String?      // SYSTEM, CRON, STAFF_<userId>
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organisation     Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  records          IntegrationSyncRecord[]

  @@index([organisationId, status])
  @@index([connectionId, syncType])
  @@index([startedAt])
  @@map("integration_sync_jobs")
}

model IntegrationSyncRecord {
  id               String             @id @default(cuid())
  syncJobId        String
  organisationId   String
  entityType       String             // CONTACT, INVOICE, PAYMENT, EVENT, HEALTH_RECORD, ACCESS_LOG
  fitcoreEntityId  String?
  externalEntityId String?
  operation        String             // CREATE, UPDATE, DELETE, SKIP, RETRY, FAILED
  status           String             // PENDING, PROCESSING, SYNCED, FAILED, RETRYING, SKIPPED, CONFLICT
  attemptCount     Int                @default(1)
  errorCode        String?
  errorMessage     String?
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  createdAt        DateTime           @default(now())

  syncJob          IntegrationSyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)
  organisation     Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([syncJobId, status])
  @@index([organisationId, entityType])
  @@map("integration_sync_records")
}

model IntegrationAuditLog {
  id             String                 @id @default(cuid())
  organisationId String?
  connectionId   String?
  userId         String?
  action         String                 // INTEGRATION_CONNECTED, INTEGRATION_DISCONNECTED, INTEGRATION_REAUTHORIZED, INTEGRATION_HEALTH_CHECKED, etc.
  resource       String                 @default("IntegrationConnection")
  resourceId     String
  status         String                 @default("SUCCESS") // SUCCESS, FAILED
  metadata       Json?
  createdAt      DateTime               @default(now())

  organisation   Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)

  @@index([organisationId, action])
  @@index([connectionId])
  @@index([createdAt])
  @@map("integration_audit_logs")
}

// ============================================================================
// DAY 49: DEVELOPER PLATFORM & PUBLIC API
// ============================================================================

model DeveloperApplication {
  id                   String                 @id @default(cuid())
  organisationId       String?
  createdByUserId      String
  name                 String
  description          String?
  applicationType      String                 @default("ORGANISATION") // INTERNAL, ORGANISATION, PARTNER, THIRD_PARTY, MARKETPLACE
  status               String                 @default("ACTIVE") // DRAFT, ACTIVE, SUSPENDED, REVOKED, ARCHIVED
  environment          String                 @default("SANDBOX") // DEVELOPMENT, SANDBOX, PRODUCTION
  clientId             String                 @unique
  clientSecretHash     String?
  redirectUris         String[]               @default([])
  allowedScopes        String[]               @default([])
  webhookEnabled       Boolean                @default(true)
  rateLimitTier        String                 @default("STANDARD") // STANDARD, PARTNER, ENTERPRISE, INTERNAL, SANDBOX
  metadata             Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  organisation         Organisation?          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdByUser        User                   @relation("DeveloperApplicationsCreated", fields: [createdByUserId], references: [id], onDelete: Cascade)
  apiKeys              DeveloperApiKey[]
  webhookSubscriptions WebhookSubscription[]
  oauthAuthorizations  OAuthAuthorization[]
  oauthTokens          OAuthToken[]
  apiUsages            DeveloperApiUsage[]
  auditLogs            DeveloperAuditLog[]
  marketplaceListings  MarketplaceListing[]

  @@index([organisationId, status])
  @@index([clientId])
  @@map("developer_applications")
}

model DeveloperApiKey {
  id             String               @id @default(cuid())
  applicationId  String
  organisationId String?
  name           String?
  keyPrefix      String
  keyHash        String               @unique
  environment    String               @default("SANDBOX") // DEVELOPMENT, SANDBOX, PRODUCTION
  scopes         String[]             @default([])
  status         String               @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, SUSPENDED
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  rotatedFromId  String?
  metadata       Json?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  application    DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([keyPrefix])
  @@index([keyHash])
  @@map("developer_api_keys")
}

model OAuthAuthorization {
  id                  String               @id @default(cuid())
  code                String               @unique
  applicationId       String
  organisationId      String
  userId              String
  redirectUri         String
  scopes              String[]             @default([])
  codeChallenge       String?
  codeChallengeMethod String?              @default("S256")
  consumed            Boolean              @default(false)
  expiresAt           DateTime
  createdAt           DateTime             @default(now())

  application         DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([code])
  @@index([expiresAt])
  @@map("oauth_authorizations")
}

model OAuthToken {
  id               String               @id @default(cuid())
  applicationId    String
  organisationId   String
  userId           String
  accessTokenHash  String               @unique
  refreshTokenHash String?              @unique
  tokenType        String               @default("Bearer")
  scopes           String[]             @default([])
  environment      String               @default("SANDBOX")
  status           String               @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  expiresAt        DateTime
  refreshExpiresAt DateTime?
  lastUsedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  application      DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organisation     Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([applicationId, status])
  @@index([accessTokenHash])
  @@index([refreshTokenHash])
  @@map("oauth_tokens")
}

model WebhookSubscription {
  id                  String               @id @default(cuid())
  applicationId       String
  organisationId      String
  endpointUrl         String
  description         String?
  eventTypes          String[]             @default([])
  status              String               @default("ACTIVE") // ACTIVE, PAUSED, FAILING, DISABLED, REVOKED
  secretReference     String               // AES-256-GCM encrypted webhook signing secret
  failureCount        Int                  @default(0)
  consecutiveFailures Int                  @default(0)
  lastDeliveryAt      DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  application         DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  organisation        Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  deliveries          WebhookDelivery[]

  @@index([applicationId, status])
  @@index([organisationId])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String              @id @default(cuid())
  subscriptionId String
  organisationId String
  eventId        String
  eventType      String
  attemptNumber  Int                 @default(1)
  status         String              @default("PENDING") // PENDING, DELIVERING, DELIVERED, FAILED, RETRYING, EXPIRED
  httpStatus     Int?
  responseTimeMs Int?
  deliveredAt    DateTime?
  nextRetryAt    DateTime?
  errorCode      String?
  errorMessage   String?
  requestHeaders Json?
  payload        Json
  createdAt      DateTime            @default(now())

  subscription   WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organisation   Organisation        @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@index([organisationId, eventType])
  @@index([eventId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

model DeveloperApiUsage {
  id             String               @id @default(cuid())
  applicationId  String
  organisationId String?
  apiKeyId       String?
  environment    String               @default("SANDBOX")
  endpoint       String
  method         String
  statusCode     Int
  latencyMs      Int
  scope          String?
  requestId      String
  ipAddress      String?
  userAgent      String?
  timestamp      DateTime             @default(now())

  application    DeveloperApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, timestamp])
  @@index([organisationId, timestamp])
  @@index([endpoint])
  @@index([requestId])
  @@map("developer_api_usages")
}

model DeveloperAuditLog {
  id             String                @id @default(cuid())
  organisationId String?
  applicationId  String?
  userId         String?
  action         String
  resource       String                @default("DeveloperApplication")
  resourceId     String
  status         String                @default("SUCCESS") // SUCCESS, FAILED
  metadata       Json?
  createdAt      DateTime              @default(now())

  application    DeveloperApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([organisationId, action])
  @@index([applicationId])
  @@index([createdAt])
  @@map("developer_audit_logs")
}

// ==========================================
// DAY 50: MARKETPLACE FOUNDATION
// ==========================================

model MarketplaceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listings    MarketplaceListing[]

  @@index([slug])
  @@index([sortOrder])
  @@map("marketplace_categories")
}

model MarketplaceListing {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  tagline               String
  description           String   @db.Text
  listingType           String   // APP, INTEGRATION, AI_AGENT, TRAINER, PROGRAM, SERVICE
  publisherType         String   // FIRST_PARTY, VERIFIED_PARTNER, COMMUNITY, TRAINER
  status                String   @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, PUBLISHED, SUSPENDED, DEPRECATED, ARCHIVED
  visibility            String   @default("PUBLIC") // PUBLIC, PRIVATE, UNLISTED, RESTRICTED
  categoryId            String
  publisherOrgId        String?
  publisherName         String
  publisherEmail        String
  publisherWebsite      String?
  supportUrl            String?
  privacyPolicyUrl      String?
  termsUrl              String?
  documentationUrl      String?
  iconUrl               String?
  bannerUrl             String?
  screenshots           String[] @default([])
  badges                String[] @default([])
  featured              Boolean  @default(false)
  verified              Boolean  @default(false)
  currentVersion        String   @default("1.0.0")
  pricingType           String   @default("FREE") // FREE, PAID, SUBSCRIPTION, USAGE_BASED, CONTACT_SALES
  pricingModel          Json?
  requiredPermissions   String[] @default([])
  supportedScopes       String[] @default(["ORGANISATION"])
  healthPiiRequested    Boolean  @default(false)
  capabilities          String[] @default([])
  dependencies          Json?
  conflicts             String[] @default([])
  developerAppId        String?
  trainerProfileId      String?
  ratingAverage         Float    @default(0.0)
  reviewCount           Int      @default(0)
  installCount          Int      @default(0)
  viewCount             Int      @default(0)
  metadata              Json?
  rejectionReason       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  publishedAt           DateTime?

  category              MarketplaceCategory         @relation(fields: [categoryId], references: [id])
  publisherOrg          Organisation?               @relation(fields: [publisherOrgId], references: [id], onDelete: SetNull)
  developerApp          DeveloperApplication?       @relation(fields: [developerAppId], references: [id], onDelete: SetNull)
  trainerProfile        TrainerProfile?             @relation(fields: [trainerProfileId], references: [id], onDelete: SetNull)
  versions              MarketplaceListingVersion[]
  installations         MarketplaceInstallation[]
  reviews               MarketplaceReview[]

  @@index([slug])
  @@index([listingType])
  @@index([status])
  @@index([visibility])
  @@index([categoryId])
  @@index([publisherOrgId])
  @@index([featured])
  @@index([ratingAverage])
  @@map("marketplace_listings")
}

model MarketplaceListingVersion {
  id                    String   @id @default(cuid())
  listingId             String
  version               String
  changelog             String?  @db.Text
  status                String   @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, PUBLISHED, DEPRECATED, ARCHIVED
  manifest              Json
  requiredPermissions   String[] @default([])
  minCoreVersion        String?
  supportedScopes       String[] @default(["ORGANISATION"])
  dependencies          Json?
  healthPiiRequested    Boolean  @default(false)
  releasedAt            DateTime?
  deprecatedAt          DateTime?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  listing               MarketplaceListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  installations         MarketplaceInstallation[]

  @@unique([listingId, version])
  @@index([listingId])
  @@index([version])
  @@index([status])
  @@map("marketplace_listing_versions")
}

model MarketplaceInstallation {
  id                    String   @id @default(cuid())
  organisationId        String
  outletId              String?
  listingId             String
  versionId             String
  installedByUserId     String
  status                String   @default("ACTIVE") // PENDING, ACTIVE, PAUSED, ERROR, UPGRADING, UNINSTALLED
  installationScope     String   @default("ORGANISATION") // ORGANISATION, OUTLET
  config                Json?
  healthStatus          String   @default("HEALTHY") // HEALTHY, DEGRADED, FAILING, UNKNOWN
  healthDetails         Json?
  lastHealthCheckAt     DateTime?
  installedAt           DateTime @default(now())
  updatedAt             DateTime @updatedAt
  uninstalledAt         DateTime?
  pausedAt              DateTime?
  metadata              Json?

  organisation          Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?                   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  listing               MarketplaceListing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  version               MarketplaceListingVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  installedByUser       User                      @relation("MarketplaceInstalledByUser", fields: [installedByUserId], references: [id], onDelete: Cascade)
  permissionGrants      MarketplacePermissionGrant[]

  @@unique([organisationId, listingId, outletId])
  @@index([organisationId])
  @@index([outletId])
  @@index([listingId])
  @@index([status])
  @@index([healthStatus])
  @@map("marketplace_installations")
}

model MarketplacePermissionGrant {
  id                    String   @id @default(cuid())
  installationId        String
  organisationId        String
  permission            String
  status                String   @default("GRANTED") // GRANTED, DENIED, REVOKED
  isHealthPii           Boolean  @default(false)
  grantedByUserId       String?
  grantedAt             DateTime @default(now())
  revokedAt             DateTime?
  revocationReason      String?

  installation          MarketplaceInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  organisation          Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([installationId, permission])
  @@index([installationId])
  @@index([organisationId])
  @@index([permission])
  @@index([status])
  @@map("marketplace_permission_grants")
}

model MarketplaceReview {
  id                    String   @id @default(cuid())
  listingId             String
  organisationId        String
  userId                String
  rating                Int
  title                 String?
  comment               String?  @db.Text
  status                String   @default("PUBLISHED") // PUBLISHED, FLAGGED, HIDDEN, REMOVED
  isVerifiedInstallation Boolean @default(true)
  moderationNotes       String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  listing               MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  organisation          Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user                  User               @relation("MarketplaceReviewsAuthored", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listingId, organisationId])
  @@index([listingId])
  @@index([organisationId])
  @@index([userId])
  @@index([status])
  @@map("marketplace_reviews")
}

model MarketplaceAuditLog {
  id                    String   @id @default(cuid())
  organisationId        String?
  listingId             String?
  installationId        String?
  userId                String?
  action                String
  resource              String   @default("Marketplace")
  resourceId            String
  details               Json?
  ipAddress             String?
  userAgent             String?
  createdAt             DateTime @default(now())

  @@index([organisationId])
  @@index([listingId])
  @@index([installationId])
  @@index([action])
  @@index([createdAt])
  @@map("marketplace_audit_logs")
}

// ============================================================================
// DAY 51 — ENTERPRISE ADMINISTRATION
// ============================================================================

model OrganisationBrand {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  code            String
  slug            String
  description     String?
  logoUrl         String?
  website         String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  status          String        @default("ACTIVE") // ACTIVE, INACTIVE, ARCHIVED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlets         Outlet[]
  enterpriseRoleAssignments EnterpriseRoleAssignment[]
  enterprisePolicies        EnterprisePolicy[]
  enterpriseBrandings       EnterpriseBranding[]

  @@unique([organisationId, slug])
  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([status])
  @@map("organisation_brands")
}

model EnterpriseRoleAssignment {
  id              String        @id @default(cuid())
  organisationId  String
  userId          String
  roleId          String
  scopeType       String        // PLATFORM, ORGANISATION, BRAND, REGION, OUTLET
  scopeId         String?       // Brand ID, Region code, Outlet ID, or null for ORGANISATION/PLATFORM
  brandId         String?
  outletId        String?
  status          String        @default("ACTIVE") // ACTIVE, SCHEDULED, EXPIRED, REVOKED
  validFrom       DateTime      @default(now())
  validTo         DateTime?
  assignedById    String?
  reason          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  brand           OrganisationBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  assignedBy      User?         @relation("RoleAssignmentsCreated", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([userId])
  @@index([roleId])
  @@index([scopeType, scopeId])
  @@index([status])
  @@map("enterprise_role_assignments")
}

model EnterprisePolicy {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  code            String
  description     String?
  category        String        // FEATURE, SECURITY, BRANDING, COMMUNICATION, INTEGRATION, AI, MARKETPLACE, DEVELOPER_API, DATA_ACCESS, RETENTION, ACCESS_CONTROL, FINANCE, BILLING, COMPLIANCE, OPERATIONS
  scopeType       String        // ORGANISATION, BRAND, REGION, OUTLET
  scopeId         String?
  brandId         String?
  outletId        String?
  isHardCeiling   Boolean       @default(false)
  priority        Int           @default(0)
  status          String        @default("DRAFT") // DRAFT, ACTIVE, DEPRECATED, ARCHIVED
  configJson      Json          // Actual configuration rules/parameters
  enforcementMode String        @default("ENFORCED") // ENFORCED, ADVISORY, AUDIT_ONLY
  currentVersion  Int           @default(1)
  createdById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand           OrganisationBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  versions        EnterprisePolicyVersion[]

  @@unique([organisationId, code, scopeType, scopeId])
  @@index([organisationId])
  @@index([category])
  @@index([scopeType, scopeId])
  @@index([status])
  @@map("enterprise_policies")
}

model EnterprisePolicyVersion {
  id              String        @id @default(cuid())
  policyId        String
  versionNumber   Int
  configJson      Json
  changeReason    String?
  createdById     String?
  createdAt       DateTime      @default(now())

  policy          EnterprisePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, versionNumber])
  @@index([policyId])
  @@map("enterprise_policy_versions")
}

model EnterpriseConfiguration {
  id              String        @id @default(cuid())
  organisationId  String
  category        String        // SECURITY, COMPLIANCE, BILLING, INTEGRATION, AI, BRANDING
  key             String
  value           Json
  isEncrypted     Boolean       @default(false)
  scopeType       String        @default("ORGANISATION") // ORGANISATION, BRAND, REGION, OUTLET
  scopeId         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, category, key, scopeType, scopeId])
  @@index([organisationId])
  @@index([category])
  @@map("enterprise_configurations")
}

model EnterpriseBranding {
  id              String        @id @default(cuid())
  organisationId  String
  scopeType       String        // ORGANISATION, BRAND, OUTLET
  scopeId         String?
  brandId         String?
  outletId        String?
  brandName       String?
  logoUrl         String?
  logoDarkUrl     String?
  faviconUrl      String?
  primaryColor    String?
  secondaryColor  String?
  accentColor     String?
  backgroundColor String?
  surfaceColor    String?
  fontFamily      String?
  emailHeaderUrl  String?
  customCss       String?       @db.Text
  themeJson       Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  brand           OrganisationBrand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([organisationId, scopeType, scopeId])
  @@index([organisationId])
  @@index([scopeType, scopeId])
  @@map("enterprise_brandings")
}

model CustomDomain {
  id                  String        @id @default(cuid())
  organisationId      String
  domain              String        @unique
  scopeType           String        @default("ORGANISATION") // ORGANISATION, BRAND, OUTLET
  scopeId             String?
  status              String        @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, VERIFIED, ACTIVE, FAILED, SUSPENDED, DELETED
  verificationMethod  String        @default("DNS_TXT") // DNS_TXT, DNS_CNAME, HTTP_TOKEN
  verificationToken   String
  txtRecordName       String
  txtRecordValue      String
  cnameRecordName     String
  cnameRecordValue    String
  sslStatus           String        @default("PENDING") // PENDING, ISSUED, EXPIRED, FAILED
  sslCertificateArn   String?
  sslIssuedAt         DateTime?
  sslExpiresAt        DateTime?
  verifiedAt          DateTime?
  activatedAt         DateTime?
  fallbackUrl         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organisation        Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([domain])
  @@index([status])
  @@map("custom_domains")
}

// ==========================================
// DAY 52: ADVANCED SECURITY FOUNDATION
// ==========================================

model UserMfaMethod {
  id              String    @id @default(cuid())
  userId          String
  type            String    // TOTP, EMAIL_OTP
  status          String    @default("PENDING") // PENDING, ACTIVE, DISABLED, REVOKED
  label           String?
  secretReference String    // Encrypted secret (AES-256-GCM)
  verifiedAt      DateTime?
  lastUsedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("user_mfa_methods")
}

model UserMfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    // bcrypt or sha256 hash
  status    String    @default("UNUSED") // UNUSED, USED, REVOKED
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@map("user_mfa_recovery_codes")
}

model UserDevice {
  id                   String          @id @default(cuid())
  userId               String
  deviceIdentifierHash String
  deviceName           String
  platform             String?
  appVersion           String?
  browser              String?
  ipAddress            String?
  status               String          @default("NEW") // NEW, TRUSTED, BLOCKED, REVOKED
  trustedAt            DateTime?
  lastSeenAt           DateTime        @default(now())
  firstSeenAt          DateTime        @default(now())
  revokedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions             Session[]
  securityEvents       SecurityEvent[]

  @@index([userId])
  @@index([userId, deviceIdentifierHash])
  @@map("user_devices")
}

model SecurityEvent {
  id             String        @id @default(cuid())
  organisationId String?
  userId         String?
  eventType      String
  severity       String        // INFO, LOW, MEDIUM, HIGH, CRITICAL
  source         String        // WEB, MOBILE, API, SYSTEM, ADMIN
  ipAddress      String?
  deviceId       String?
  sessionId      String?
  requestId      String?
  correlationId  String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  session        Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  device         UserDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([userId, createdAt])
  @@index([eventType])
  @@index([severity])
  @@map("security_events")
}

model SecurityAlert {
  id               String        @id @default(cuid())
  organisationId   String
  severity         String        // INFO, LOW, MEDIUM, HIGH, CRITICAL
  type             String
  description      String
  relatedUserId    String?
  relatedSessionId String?
  relatedDeviceId  String?
  status           String        @default("OPEN") // OPEN, ACKNOWLEDGED, INVESTIGATING, RESOLVED, DISMISSED
  assignedTo       String?
  metadata         Json?
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organisation     Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [relatedUserId], references: [id], onDelete: SetNull)
  session          Session?      @relation(fields: [relatedSessionId], references: [id], onDelete: SetNull)

  @@index([organisationId, status])
  @@index([severity])
  @@map("security_alerts")
}

model SecurityIpPolicy {
  id             String           @id @default(cuid())
  organisationId String
  scopeType      String           @default("ORGANISATION") // ORGANISATION, BRAND, OUTLET
  scopeId        String?
  name           String
  type           String           // ALLOWLIST, DENYLIST
  targetSurfaces String[]
  status         String           @default("ACTIVE") // ACTIVE, INACTIVE
  isHardCeiling  Boolean          @default(true)
  priority       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation   Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rules          SecurityIpRule[]

  @@index([organisationId])
  @@index([scopeType, scopeId])
  @@map("security_ip_policies")
}

model SecurityIpRule {
  id          String           @id @default(cuid())
  policyId    String
  ipOrCidr    String
  description String?
  createdAt   DateTime         @default(now())

  policy      SecurityIpPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("security_ip_rules")
}

model SecurityActionChallenge {
  id          String    @id @default(cuid())
  userId      String
  sessionId   String?
  action      String
  tokenHash   String    @unique
  status      String    @default("PENDING") // PENDING, VERIFIED, CONSUMED, EXPIRED
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session     Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@map("security_action_challenges")
}

// ==========================================
// DAY 53: PRIVACY & COMPLIANCE CENTER MODELS
// ==========================================

model PrivacyDataAsset {
  id               String       @id @default(cuid())
  organisationId   String?
  category         String       // IDENTITY, CONTACT, PROFILE, HEALTH, MEDICAL_DOCUMENT, FITNESS, TRAINING, NUTRITION, WEARABLE, ATTENDANCE, BOOKING, MEMBERSHIP, PAYMENT, FINANCIAL, COMMUNICATION, AI_INTERACTION, ENGAGEMENT, RETENTION, SECURITY, DEVICE, AUDIT, DOCUMENT, CONSENT, MARKETING
  domain           String       // auth, members, health, training, nutrition, wearables, payments, ai, communications, security
  entity           String       // MemberProfile, HealthScreening, WearableConnection, etc.
  fieldPath        String?
  classification   String       @default("PERSONAL") // PUBLIC, INTERNAL, PERSONAL, SENSITIVE, HIGHLY_SENSITIVE
  purpose          String       @default("MEMBERSHIP_MANAGEMENT") // ACCOUNT_MANAGEMENT, TRAINING, NUTRITION, WEARABLE_SYNC, etc.
  source           String       @default("USER_INPUT") // USER_INPUT, DEVICE_SYNC, SYSTEM_GENERATED, STAFF_INPUT, THIRD_PARTY
  storageLocation  String       @default("POSTGRES") // POSTGRES, OBJECT_STORAGE, REDIS
  retentionPolicy  String       @default("DURATION_OF_MEMBERSHIP")
  deletionPolicy   String       @default("DELETE") // DELETE, ANONYMIZE, RETAIN, RESTRICT, ARCHIVE, SKIP
  exportable       Boolean      @default(true)
  deletable        Boolean      @default(true)
  requiresConsent  Boolean      @default(false)
  sensitive        Boolean      @default(false)
  description      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organisation     Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([category])
  @@index([classification])
  @@map("privacy_data_assets")
}

model MemberPrivacyPreference {
  id                 String       @id @default(cuid())
  memberId           String       @unique
  organisationId     String
  aiPersonalization  Boolean      @default(true)
  analytics          Boolean      @default(true)
  marketing          Boolean      @default(false)
  wearables          Boolean      @default(true)
  dataSharing        Boolean      @default(false)
  personalization    Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  memberProfile      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, memberId])
  @@map("member_privacy_preferences")
}

model MemberPrivacyRestriction {
  id                 String       @id @default(cuid())
  memberId           String
  organisationId     String
  status             String       @default("NONE") // NONE, RESTRICTED, UNDER_REVIEW
  reason             String?
  restrictedFeatures String[]     @default([])
  imposedBy          String?
  imposedAt          DateTime?
  releasedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  memberProfile      MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  organisation       Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, memberId])
  @@index([status])
  @@map("member_privacy_restrictions")
}

model PrivacyRequest {
  id                 String               @id @default(cuid())
  organisationId     String
  requesterUserId    String
  memberId           String?
  type               String               // ACCESS, EXPORT, CORRECTION, DELETION, RESTRICTION, CONSENT_WITHDRAWAL, OTHER
  status             String               @default("SUBMITTED") // SUBMITTED, RECEIVED, IDENTITY_VERIFICATION_REQUIRED, VERIFICATION_PENDING, APPROVED, PROCESSING, WAITING_FOR_REVIEW, COMPLETED, REJECTED, CANCELLED, EXPIRED, FAILED
  reason             String?
  submittedAt        DateTime             @default(now())
  verifiedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  expiresAt          DateTime?
  assignedTo         String?
  resolution         String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  organisation       Organisation         @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  requesterUser      User                 @relation("PrivacyRequestsCreated", fields: [requesterUserId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile?       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  exportJobs         PrivacyExportJob[]
  deletionPlans      PrivacyDeletionPlan[]

  @@index([organisationId, status])
  @@index([organisationId, memberId])
  @@index([requesterUserId])
  @@index([type])
  @@index([createdAt])
  @@map("privacy_requests")
}

model PrivacyExportJob {
  id                    String                  @id @default(cuid())
  privacyRequestId      String?
  organisationId        String
  memberId              String
  status                String                  @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, EXPIRED
  formats               String[]                @default(["JSON"])
  downloadTokenHash     String?
  downloadExpiresAt     DateTime?
  downloadCount         Int                     @default(0)
  maxDownloads          Int                     @default(3)
  encryptionAlgorithm   String                  @default("AES-256-GCM")
  encryptedKeyReference String?
  fileSizeBytes         Int?
  errorReason           String?
  completedAt           DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  privacyRequest        PrivacyRequest?         @relation(fields: [privacyRequestId], references: [id], onDelete: SetNull)
  organisation          Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile         MemberProfile           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  artifacts             PrivacyExportArtifact[]

  @@index([organisationId, status])
  @@index([memberId])
  @@index([downloadTokenHash])
  @@map("privacy_export_jobs")
}

model PrivacyExportArtifact {
  id             String           @id @default(cuid())
  exportJobId    String
  format         String           // JSON, CSV, PDF_SUMMARY
  storagePath    String
  mimeType       String
  checksumSha256 String
  fileSizeBytes  Int
  createdAt      DateTime         @default(now())

  exportJob      PrivacyExportJob @relation(fields: [exportJobId], references: [id], onDelete: Cascade)

  @@index([exportJobId])
  @@map("privacy_export_artifacts")
}

model PrivacyDeletionPlan {
  id               String                @id @default(cuid())
  privacyRequestId String?
  organisationId   String
  memberId         String
  status           String                @default("DRAFT") // DRAFT, REVIEW_REQUIRED, APPROVED, EXECUTING, COMPLETED, FAILED, CANCELLED
  requiresReview   Boolean               @default(false)
  reviewReason     String?
  reviewedBy       String?
  reviewedAt       DateTime?
  executedAt       DateTime?
  completedAt      DateTime?
  errorReason      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  privacyRequest   PrivacyRequest?       @relation(fields: [privacyRequestId], references: [id], onDelete: SetNull)
  organisation     Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile    MemberProfile         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items            PrivacyDeletionItem[]

  @@index([organisationId, status])
  @@index([memberId])
  @@map("privacy_deletion_plans")
}

model PrivacyDeletionItem {
  id              String              @id @default(cuid())
  deletionPlanId  String
  domain          String              // PROFILE, HEALTH, WEARABLES, TRAINING, NUTRITION, PAYMENTS, COMMUNICATION, AI, DOCUMENTS, AUDIT, ENGAGEMENT
  entity          String
  action          String              // DELETE, ANONYMIZE, RETAIN, RESTRICT, ARCHIVE, SKIP
  status          String              @default("PENDING") // PENDING, DELETED, ANONYMIZED, RETAINED, RESTRICTED, SKIPPED, FAILED, REQUIRES_REVIEW
  retentionReason String?             // LEGAL_ACCOUNTING_REQUIREMENT, ACTIVE_RETENTION_HOLD, AUDIT_TELEMETRY_POLICY
  recordsAffected Int                 @default(0)
  executedAt      DateTime?
  errorMessage    String?

  deletionPlan    PrivacyDeletionPlan @relation(fields: [deletionPlanId], references: [id], onDelete: Cascade)

  @@index([deletionPlanId])
  @@index([domain, status])
  @@map("privacy_deletion_items")
}

model PrivacyRetentionPolicy {
  id                  String                      @id @default(cuid())
  organisationId      String?
  dataCategory        String                      // IDENTITY, HEALTH, FINANCIAL, AUDIT, etc.
  name                String
  retentionPeriodDays Int
  action              String                      @default("DELETE") // DELETE, ANONYMIZE, ARCHIVE, RESTRICT, REVIEW
  legalHold           Boolean                     @default(false)
  enabled             Boolean                     @default(true)
  effectiveAt         DateTime                    @default(now())
  description         String?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  organisation        Organisation?               @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  executions          PrivacyRetentionExecution[]

  @@index([organisationId, enabled])
  @@index([dataCategory])
  @@map("privacy_retention_policies")
}

model PrivacyRetentionExecution {
  id              String                 @id @default(cuid())
  policyId        String
  status          String                 @default("RUNNING") // RUNNING, COMPLETED, PARTIAL_FAILURE, FAILED
  itemsEvaluated  Int                    @default(0)
  itemsActioned   Int                    @default(0)
  itemsRetained   Int                    @default(0)
  itemsFailed     Int                    @default(0)
  startedAt       DateTime               @default(now())
  completedAt     DateTime?
  errorSummary    String?

  policy          PrivacyRetentionPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@index([status])
  @@map("privacy_retention_executions")
}

model PrivacyRetentionHold {
  id             String        @id @default(cuid())
  organisationId String
  memberId       String?
  dataCategory   String        @default("ALL")
  reason         String
  status         String        @default("ACTIVE") // ACTIVE, RELEASED, EXPIRED
  createdBy      String
  releasedBy     String?
  releasedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile  MemberProfile? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
  @@index([memberId])
  @@map("privacy_retention_holds")
}

model PrivacyProcessor {
  id                     String       @id @default(cuid())
  organisationId         String?
  name                   String
  category               String       // AI_PROVIDER, PAYMENT_PROVIDER, COMMUNICATION_PROVIDER, WEARABLE_PROVIDER, ACCOUNTING_PROVIDER, CLOUD_STORAGE
  purpose                String
  dataCategories         String[]     @default([])
  status                 String       @default("ACTIVE")
  privacyPolicyReference String?
  dataRegion             String?
  enabled                Boolean      @default(true)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organisation           Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, enabled])
  @@index([category])
  @@map("privacy_processors")
}

model PrivacyRequestPolicy {
  id                   String       @id @default(cuid())
  organisationId       String
  requestType          String       // ACCESS, EXPORT, DELETION, etc.
  verificationRequired Boolean      @default(true)
  targetProcessingDays Int          @default(30)
  reviewRequired       Boolean      @default(false)
  enabled              Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organisation         Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, requestType])
  @@index([organisationId])
  @@map("privacy_request_policies")
}

