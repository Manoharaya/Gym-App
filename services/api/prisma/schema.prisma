  @@index([organisationId, active])
  @@map("rewards")
}

model MemberReward {
  id              String        @id @default(cuid())
  organisationId  String
  memberId        String
  rewardId        String
  status          String        @default("AVAILABLE") // AVAILABLE, REDEEMED, EXPIRED, CANCELLED
  earnedAt        DateTime      @default(now())
