  latencyMs       Int?
  status          String        @default("COMPLETED") // SENDING, THINKING, STREAMING, COMPLETED, FAILED, BLOCKED
  createdAt       DateTime      @default(now())

  conversation    AIFitnessCoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_fitness_coach_messages")
}

model AIFitnessConversationSummary {
  id              String        @id @default(cuid())
  conversationId  String
  summary         String        @db.Text
  keyTopics       Json?
  model           String
  promptVersion   Int           @default(1)
  version         Int           @default(1)
  generatedAt     DateTime      @default(now())

  conversation    AIFitnessCoachConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, generatedAt])
  @@map("ai_fitness_conversation_summaries")
}

model AIFitnessSafetyEscalation {
  id              String        @id @default(cuid())
  organisationId  String
  memberId        String
  conversationId  String?
  severity        String        // NONE, CAUTION, RECOMMEND_PROFESSIONAL, URGENT_ESCALATION
  category        String        // INJURY, MEDICAL_SYMPTOM, CHEST_PAIN, EXTREME_EXERCISE, UNSAFE_WEIGHT_LOSS, CONTRAINDICATION
  triggerPhrase   String?
  actionTaken     String
  resolved        Boolean       @default(false)
  createdAt       DateTime      @default(now())

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile   MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)
  conversation    AIFitnessCoachConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organisationId, severity])
  @@index([memberId, createdAt])
  @@map("ai_fitness_safety_escalations")
}

