  sorenessLevel              String?       // NONE, MILD, MODERATE, HIGH, VERY_HIGH
  stressLevel                String?       // VERY_LOW, LOW, MODERATE, HIGH, VERY_HIGH
  motivationLevel            String?       // VERY_LOW, LOW, MODERATE, HIGH, VERY_HIGH
