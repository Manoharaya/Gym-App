model Outlet {
  id              String        @id @default(cuid())
  organisationId  String
  name            String
  slug            String
  code            String
  status          String        @default("ACTIVE") // ACTIVE, MAINTENANCE, COMING_SOON, DELETED
  timezone        String        @default("Australia/Perth")
  address         String
  city            String
  state           String
  country         String        @default("Australia")
  postalCode      String
  latitude        Float?
  longitude       Float?
  phone           String?
  email           String?
  currency        String        @default("AUD")
  website         String?
  brandId         String?
  managerUserId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  // Relations
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  userOutlets     UserOutlet[]
  auditLogs       AuditLog[]
  invitations     Invitation[]
  memberOutlets   MemberOutlet[]
  planOutlets          MembershipPlanOutlet[]
  originMemberships    MemberMembership[]     @relation("OriginOutlet")
  membershipAccesses   MemberMembershipOutlet[]
  accessPoints         AccessPoint[]
  accessDevices        AccessDevice[]
  accessPolicies       AccessPolicy[]
  accessOverrides      AccessOverride[]
  checkIns             CheckIn[]
  accessEvents         AccessEvent[]
  guestAccessPasses    GuestAccessPass[]
  resources            Resource[]
  classSessions        ClassSession[]
  bookings             Booking[]
  waitlistEntries      WaitlistEntry[]
  recurringSchedules   RecurringSchedule[]
  attendanceRecords    AttendanceRecord[]
  staffOutletAssignments StaffOutletAssignment[]
  trainerClientAssignments TrainerClientAssignment[]
  trainingPrograms     TrainingProgram[]
  trainerNotes         TrainerNote[]
  personalTrainingSessions PersonalTrainingSession[]
  workouts             Workout[]
  bodyMeasurements     BodyMeasurement[]
  assessments          Assessment[]
  notifications        Notification[]
  notificationSchedules NotificationSchedule[]
  engagementEvents     EngagementEvent[]
  challenges           Challenge[]
  rewards              Reward[]
  aiFeatureConfigurations AIFeatureConfiguration[]
  aiRequests           AIRequest[]
  aiUsageRecords       AIUsageRecord[]
  aiAuditEvents        AIAuditEvent[]
  retentionFollowUpTasks RetentionFollowUpTask[]
  memberRecoveryPlans    MemberRecoveryPlan[]
  communications         Communication[]
  retentionAgentAnalyses RetentionAgentAnalysis[]
  retentionOutreaches    RetentionOutreach[]
  engagementWorkflows    EngagementWorkflow[]
  workflowInstances      WorkflowInstance[]
  aiReceptionists              AIReceptionist[]
  receptionistKnowledgeSources ReceptionistKnowledgeSource[]
  receptionistConversations    ReceptionistConversation[]
  receptionistHandoffs         ReceptionistHandoff[]
  receptionistKnowledgeGaps    ReceptionistKnowledgeGap[]
  bookingConfirmations         BookingConfirmationState[]
  receptionistBookingInteractions ReceptionistBookingInteraction[]
  leads                        Lead[]
  preferredLeadProfiles        LeadQualificationProfile[]
  voicePhoneNumbers            VoicePhoneNumber[]
  voiceSessions                VoiceSession[]
  receptionistInteractions     ReceptionistInteraction[]
  receptionistFollowUpTasks    ReceptionistFollowUpTask[]
  callbackRequests             CallbackRequest[]
  receptionistWorkflowConfigs  ReceptionistWorkflowConfig[]
  salesAgentProfiles           SalesAgentProfile[]
  salesConversations           SalesConversation[]
  salesRecommendations         SalesRecommendation[]
  salesNextActions             SalesNextAction[]
  salesHandoffs                SalesHandoff[]
  salesPipelines               SalesPipeline[]
  salesOpportunities           SalesOpportunity[]
  salesActivities              SalesActivity[]
  salesTasks                   SalesTask[]
  followUpSequences            FollowUpSequence[]
  followUpEnrollments          FollowUpEnrollment[]
  financialTransactionReferences FinancialTransactionReference[]
  financialDailySummaries      FinancialDailySummary[]
  billingSchedules             BillingSchedule[]
  collectionTasks              CollectionTask[]
  accountingMappings           AccountingMapping[]
  financeAssistantConversations FinanceAssistantConversation[]
  businessMetricProjections     BusinessMetricProjection[]
  businessMetricSnapshots       BusinessMetricSnapshot[]
  integrationConnections        IntegrationConnection[]
  marketplaceInstallations      MarketplaceInstallation[]
  brand                         OrganisationBrand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  managerUser                   User?                      @relation("OutletManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)
  enterpriseRoleAssignments     EnterpriseRoleAssignment[]
  enterprisePolicies            EnterprisePolicy[]
  enterpriseBrandings           EnterpriseBranding[]

  @@unique([organisationId, slug])
  @@unique([organisationId, code])
  @@index([organisationId])
  @@index([status])
  @@index([brandId])
  @@index([managerUserId])
  @@map("outlets")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  phone            String?
  passwordHash     String
  firstName        String
  lastName         String
  displayName      String?
  avatarUrl        String?
  status           String        @default("ACTIVE") // ACTIVE, INVITED, SUSPENDED, DISABLED, DELETED
  emailVerifiedAt  DateTime?
  phoneVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  // Relations
  userRoles        UserRole[]
  userOutlets      UserOutlet[]
  sessions         Session[]
  auditLogs        AuditLog[]
  invitationsSent        Invitation[]     @relation("InvitationsSent")
  memberProfile          MemberProfile?
  accessOverridesCreated AccessOverride[] @relation("AccessOverridesCreated")
  guestPassesCreated     GuestAccessPass[] @relation("GuestPassesCreated")
  trainerSessions           ClassSession[]        @relation("TrainerSessions")
  trainerAvailabilities     TrainerAvailability[]
  trainerRecurringSchedules RecurringSchedule[]   @relation("TrainerRecurringSchedules")
  substituteTrainerSessions ClassSession[]        @relation("SubstituteTrainerSessions")
  attendanceRecordsMarked   AttendanceRecord[]    @relation("AttendanceMarkedByUser")
  staffProfile              StaffProfile?
  staffOutletAssignmentsCreated StaffOutletAssignment[] @relation("StaffOutletAssignmentsCreated")
  trainerClientAssignmentsCreated TrainerClientAssignment[] @relation("TrainerClientAssignmentsCreated")
  certificationsVerified    TrainerCertification[] @relation("CertificationsVerified")
  goalsCreated              TrainingGoal[]         @relation("GoalsCreatedByUser")
  goalHistories             GoalHistory[]          @relation("GoalHistoryActor")
  cancelledPtSessions       PersonalTrainingSession[] @relation("PtSessionsCancelledByUser")
  exercisesCreated          Exercise[]             @relation("ExercisesCreatedByUser")
  setCorrectionsMade        WorkoutSetCorrection[] @relation("SetCorrectionsByUser")
  measurementsRecorded      BodyMeasurement[]      @relation("MeasurementsRecordedByUser")
  nutritionTargetsAssigned  NutritionTarget[]      @relation("NutritionTargetsAssignedByUser")
  foodsCreated              Food[]                 @relation("FoodsCreatedByUser")
  mealPlansCreated          MealPlan[]             @relation("MealPlansCreatedByUser")
  mealPlansAssigned         MemberMealPlanAssignment[] @relation("MealPlansAssignedByUser")
  foodLogsLogged            FoodLog[]              @relation("FoodLogsLoggedByUser")
  notificationsReceived     Notification[]         @relation("UserNotifications")
  notificationPreferences   NotificationPreference[] @relation("UserNotificationPreferences")
  pushDevices               PushDevice[]           @relation("UserPushDevices")
  scheduledNotifications    NotificationSchedule[] @relation("UserScheduledNotifications")
  habitsCreated             MemberHabit[]          @relation("HabitsCreatedByUser")
  aiRequests                AIRequest[]
  aiUsageRecords            AIUsageRecord[]
  aiAuditEvents             AIAuditEvent[]
  aiFeedbacks               AIFeedback[]
  assignedRetentionTasks    RetentionFollowUpTask[] @relation("AssignedRetentionStaff")
  completedRetentionTasks   RetentionFollowUpTask[] @relation("CompletedRetentionStaff")
  assignedRecoveryPlans     MemberRecoveryPlan[]    @relation("AssignedRecoveryStaff")
  approvedRecoveryPlans     MemberRecoveryPlan[]    @relation("ApprovedRecoveryStaff")
  communicationsReceived    Communication[]         @relation("UserCommunications")
  communicationPreferences  CommunicationPreference[] @relation("UserCommPreferences")
  assignedRetentionOutreaches RetentionOutreach[]     @relation("AssignedOutreachStaff")
  approvedRetentionOutreaches RetentionOutreach[]     @relation("ApprovedOutreachStaff")
  businessDashboardPreferences BusinessDashboardPreference[]
  developerApplicationsCreated DeveloperApplication[] @relation("DeveloperApplicationsCreated")
  oauthAuthorizations          OAuthAuthorization[]
  oauthTokens                  OAuthToken[]
  marketplaceInstallations     MarketplaceInstallation[] @relation("MarketplaceInstalledByUser")
  marketplaceReviews           MarketplaceReview[]       @relation("MarketplaceReviewsAuthored")
  managedOutlets               Outlet[]                  @relation("OutletManagerUser")
  enterpriseRoleAssignments    EnterpriseRoleAssignment[]
  enterpriseRoleAssignmentsCreated EnterpriseRoleAssignment[] @relation("RoleAssignmentsCreated")
  mfaMethods                   UserMfaMethod[]
  mfaRecoveryCodes             UserMfaRecoveryCode[]
  devices                      UserDevice[]
  securityEvents               SecurityEvent[]
  securityAlerts               SecurityAlert[]
  actionChallenges             SecurityActionChallenge[]
  privacyRequests              PrivacyRequest[]        @relation("PrivacyRequestsCreated")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("users")
}

model Role {
  id            String           @id @default(cuid())
  name          String           @unique // SUPERADMIN, ORGANISATION_OWNER, OUTLET_MANAGER, RECEPTION, TRAINER, FINANCE, MEMBER
  description   String?
  isSystemRole  Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Relations
  permissions   RolePermission[]
  userRoles     UserRole[]
  invitations   Invitation[]
  enterpriseRoleAssignments EnterpriseRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  resource    String           // members, outlets, organisations, staff, appointments, etc.
  action      String           // CREATE, READ, UPDATE, DELETE, MANAGE, ASSIGN, REVOKE
  scope       String           // PLATFORM, ORGANISATION, OUTLET, ASSIGNED_CLIENTS, SELF
  description String?
  createdAt   DateTime         @default(now())

  // Relations
  roles       RolePermission[]

  @@unique([resource, action, scope])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id              String        @id @default(cuid())
  userId          String
  roleId          String
  organisationId  String
  outletId        String?
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organisationId])
  @@index([outletId])
  @@map("user_roles")
}

model UserOutlet {
  id        String   @id @default(cuid())
  userId    String
  outletId  String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([userId])
  @@index([outletId])
  @@map("user_outlets")
}

model Session {
  id                    String         @id @default(cuid())
  userId                String
  organisationId        String?
  sessionTokenReference String?
  tokenFamily           String
  isValid               Boolean        @default(true)
  status                String         @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED, COMPROMISED
  userAgent             String?
  ipAddress             String?
  deviceId              String?
  authMethod            String         @default("PASSWORD") // PASSWORD, MFA, OAUTH, API_KEY
  mfaVerified           Boolean        @default(false)
  lastStepUpAt          DateTime?
  expiresAt             DateTime
  lastUsedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation          Organisation?  @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  device                UserDevice?    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens         RefreshToken[]
  securityEvents        SecurityEvent[]
  securityAlerts        SecurityAlert[]
  actionChallenges      SecurityActionChallenge[]

  @@index([userId])
  @@index([tokenFamily])
  @@index([organisationId])
  @@index([deviceId])
  @@index([status])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  sessionId String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Invitation {
  id              String        @id @default(cuid())
  email           String
  organisationId  String
  outletId        String?
  roleId          String
  tokenHash       String        @unique
  status          String        @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt       DateTime
  acceptedAt      DateTime?
  invitedById     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)
  role            Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  invitedBy       User?         @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tokenHash])
  @@index([email])
  @@index([organisationId])
  @@index([status])
  @@map("invitations")
}

model AuditLog {
  id              String        @id @default(cuid())
  userId          String?
  organisationId  String?
  outletId        String?
  action          String
  resource        String
  resourceId      String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  requestId       String?
  createdAt       DateTime      @default(now())

  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  outlet          Outlet?       @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organisationId])
  @@index([outletId])
  @@index([createdAt])
  @@map("audit_logs")
}

