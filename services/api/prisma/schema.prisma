model Communication {
  id                 String                       @id @default(cuid())
  organisationId     String
  outletId           String?
  recipientUserId    String?
  recipientMemberId  String?
  recipientStaffId   String?

  type               String                       // TRANSACTIONAL, OPERATIONAL, ENGAGEMENT, REACTIVATION, REMINDER, SYSTEM, MARKETING, STAFF, SECURITY
  channel            String                       // EMAIL, SMS, PUSH, WHATSAPP, IN_APP, VOICE

  templateId         String?
  templateVersionId  String?

  subject            String?
  contentPreview     String?
  body               String?                      @db.Text
  variables          Json?

  status             String                       @default("QUEUED") // DRAFT, PENDING_APPROVAL, APPROVED, QUEUED, SENDING, SENT, DELIVERED, READ, FAILED, CANCELLED, EXPIRED, SUPPRESSED

  scheduledAt        DateTime?
  queuedAt           DateTime                     @default(now())
  sentAt             DateTime?
  deliveredAt        DateTime?
  failedAt           DateTime?
  readAt             DateTime?

  provider           String                       // DEVELOPMENT, CONSOLE, SENDGRID, TWILIO, WHATSAPP, FCM, APNS, etc.
  providerMessageId  String?
  attemptCount       Int                          @default(0)
  maxAttempts        Int                          @default(3)

  source             String                       // BOOKING, PAYMENT, MEMBERSHIP, REACTIVATION, DAILY_CHECKIN, SYSTEM, STAFF, MARKETING, AI_AGENT
  sourceReferenceId  String?
  idempotencyKey     String?                      @unique

  cost               Decimal?                     @db.Decimal(10, 4)
  currency           String                       @default("USD")
  suppressionReason  String?
  metadata           Json?

  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  organisation       Organisation                 @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet?                      @relation(fields: [outletId], references: [id], onDelete: SetNull)
  recipientUser      User?                        @relation("UserCommunications", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientMember    MemberProfile?               @relation("MemberCommunications", fields: [recipientMemberId], references: [id], onDelete: SetNull)
  template           CommunicationTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion    CommunicationTemplateVersion? @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  deliveryEvents     CommunicationDeliveryEvent[]
  retentionOutreaches RetentionOutreach[]

  @@index([organisationId, createdAt])
  @@index([recipientUserId])
  @@index([recipientMemberId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@index([scheduledAt])
  @@index([providerMessageId])
  @@index([source, sourceReferenceId])
  @@map("communications")
}

model CommunicationTemplate {
  id             String                         @id @default(cuid())
  organisationId String?                        // null = SYSTEM template
  name           String
  type           String                         // TRANSACTIONAL, OPERATIONAL, ENGAGEMENT, REACTIVATION, etc.
  channel        String                         // EMAIL, SMS, PUSH, WHATSAPP, IN_APP, VOICE
  status         String                         @default("ACTIVE") // ACTIVE, ARCHIVED, DRAFT
  description    String?
  isSystem       Boolean                        @default(false)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

