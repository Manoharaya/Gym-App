// ==========================================
// DAY 30: AUTOMATED ENGAGEMENT WORKFLOWS
// ==========================================

model EngagementWorkflow {
  id             String                      @id @default(cuid())
  organisationId String
  outletId       String?
  name           String
  description    String?
  status         String                      @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  category       String                      @default("ENGAGEMENT") // ONBOARDING, ENGAGEMENT, RETENTION, REACTIVATION, MILESTONE, MEMBERSHIP, ATTENDANCE, TRAINING, COMMUNICATION, SYSTEM
  triggerType    String                      // e.g. MEMBER_INACTIVE, CLASS_NO_SHOW, etc.
  version        Int                         @default(1)
  enabled        Boolean                     @default(false)
  approvalMode   String                      @default("CONFIGURABLE") // ALWAYS_REQUIRED, CONFIGURABLE, NOT_REQUIRED
  timezone       String                      @default("UTC")
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organisation   Organisation                @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet         Outlet?                     @relation(fields: [outletId], references: [id], onDelete: SetNull)
  versions       EngagementWorkflowVersion[]
  instances      WorkflowInstance[]
  executions     WorkflowExecution[]

  @@index([organisationId, status])
  @@index([organisationId, triggerType])
  @@index([organisationId, category])
  @@map("engagement_workflows")
}

model EngagementWorkflowVersion {
  id                  String             @id @default(cuid())
  workflowId          String
  version             Int
  triggerDefinition   Json               // Trigger criteria, filters
  conditionDefinition Json               // Declarative conditions (leaf & compound AND/OR/NOT)
  actionDefinition    Json               // Ordered step actions, params, templates
  settings            Json?              // Cooldown, frequency limits, quiet hours, stop conditions, branching
  createdBy           String?
  createdAt           DateTime           @default(now())
  publishedAt         DateTime?
  archivedAt          DateTime?

  workflow            EngagementWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  instances           WorkflowInstance[]

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("engagement_workflow_versions")
}

model WorkflowInstance {
  id                 String                    @id @default(cuid())
  organisationId     String
  outletId           String?
  workflowId         String
  workflowVersionId  String
  memberId           String
  status             String                    @default("PENDING") // PENDING, RUNNING, WAITING, AWAITING_APPROVAL, SCHEDULED, COMPLETED, CANCELLED, FAILED, EXPIRED, SUPPRESSED
  currentStep        Int                       @default(0)
  triggerEventId     String?
  triggerData        Json?
  contextData        Json?
  actionPayload      Json?
  startedAt          DateTime                  @default(now())
  scheduledAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  expiresAt          DateTime?
  lastEvaluatedAt    DateTime?
  failureReason      String?                   @db.Text
  outcome            String?                   // COMPLETED, MEMBER_REENGAGED, MEMBER_RESPONDED, BOOKING_CREATED, ATTENDANCE_RECORDED, WORKOUT_COMPLETED, MEMBERSHIP_RENEWED, TASK_COMPLETED, NO_RESPONSE, SUPPRESSED, CANCELLED, EXPIRED, FAILED
  outcomeRecordedAt  DateTime?
  outcomeDetails     Json?
  idempotencyKey     String?                   @unique

  organisation       Organisation              @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet             Outlet?                   @relation(fields: [outletId], references: [id], onDelete: SetNull)
  workflow           EngagementWorkflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion    EngagementWorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  memberProfile      MemberProfile             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  executions         WorkflowExecution[]

  @@index([organisationId, status])
  @@index([organisationId, workflowId, status])
  @@index([organisationId, memberId, workflowId])
  @@index([organisationId, scheduledAt])
  @@index([memberId, status])
  @@map("workflow_instances")
}

model WorkflowExecution {
  id                 String             @id @default(cuid())
  workflowInstanceId String
  workflowId         String
  stepId             String
  stepType           String             // TRIGGER, CONDITION, ACTION, DELAY, APPROVAL, AI_ASSISTANT
  status             String             @default("PENDING") // PENDING, RUNNING, COMPLETED, SKIPPED, FAILED, SUPPRESSED, AWAITING_APPROVAL
  inputReference     Json?
  outputReference    Json?
  startedAt          DateTime           @default(now())
  completedAt        DateTime?
  failureReason      String?            @db.Text
  retryCount         Int                @default(0)

  workflowInstance   WorkflowInstance   @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflow           EngagementWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowInstanceId])
  @@index([workflowId, status])
  @@map("workflow_executions")
}

