  @@index([organisationId])
  @@index([memberProfileId])
  @@index([status])
  @@index([effectiveFrom])
  @@map("nutrition_targets")
}

model Food {
  id                 String             @id @default(cuid())
  organisationId     String?            // NULL for SYSTEM foods
  ownership          String             @default("ORGANISATION") // SYSTEM, ORGANISATION
  name               String
  brand              String?
  category           String             @default("PROTEIN") // PROTEIN, GRAINS, VEGETABLES, FRUITS, DAIRY, FATS_OILS, SNACKS, BEVERAGES, SUPPLEMENTS, OTHER
  servingSize        Float
  servingUnit        String             // g, ml, oz, piece, cup, tbsp, tsp, scoop
  calories           Float
  protein            Float
  carbohydrates      Float
  fat                Float
  fiber              Float              @default(0)
  sugar              Float              @default(0)
  sodium             Float              @default(0) // mg
  calcium            Float?             // mg
  iron               Float?             // mg
  potassium          Float?             // mg
  vitaminD           Float?             // mcg
  vitaminB12         Float?             // mcg
  micronutrients     Json?
  barcode            String?
  verified           Boolean            @default(false)
  status             String             @default("ACTIVE")
  createdById        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organisation       Organisation?      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy          User?              @relation("FoodsCreatedByUser", fields: [createdById], references: [id], onDelete: SetNull)
  mealFoodItems      MealFoodItem[]
  mealPlanFoodItems  MealPlanFoodItem[]
  foodLogs           FoodLog[]

  @@index([organisationId])
  @@index([ownership])
  @@index([name])
  @@index([category])
  @@index([barcode])
  @@map("foods")
}

model Meal {
  id                 String             @id @default(cuid())
