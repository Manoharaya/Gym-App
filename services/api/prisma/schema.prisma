  feedbackCategory  String?       // NOT_RELEVANT, INCORRECT, TOO_GENERIC, CONFUSING, OTHER
  createdAt         DateTime      @default(now())
  expiresAt         DateTime?

  organisation      Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  memberProfile     MemberProfile @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([organisationId, memberId, createdAt])
  @@index([memberId, insightType, createdAt])
  @@index([idempotencyKey])
  @@map("wearable_insights")
}

