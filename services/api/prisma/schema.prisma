  status                String                  @default("PENDING_APPROVAL") // DRAFT, PENDING_APPROVAL, APPROVED, SCHEDULED, SENT, DELIVERED, ENGAGED, REENGAGED, NO_RESPONSE, DECLINED, CANCELLED, EXPIRED, FAILED
  approvalStatus        String                  @default("PENDING") // NOT_REQUIRED, PENDING, APPROVED, REJECTED
  recommendedChannel    String                  @default("WHATSAPP") // EMAIL, SMS, PUSH, WHATSAPP, IN_APP
  selectedChannel       String                  @default("WHATSAPP") // EMAIL, SMS, PUSH, WHATSAPP, IN_APP
  messageDraft          String                  @db.Text
  finalMessage          String?                 @db.Text
  staffNotes            String?                 @db.Text
  rejectionReason       String?                 @db.Text
  scheduledAt           DateTime?
  sentAt                DateTime?
  deliveredAt           DateTime?
  respondedAt           DateTime?
  outcome               String?                 // REENGAGED, BOOKING_CREATED, CLASS_ATTENDED, WORKOUT_COMPLETED, PT_SESSION_BOOKED, MEMBER_RESPONDED, MEMBER_DECLINED, NO_RESPONSE, MEMBERSHIP_RENEWED, MEMBERSHIP_CANCELLED, STAFF_FOLLOW_UP_REQUIRED, UNKNOWN
  outcomeReason         String?                 @db.Text
  outcomeRecordedAt     DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  organisation          Organisation            @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  outlet                Outlet?                 @relation(fields: [outletId], references: [id], onDelete: SetNull)
  memberProfile         MemberProfile           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  retentionAnalysis     RetentionAgentAnalysis? @relation(fields: [retentionAnalysisId], references: [id], onDelete: SetNull)
  communication         Communication?          @relation(fields: [communicationId], references: [id], onDelete: SetNull)
  assignedStaff         User?                   @relation("AssignedOutreachStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
