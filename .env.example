# FitCore Mobile Environment Configuration Template
# DO NOT commit real secrets to this file or the mobile app bundle.
# All backend/AI/payment secrets MUST stay on the server.

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# FitCore Backend API
EXPO_PUBLIC_API_BASE_URL=https://api-dev.fitcore.io/v1

# Monitoring & Crash Reporting
EXPO_PUBLIC_SENTRY_DSN=

# Analytics
EXPO_PUBLIC_ANALYTICS_KEY=

# Push Notifications Project ID (Expo / APNs / FCM)
EXPO_PUBLIC_PUSH_NOTIFICATION_PROJECT_ID=

# Seed Tenant Configuration (Used exclusively for local development / testing)
EXPO_PUBLIC_DEV_SEED_ORGANISATION_ID=org_dev_secondwind_001
EXPO_PUBLIC_DEV_SEED_ORGANISATION_NAME="Second Wind Athletic Club"
EXPO_PUBLIC_DEV_SEED_OUTLET_ID=outlet_dev_perth_cbd_001
EXPO_PUBLIC_DEV_SEED_OUTLET_NAME="Perth CBD"
